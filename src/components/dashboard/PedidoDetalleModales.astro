---

---

<!-- Modal de costo de diseño -->
<div
  id="modal-costo-diseno"
  class="fixed inset-0 z-105 hidden items-center justify-center p-4"
>
  <div
    id="modal-costo-diseno-backdrop"
    class="absolute inset-0 bg-slate-950/40 backdrop-blur-sm"
  >
  </div>

  <div
    class="relative w-full max-w-sm overflow-hidden rounded-2xl bg-white shadow-2xl"
  >
    <div class="p-5">
      <div class="flex items-center justify-between gap-3">
        <div
          class="flex h-10 w-10 items-center justify-center rounded-full bg-cyan-50 text-cyan-700"
        >
          <svg
            class="h-5 w-5"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M12 2v20M17 5H9.5a3.5 3.5 0 000 7h5a3.5 3.5 0 010 7H6"></path>
          </svg>
        </div>
        <p
          id="modal-costo-diseno-actual"
          class="text-xs font-medium text-slate-500"
        >
          Actual: $0.00
        </p>
      </div>

      <h3
        id="modal-costo-diseno-titulo"
        class="mt-4 text-base font-semibold text-slate-900"
      >
        Establecer costo de diseño
      </h3>

      <p class="mt-2 text-sm leading-6 text-slate-500">
        Este importe se añadirá al total cobrado del pedido.
      </p>

      <div class="mt-4">
        <label
          for="modal-costo-diseno-input"
          class="block text-xs font-medium text-slate-600"
          >Costo de diseño</label
        >

        <div class="relative mt-1.5">
          <span
            class="pointer-events-none absolute inset-y-0 left-3 flex items-center text-sm text-slate-400"
            >$</span
          >
          <input
            id="modal-costo-diseno-input"
            type="number"
            min="0"
            step="0.01"
            inputmode="decimal"
            class="h-10 w-full rounded-lg border border-slate-200 bg-white pl-7 pr-3 text-sm font-medium text-slate-800 outline-none transition placeholder:text-slate-300 focus:border-cyan-500 focus:ring-2 focus:ring-cyan-100"
            placeholder="0.00"
          />
        </div>

        <p
          id="modal-costo-diseno-error"
          class="mt-2 hidden text-xs font-medium text-red-600"
        >
        </p>
      </div>
    </div>

    <div
      class="flex items-center justify-end gap-2 border-t border-slate-100 bg-slate-50 px-5 py-3"
    >
      <button
        id="modal-costo-diseno-cancelar"
        type="button"
        class="h-9 rounded-lg border border-slate-200 bg-white px-4 text-xs font-medium text-slate-600 transition hover:bg-slate-100 hover:text-slate-800 focus:outline-none focus:ring-2 focus:ring-slate-300"
        >Cancelar</button
      >
      <button
        id="modal-costo-diseno-guardar"
        type="button"
        class="h-9 rounded-lg bg-cyan-800 px-4 text-xs font-medium text-white transition hover:bg-cyan-900 focus:outline-none focus:ring-2 focus:ring-cyan-300 disabled:cursor-not-allowed disabled:opacity-50"
        >Guardar costo</button
      >
    </div>
  </div>
</div>

<div
  id="modal-eliminar-pedido"
  class="fixed inset-0 z-140 hidden items-center justify-center p-4"
  role="dialog"
  aria-modal="true"
  aria-labelledby="modal-eliminar-pedido-titulo"
>
  <div
    id="modal-eliminar-pedido-backdrop"
    class="absolute inset-0 bg-slate-950/50 backdrop-blur-sm"
  >
  </div>
  <div
    class="relative w-full max-w-sm rounded-xl border border-slate-200 bg-white p-5 shadow-2xl"
  >
    <h3
      id="modal-eliminar-pedido-titulo"
      class="text-base font-bold text-slate-900"
    >
      Eliminar pedido
    </h3>
    <p
      id="modal-eliminar-pedido-texto"
      class="mt-2 text-sm leading-6 text-slate-600"
    >
      Esta acción no se puede deshacer.
    </p>
    <div class="mt-5 flex justify-end gap-2">
      <button
        id="modal-eliminar-pedido-cancelar"
        type="button"
        class="h-9 rounded-lg border border-slate-200 bg-white px-4 text-xs font-medium text-slate-700 transition hover:bg-slate-100"
        >Conservar</button
      >
      <button
        id="modal-eliminar-pedido-confirmar"
        type="button"
        class="h-9 rounded-lg bg-red-700 px-4 text-xs font-semibold text-white transition hover:bg-red-800 disabled:cursor-not-allowed disabled:opacity-50"
        >Eliminar</button
      >
    </div>
  </div>
</div>

<!-- Modal de precio especial -->
<div
  id="modal-precio-especial"
  class="fixed inset-0 z-100 hidden items-center justify-center p-4"
>
  <div
    id="modal-precio-especial-backdrop"
    class="absolute inset-0 bg-slate-950/40 backdrop-blur-sm"
  >
  </div>

  <div
    class="relative w-full max-w-sm overflow-hidden rounded-2xl bg-white shadow-2xl"
  >
    <div class="p-5">
      <div class="flex items-center justify-between gap-3">
        <div
          class="flex h-10 w-10 items-center justify-center rounded-full bg-violet-50 text-violet-600"
        >
          <svg
            class="h-5 w-5"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M12 2v20M17 5H9.5a3.5 3.5 0 000 7h5a3.5 3.5 0 010 7H6"></path>
          </svg>
        </div>
        <p
          id="modal-precio-especial-actual"
          class="text-xs font-medium text-slate-500"
        >
          Actual: Sin establecer
        </p>
      </div>

      <h3
        id="modal-precio-especial-titulo"
        class="mt-4 text-base font-semibold text-slate-900"
      >
        Establecer precio especial
      </h3>

      <p class="mt-2 text-sm leading-6 text-slate-500">
        El precio especial reemplazará el precio calculado como precio final del
        pedido.
      </p>

      <div class="mt-4">
        <label
          for="modal-precio-especial-input"
          class="block text-xs font-medium text-slate-600"
        >
          Precio especial
        </label>

        <div class="relative mt-1.5">
          <span
            class="pointer-events-none absolute inset-y-0 left-3 flex items-center text-sm text-slate-400"
          >
            $
          </span>

          <input
            id="modal-precio-especial-input"
            type="number"
            min="0.01"
            step="0.01"
            inputmode="decimal"
            class="h-10 w-full rounded-lg border border-slate-200 bg-white pl-7 pr-3 text-sm font-medium text-slate-800 outline-none transition placeholder:text-slate-300 focus:border-violet-400 focus:ring-2 focus:ring-violet-100"
            placeholder="0.00"
          />
        </div>

        <p
          id="modal-precio-especial-error"
          class="mt-2 hidden text-xs font-medium text-red-600"
        >
        </p>
      </div>
    </div>

    <div
      class="flex items-center justify-end gap-2 border-t border-slate-100 bg-slate-50 px-5 py-3"
    >
      <button
        id="modal-precio-especial-cancelar"
        type="button"
        class="h-9 rounded-lg border border-slate-200 bg-white px-4 text-xs font-medium text-slate-600 transition hover:bg-slate-100 hover:text-slate-800 focus:outline-none focus:ring-2 focus:ring-slate-300"
      >
        Cancelar
      </button>

      <button
        id="modal-precio-especial-guardar"
        type="button"
        class="h-9 rounded-lg bg-violet-600 px-4 text-xs font-medium text-white transition hover:bg-violet-700 focus:outline-none focus:ring-2 focus:ring-violet-300 disabled:cursor-not-allowed disabled:opacity-50"
      >
        Guardar precio
      </button>
    </div>
  </div>
</div>

<!-- Modal de confirmación para quitar precio especial -->
<div
  id="modal-quitar-precio-especial"
  class="fixed inset-0 z-110 hidden items-center justify-center p-4"
>
  <div
    id="modal-quitar-precio-especial-backdrop"
    class="absolute inset-0 bg-slate-950/40 backdrop-blur-sm"
  >
  </div>

  <div
    class="relative w-full max-w-sm overflow-hidden rounded-2xl bg-white shadow-2xl"
  >
    <div class="p-5">
      <div
        class="flex h-10 w-10 items-center justify-center rounded-full bg-amber-50 text-amber-600"
      >
        <svg
          class="h-5 w-5"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M12 9v4m0 4h.01M10.29 3.86l-7.82 13.5A2 2 0 004.2 20h15.6a2 2 0 001.73-2.64l-7.82-13.5a2 2 0 00-3.46 0z"
          ></path>
        </svg>
      </div>

      <h3 class="mt-4 text-base font-semibold text-slate-900">
        Quitar precio especial
      </h3>

      <p class="mt-2 text-sm leading-6 text-slate-500">
        ¿Quieres quitar el precio especial? El precio final volverá a ser el
        precio calculado automáticamente.
      </p>
    </div>

    <div
      class="flex items-center justify-end gap-2 border-t border-slate-100 bg-slate-50 px-5 py-3"
    >
      <button
        id="modal-quitar-precio-especial-cancelar"
        type="button"
        class="h-9 rounded-lg border border-slate-200 bg-white px-4 text-xs font-medium text-slate-600 transition hover:bg-slate-100 hover:text-slate-800 focus:outline-none focus:ring-2 focus:ring-slate-300"
      >
        Cancelar
      </button>

      <button
        id="modal-quitar-precio-especial-confirmar"
        type="button"
        class="h-9 rounded-lg bg-red-600 px-4 text-xs font-medium text-white transition hover:bg-red-700 focus:outline-none focus:ring-2 focus:ring-red-300 disabled:cursor-not-allowed disabled:opacity-50"
      >
        Quitar precio
      </button>
    </div>
  </div>
</div>

<!-- Modal de confirmación de cancelación -->
<div
  id="modal-cancelar-pedido"
  class="fixed inset-0 z-120 hidden items-center justify-center p-4"
>
  <div
    id="modal-cancelar-backdrop"
    class="absolute inset-0 bg-slate-950/40 backdrop-blur-sm"
  >
  </div>

  <div
    class="relative w-full max-w-sm overflow-hidden rounded-2xl bg-white shadow-2xl"
  >
    <div class="p-5">
      <div
        class="flex h-10 w-10 items-center justify-center rounded-full bg-red-50 text-red-600"
      >
        <svg
          class="h-5 w-5"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M12 9v4m0 4h.01M10.29 3.86l-7.82 13.5A2 2 0 004.2 20h15.6a2 2 0 001.73-2.64l-7.82-13.5a2 2 0 00-3.46 0z"
          ></path>
        </svg>
      </div>

      <h3 class="mt-4 text-base font-semibold text-slate-900">
        Cancelar pedido
      </h3>

      <p class="mt-2 text-sm leading-6 text-slate-500">
        ¿Estás seguro de que quieres cancelar este pedido? Esta acción cambiará
        su estado a
        <span class="font-medium text-red-600">Cancelado</span>.
      </p>
    </div>

    <div
      class="flex items-center justify-end gap-2 border-t border-slate-100 bg-slate-50 px-5 py-3"
    >
      <button
        id="modal-cancelar-no"
        type="button"
        class="h-9 rounded-lg border border-slate-200 bg-white px-4 text-xs font-medium text-slate-600 transition hover:bg-slate-100 hover:text-slate-800 focus:outline-none focus:ring-2 focus:ring-slate-300"
      >
        Volver
      </button>

      <button
        id="modal-cancelar-si"
        type="button"
        class="h-9 rounded-lg bg-red-600 px-4 text-xs font-medium text-white transition hover:bg-red-700 focus:outline-none focus:ring-2 focus:ring-red-300 disabled:cursor-not-allowed disabled:opacity-50"
      >
        Sí, cancelar pedido
      </button>
    </div>
  </div>
</div>

<!-- Confirmación de cobro o reversión del último pago -->
<div
  id="modal-confirmar-pago"
  class="fixed inset-0 z-130 hidden items-center justify-center p-4"
  role="dialog"
  aria-modal="true"
  aria-labelledby="modal-confirmar-pago-titulo"
>
  <div
    id="modal-confirmar-pago-backdrop"
    class="absolute inset-0 bg-slate-950/40 backdrop-blur-sm"
  >
  </div>
  <div
    class="relative w-full max-w-sm overflow-hidden rounded-xl border border-slate-200 bg-white shadow-2xl"
  >
    <div class="p-5">
      <div
        class="flex h-10 w-10 items-center justify-center rounded-full bg-amber-50 text-amber-700"
      >
        <svg
          class="h-5 w-5"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M12 8v4l2.5 2.5M20 12a8 8 0 1 1-16 0 8 8 0 0 1 16 0Z"></path>
        </svg>
      </div>
      <h3
        id="modal-confirmar-pago-titulo"
        class="mt-4 text-base font-semibold text-slate-900"
      >
        Confirmar pago
      </h3>
      <p
        id="modal-confirmar-pago-texto"
        class="mt-2 text-sm leading-6 text-slate-600"
      >
      </p>
      <p
        id="modal-confirmar-pago-monto"
        class="mt-3 rounded-lg bg-slate-50 px-3 py-2 text-sm font-bold text-slate-900"
      >
      </p>
      <label
        id="modal-confirmar-pago-metodo-contenedor"
        for="modal-confirmar-pago-metodo"
        class="mt-4 block text-xs font-semibold text-slate-600"
      >
        Método de pago
        <select
          id="modal-confirmar-pago-metodo"
          class="mt-1 h-10 w-full rounded-lg border border-slate-200 bg-white px-3 text-sm font-normal text-slate-800 outline-none focus:border-cyan-600 focus:ring-2 focus:ring-cyan-100"
        >
          <option value="Efectivo">Efectivo</option>
          <option value="Transferencia">Transferencia</option>
        </select>
      </label>
      <p
        id="modal-confirmar-pago-error"
        class="mt-3 hidden text-sm font-medium text-red-700"
      >
      </p>
    </div>
    <div
      class="flex items-center justify-end gap-2 border-t border-slate-100 bg-slate-50 px-5 py-3"
    >
      <button
        id="modal-confirmar-pago-cancelar"
        type="button"
        class="h-9 rounded-lg border border-slate-200 bg-white px-4 text-xs font-medium text-slate-700 hover:bg-slate-100"
        >Dejar pendiente</button
      >
      <button
        id="modal-confirmar-pago-confirmar"
        type="button"
        class="h-9 rounded-lg bg-emerald-700 px-4 text-xs font-semibold text-white hover:bg-emerald-800 disabled:cursor-not-allowed disabled:opacity-50"
        >Sí, recibí el pago</button
      >
    </div>
  </div>
</div>
