<section
  id="transferencia-pedido"
  class="hidden border-b border-slate-200 px-5 py-4"
>
  <div class="rounded-xl border border-cyan-100 bg-cyan-50/70 p-4">
    <div class="flex items-start gap-3">
      <span
        class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-cyan-100 text-cyan-800"
        aria-hidden="true"
      >
        <svg
          class="h-5 w-5"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M12 16V4m0 0L7 9m5-5 5 5M4 16v3a1 1 0 001 1h14a1 1 0 001-1v-3"
          ></path>
        </svg>
      </span>
      <div class="min-w-0 flex-1">
        <h3 class="text-sm font-semibold text-slate-900">
          Enviar archivo a producción
        </h3>
      </div>
    </div>

    <div class="mt-3 flex flex-wrap items-center gap-2">
      <label
        for="transferencia-archivos-input"
        class="inline-flex h-9 cursor-pointer items-center rounded-lg border border-slate-200 bg-white px-3 text-xs font-semibold text-slate-700 transition hover:bg-slate-50"
      >
        Seleccionar archivos
      </label>
      <input
        id="transferencia-archivos-input"
        type="file"
        multiple
        class="sr-only"
      />
      <button
        id="transferencia-enviar"
        type="button"
        disabled
        class="h-9 rounded-lg bg-cyan-800 px-3 text-xs font-semibold text-white transition hover:bg-cyan-900 disabled:cursor-not-allowed disabled:opacity-50"
      >
        Enviar
      </button>
      <p
        id="transferencia-estado"
        class="w-full text-xs text-slate-500"
        aria-live="polite"
      >
      </p>
    </div>

    <ul
      id="transferencia-archivos-lista"
      class="mt-2 hidden space-y-1"
      aria-label="Archivos seleccionados"
    >
    </ul>

    <ul
      id="transferencia-envios"
      class="mt-3 hidden space-y-2"
      aria-label="Transferencias de pedidos"
      aria-live="polite"
    >
    </ul>
  </div>
</section>

<script>
  import { obtenerUsuario } from "../../services/auth";
  import {
    enviarArchivosPedido,
    suscribirseTransferencia,
    type ProgresoTransferencia,
    type EstadoDestinatarioTransferencia,
  } from "../../services/transferencias";

  const seccion = document.getElementById("transferencia-pedido");
  const entrada = document.getElementById(
    "transferencia-archivos-input",
  ) as HTMLInputElement | null;
  const boton = document.getElementById(
    "transferencia-enviar",
  ) as HTMLButtonElement | null;
  const estado = document.getElementById("transferencia-estado");
  const lista = document.getElementById("transferencia-archivos-lista");
  const listaEnvios = document.getElementById("transferencia-envios");
  const usuario = obtenerUsuario();
  let pedidoId: number | null = null;
  type EstadoRecepcion =
    | "pendiente"
    | "aceptado"
    | "rechazado"
    | "desconectado"
    | "expirado"
    | "recibido";
  type ArchivoEnvio = {
    id: string;
    archivo: File;
    progreso: number | null;
    destinatarios: Map<string, EstadoRecepcion>;
  };
  type EnvioPedido = {
    pedidoId: number;
    estado: string;
    error: boolean;
    archivos: ArchivoEnvio[];
    transferenciaId?: string;
  };
  let archivos: ArchivoEnvio[] = [];
  const envios: EnvioPedido[] = [];
  const enviosPorTransferenciaId = new Map<string, EnvioPedido>();
  const transferenciasExpiradas = new Set<string>();
  const estadosDestinatarioPendientes = new Map<
    string,
    EstadoDestinatarioTransferencia[]
  >();
  const TIEMPO_VISIBLE_ENVIO_MS = 3 * 60 * 1000;
  const MAXIMO_IDS_EXPIRADOS = 500;

  if (usuario?.rol === "ADMIN" || usuario?.rol === "DISENADOR") {
    seccion?.classList.remove("hidden");
  }

  function formatearTamano(bytes: number): string {
    if (bytes < 1024 * 1024) return `${Math.max(1, Math.round(bytes / 1024))} KB`;
    return `${(bytes / (1024 * 1024)).toFixed(1)} MB`;
  }

  function renderizarArchivos() {
    if (!lista || !boton) return;
    lista.replaceChildren();
    lista.classList.toggle("hidden", archivos.length === 0);

    for (const archivo of archivos) {
      const item = document.createElement("li");
      item.className = "rounded-lg bg-white/80 px-3 py-2 text-xs text-slate-600";
      const cabecera = document.createElement("div");
      cabecera.className = "flex items-center justify-between gap-3";
      const nombre = document.createElement("span");
      nombre.className = "min-w-0 truncate";
      nombre.textContent = archivo.archivo.name;
      const tamano = document.createElement("span");
      tamano.className = "shrink-0 text-slate-400";
      tamano.textContent = formatearTamano(archivo.archivo.size);
      cabecera.append(nombre, tamano);
      item.append(cabecera);

      if (archivo.progreso !== null) {
        const progreso = document.createElement("progress");
        progreso.className = "mt-2 h-1.5 w-full accent-cyan-700";
        progreso.max = 100;
        progreso.value = archivo.progreso;
        progreso.dataset.archivoProgreso = archivo.id;
        progreso.setAttribute("aria-label", `Progreso de ${archivo.archivo.name}`);
        item.append(progreso);
      }

      if (archivo.destinatarios.size > 0) {
        const receptores = document.createElement("ul");
        receptores.className = "mt-2 space-y-1 border-t border-slate-100 pt-2";
        for (const [username, estadoRecepcion] of archivo.destinatarios) {
          const receptor = document.createElement("li");
          receptor.className = "flex items-center justify-between gap-2";
          const empleado = document.createElement("span");
          empleado.className = "truncate";
          empleado.textContent = username;
          const estadoTexto = document.createElement("span");
          estadoTexto.className =
            estadoRecepcion === "recibido"
              ? "shrink-0 font-semibold text-emerald-700"
              : estadoRecepcion === "rechazado" ||
                      estadoRecepcion === "desconectado" ||
                      estadoRecepcion === "expirado"
                ? "shrink-0 font-medium text-red-600"
                : estadoRecepcion === "aceptado"
                  ? "shrink-0 font-medium text-cyan-700"
                  : "shrink-0 text-slate-400";
          estadoTexto.textContent =
            estadoRecepcion === "recibido"
              ? "Recibido"
              : estadoRecepcion === "aceptado"
                ? "Aceptó · recibiendo"
                : estadoRecepcion === "rechazado"
                  ? "Rechazó"
                  : estadoRecepcion === "desconectado"
                    ? "Desconectado"
                    : estadoRecepcion === "expirado"
                      ? "No recibido · venció"
                    : "Esperando respuesta";
          receptor.append(empleado, estadoTexto);
          receptores.append(receptor);
        }
        item.append(receptores);
      }

      lista.append(item);
    }

    boton.disabled = !pedidoId || archivos.length === 0 || archivos.length > 100;
  }

  function renderizarEnvios() {
    if (!listaEnvios) return;
    listaEnvios.replaceChildren();
    listaEnvios.classList.toggle("hidden", envios.length === 0);

    for (const envio of envios) {
      const tarjeta = document.createElement("li");
      tarjeta.className =
        "rounded-lg border border-slate-200 bg-white/70 px-3 py-2";
      const titulo = document.createElement("p");
      titulo.className = "text-xs font-semibold text-slate-800";
      titulo.textContent = `Pedido #${envio.pedidoId}`;
      const estadoEnvio = document.createElement("p");
      estadoEnvio.className = envio.error
        ? "mt-1 text-xs font-medium text-red-600"
        : "mt-1 text-xs text-slate-500";
      estadoEnvio.textContent = envio.estado;
      tarjeta.append(titulo, estadoEnvio);

      const archivosLista = document.createElement("ul");
      archivosLista.className = "mt-2 space-y-1";
      for (const archivo of envio.archivos) {
        const archivoItem = document.createElement("li");
        archivoItem.className =
          "rounded-md bg-slate-50 px-2 py-1.5 text-xs text-slate-600";
        const nombre = document.createElement("p");
        nombre.className = "truncate";
        nombre.textContent = archivo.archivo.name;
        archivoItem.append(nombre);

        if (archivo.progreso !== null) {
          const progreso = document.createElement("progress");
          progreso.className = "mt-1 h-1.5 w-full accent-cyan-700";
          progreso.max = 100;
          progreso.value = archivo.progreso;
          progreso.setAttribute(
            "aria-label",
            `Progreso de ${archivo.archivo.name}`,
          );
          archivoItem.append(progreso);
        }

        if (archivo.destinatarios.size > 0) {
          const receptores = document.createElement("p");
          receptores.className = "mt-1 text-[11px] text-slate-500";
          receptores.textContent = [...archivo.destinatarios]
            .map(([nombre, estadoRecepcion]) => {
              const estadoTexto =
                estadoRecepcion === "recibido"
                  ? "recibido"
                  : estadoRecepcion === "aceptado"
                    ? "recibiendo"
                    : estadoRecepcion === "rechazado"
                      ? "rechazó"
                      : estadoRecepcion === "desconectado"
                        ? "desconectado"
                        : estadoRecepcion === "expirado"
                          ? "venció"
                          : "pendiente";
              return `${nombre}: ${estadoTexto}`;
            })
            .join(" · ");
          archivoItem.append(receptores);
        }
        archivosLista.append(archivoItem);
      }
      tarjeta.append(archivosLista);
      listaEnvios.append(tarjeta);
    }
  }

  function ocultarEnvioDespuesDeUnTiempo(envio: EnvioPedido) {
    window.setTimeout(() => {
      const indice = envios.indexOf(envio);
      if (indice === -1) return;
      envios.splice(indice, 1);
      if (envio.transferenciaId) {
        enviosPorTransferenciaId.delete(envio.transferenciaId);
        estadosDestinatarioPendientes.delete(envio.transferenciaId);
        transferenciasExpiradas.add(envio.transferenciaId);
        if (transferenciasExpiradas.size > MAXIMO_IDS_EXPIRADOS) {
          const masAntigua = transferenciasExpiradas.values().next().value;
          if (masAntigua) transferenciasExpiradas.delete(masAntigua);
        }
      }
      renderizarEnvios();
    }, TIEMPO_VISIBLE_ENVIO_MS);
  }

  function actualizarProgreso(
    envio: EnvioPedido,
    progreso: ProgresoTransferencia,
  ) {
    if (progreso.estado === "solicitando") {
      envio.estado = "Buscando empleados conectados...";
    } else if (progreso.estado === "esperando") {
      envio.estado = "Esperando que los empleados acepten...";
    } else if (progreso.estado === "enviando") {
      const porcentaje =
        progreso.total > 0
          ? Math.round((progreso.enviados / progreso.total) * 100)
          : 100;
      const archivo = envio.archivos.find(
        (item) => item.id === progreso.archivoId,
      );
      envio.estado = `${progreso.nombreArchivo}: enviando ${formatearTamano(progreso.enviados)} de ${formatearTamano(progreso.total)}`;
      if (archivo) archivo.progreso = porcentaje;
    } else {
      envio.estado = "Archivos enviados. Esperando confirmaciones...";
      envio.archivos.forEach((archivo) => (archivo.progreso = 100));
    }
    renderizarEnvios();
  }

  function actualizarEstadoDestinatario(
    actualizacion: EstadoDestinatarioTransferencia,
  ) {
    const envio = enviosPorTransferenciaId.get(actualizacion.transferenciaId);
    if (!envio) {
      if (transferenciasExpiradas.has(actualizacion.transferenciaId)) return;
      const pendientes = estadosDestinatarioPendientes.get(
        actualizacion.transferenciaId,
      ) ?? [];
      pendientes.push(actualizacion);
      estadosDestinatarioPendientes.set(
        actualizacion.transferenciaId,
        pendientes,
      );
      return;
    }

    if (
      actualizacion.estado === "aceptado" ||
      actualizacion.estado === "rechazado" ||
      actualizacion.estado === "desconectado" ||
      actualizacion.estado === "expirado"
    ) {
      for (const archivo of envio.archivos) {
        if (
          actualizacion.estado === "desconectado" &&
          archivo.destinatarios.get(actualizacion.username) === "recibido"
        ) {
          continue;
        }
        archivo.destinatarios.set(actualizacion.username, actualizacion.estado);
      }
    } else if (actualizacion.estado === "recibido") {
      const archivo = envio.archivos.find(
        (item) => item.id === actualizacion.archivoId,
      );
      archivo?.destinatarios.set(actualizacion.username, "recibido");
    }
    renderizarEnvios();
  }

  if (usuario?.rol === "ADMIN" || usuario?.rol === "DISENADOR") {
    suscribirseTransferencia<EstadoDestinatarioTransferencia>(
      "transferencia:estado-destinatario",
      actualizarEstadoDestinatario,
    );
  }

  entrada?.addEventListener("change", () => {
    const seleccionados = Array.from(entrada.files ?? []);
    archivos = seleccionados.map((archivo) => ({
      id: "",
      archivo,
      progreso: null,
      destinatarios: new Map(),
    }));
    if (estado) {
      estado.textContent =
        seleccionados.length > 100
          ? "Puedes enviar hasta 100 archivos a la vez."
          : "";
      estado.classList.toggle("text-red-700", seleccionados.length > 100);
    }
    renderizarArchivos();
  });

  boton?.addEventListener("click", () => {
    if (!pedidoId || archivos.length === 0 || archivos.length > 100) return;
    const pedidoIdEnvio = pedidoId;
    const archivosSeleccionados = archivos.map((archivo) => archivo.archivo);
    const envio: EnvioPedido = {
      pedidoId: pedidoIdEnvio,
      estado: "Preparando envío...",
      error: false,
      archivos: archivos.map((archivo) => ({ ...archivo })),
    };
    envios.unshift(envio);
    archivos = [];
    if (entrada) entrada.value = "";
    renderizarArchivos();
    renderizarEnvios();
    estado?.classList.remove("text-red-700");

    void (async () => {
      try {
        await enviarArchivosPedido(
          pedidoIdEnvio,
          archivosSeleccionados,
          (progreso) => actualizarProgreso(envio, progreso),
          (preparados) => {
            envio.archivos = preparados.map(({ id, archivo }) => ({
              id,
              archivo,
              progreso: null,
              destinatarios: new Map(),
            }));
            renderizarEnvios();
          },
          (id) => {
            envio.transferenciaId = id;
            enviosPorTransferenciaId.set(id, envio);
            const pendientes = estadosDestinatarioPendientes.get(id) ?? [];
            estadosDestinatarioPendientes.delete(id);
            pendientes.forEach(actualizarEstadoDestinatario);
          },
          (nombres) => {
            for (const archivo of envio.archivos) {
              for (const nombre of nombres) {
                if (!archivo.destinatarios.has(nombre)) {
                  archivo.destinatarios.set(nombre, "pendiente");
                }
              }
            }
            renderizarEnvios();
          },
        );
        ocultarEnvioDespuesDeUnTiempo(envio);
      } catch (error) {
        envio.error = true;
        envio.estado =
          error instanceof Error
            ? error.message
            : "No se pudieron transferir los archivos.";
        ocultarEnvioDespuesDeUnTiempo(envio);
        renderizarEnvios();
      }
    })();
  });

  document.addEventListener("centro-control:abrir-pedido", (evento) => {
    const detalle = (evento as CustomEvent<{ id?: number }>).detail;
    pedidoId = typeof detalle?.id === "number" ? detalle.id : null;
    archivos = [];
    if (entrada) entrada.value = "";
    if (estado) {
      estado.textContent = "";
      estado.classList.remove("text-red-700");
    }
    renderizarArchivos();
  });
</script>
