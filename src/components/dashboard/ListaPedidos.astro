---

---

<section
  class="flex min-h-0 h-full flex-col overflow-hidden rounded-2xl border border-slate-200 bg-white"
>
  <!-- Encabezado -->
  <div class="shrink-0 border-b border-slate-200 p-4 sm:p-5">
    <div
      class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between"
    >
      <div class="min-w-0 flex-1">
        <h2 class="font-semibold text-slate-900">Pedidos pendientes</h2>

        <div class="mt-3 flex flex-wrap items-center gap-2">
          <label class="group relative block w-full max-w-md">
            <span class="sr-only">Buscar pedidos por nombre de cliente</span>
            <svg
              class="pointer-events-none absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-slate-400 transition duration-200 group-focus-within:scale-110 group-focus-within:text-cyan-700"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
            >
              <circle cx="11" cy="11" r="7"></circle>
              <path stroke-linecap="round" d="m20 20-4-4"></path>
            </svg>
            <input
              id="buscar-pedidos-cliente"
              type="search"
              autocomplete="off"
              placeholder="Buscar por nombre de cliente"
              class="h-10 w-full rounded-xl border border-slate-200 bg-slate-50 pl-9 pr-3 text-sm text-slate-800 outline-none transition-[width,border-color,box-shadow,background-color] duration-300 ease-out placeholder:text-slate-400 focus:border-cyan-600 focus:bg-white focus:ring-2 focus:ring-cyan-100 sm:w-80 sm:focus:w-96"
            />
          </label>
          <p
            id="pedidos-busqueda-resultados"
            class="hidden text-xs font-medium text-slate-500"
            aria-live="polite"
          >
          </p>
        </div>

        <div class="mt-2 flex max-w-full flex-wrap items-center gap-2 pb-1">
          <div
            class="inline-flex shrink-0 flex-nowrap items-center gap-1 rounded-xl border border-slate-200 bg-slate-50 p-1"
            role="group"
            aria-label="Filtrar pedidos por estado"
          >
            <button
              type="button"
              data-filtro="TODOS"
              aria-pressed="true"
              class="filtro-pedido rounded-lg bg-white/70 px-3 py-2 text-xs font-medium text-slate-600 transition hover:bg-white focus:outline-none focus-visible:ring-2 focus-visible:ring-cyan-600"
              >Todos</button
            >
            <button
              type="button"
              data-filtro="REVISION"
              aria-pressed="false"
              class="filtro-pedido rounded-lg bg-white/70 px-3 py-2 text-xs font-medium text-slate-600 transition hover:bg-white focus:outline-none focus-visible:ring-2 focus-visible:ring-amber-600"
              >Por confirmar</button
            >
            <button
              type="button"
              data-filtro="IMPRIMIENDO"
              aria-pressed="false"
              class="filtro-pedido rounded-lg bg-white/70 px-3 py-2 text-xs font-medium text-slate-600 transition hover:bg-white focus:outline-none focus-visible:ring-2 focus-visible:ring-cyan-600"
              >Imprimiendo</button
            >
            <button
              type="button"
              data-filtro="LISTO"
              aria-pressed="false"
              class="filtro-pedido rounded-lg bg-white/70 px-3 py-2 text-xs font-medium text-slate-600 transition hover:bg-white focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-600"
              >Listos</button
            >
            <button
              type="button"
              data-filtro="ENTREGADO"
              aria-pressed="false"
              class="filtro-pedido rounded-lg bg-white/70 px-3 py-2 text-xs font-medium text-slate-600 transition hover:bg-white focus:outline-none focus-visible:ring-2 focus-visible:ring-slate-700"
              >Entregados</button
            >
          </div>

          <div
            class="inline-flex shrink-0 flex-nowrap items-center gap-1 rounded-xl border border-slate-200 bg-slate-50 p-1"
            role="group"
            aria-label="Filtrar pedidos por servicio y ancho"
          >
            <button
              type="button"
              data-servicio-filtro="TODOS"
              aria-pressed="true"
              class="filtro-servicio-pedido rounded-lg bg-white/70 px-3 py-2 text-xs font-medium text-slate-600 transition hover:bg-white focus:outline-none focus-visible:ring-2 focus-visible:ring-cyan-600"
              >Todos los servicios</button
            >
            <button
              type="button"
              data-servicio-filtro="UV"
              aria-pressed="false"
              class="filtro-servicio-pedido rounded-lg bg-white/70 px-3 py-2 text-xs font-medium text-slate-600 transition hover:bg-white focus:outline-none focus-visible:ring-2 focus-visible:ring-cyan-600"
              >UV</button
            >
            <button
              type="button"
              data-servicio-filtro="TEXTIL_31"
              aria-pressed="false"
              class="filtro-servicio-pedido rounded-lg bg-white/70 px-3 py-2 text-xs font-medium text-slate-600 transition hover:bg-white focus:outline-none focus-visible:ring-2 focus-visible:ring-cyan-600"
              >Textil 31 cm</button
            >
            <button
              type="button"
              data-servicio-filtro="TEXTIL_58"
              aria-pressed="false"
              class="filtro-servicio-pedido rounded-lg bg-white/70 px-3 py-2 text-xs font-medium text-slate-600 transition hover:bg-white focus:outline-none focus-visible:ring-2 focus-visible:ring-cyan-600"
              >Textil 58 cm</button
            >
          </div>
        </div>

        <div
          id="pedidos-seleccion-acciones"
          class="mt-3 hidden flex flex-wrap items-center gap-3 rounded-xl border border-cyan-200 bg-cyan-50 p-3"
          aria-live="polite"
        >
          <p
            id="pedidos-seleccion-resumen"
            class="text-sm font-semibold text-slate-800"
          >
          </p>
          <p
            id="pedidos-seleccion-mensaje"
            class="min-w-0 flex-1 text-xs text-slate-600"
          >
          </p>
          <p
            id="pedidos-seleccion-total-ayuda"
            class="min-w-0 flex-1 text-xs text-slate-600"
          >
          </p>
          <button
            id="pedidos-seleccion-ver-total"
            type="button"
            disabled
            class="rounded-lg border border-cyan-200 bg-white px-3 py-2 text-xs font-semibold text-cyan-900 transition hover:bg-cyan-50 disabled:cursor-not-allowed disabled:opacity-50"
          >
            Ver valor total
          </button>
          <button
            id="pedidos-seleccion-avanzar"
            type="button"
            disabled
            class="rounded-lg bg-cyan-800 px-3 py-2 text-xs font-semibold text-white transition hover:bg-cyan-900 disabled:cursor-not-allowed disabled:opacity-50"
          >
            Avanzar
          </button>
          <button
            id="pedidos-seleccion-limpiar"
            type="button"
            class="rounded-lg border border-slate-300 bg-white px-3 py-2 text-xs font-semibold text-slate-700 transition hover:bg-slate-50 disabled:cursor-not-allowed disabled:opacity-50"
          >
            Limpiar selección
          </button>
        </div>
      </div>

      <button
        type="button"
        id="btn-nuevo-pedido"
        class="shrink-0 rounded-lg bg-slate-900 px-3 py-2 text-sm font-medium text-white transition hover:bg-slate-800"
      >
        + Nuevo pedido
      </button>
    </div>

  </div>

  <!-- Contenedor scrolleable -->
  <div class="min-h-0 flex-1 overflow-y-auto">
    <!-- Loading -->
    <div
      id="pedidos-loading"
      class="flex items-center justify-center px-5 py-16"
    >
      <div class="flex items-center gap-3 text-sm text-slate-400">
        <span
          class="h-5 w-5 animate-spin rounded-full border-2 border-slate-200 border-t-slate-700"
        ></span>

        Cargando pedidos...
      </div>
    </div>

    <!-- Vacío -->
    <div id="pedidos-vacio" class="hidden px-5 py-16 text-center">
      <p id="pedidos-vacio-titulo" class="font-medium text-slate-700">
        No hay pedidos de hoy
      </p>

      <p id="pedidos-vacio-descripcion" class="mt-1 text-sm text-slate-400">
        Los pedidos creados hoy aparecerán aquí.
      </p>
    </div>

    <!-- Error -->
    <div id="pedidos-error" class="hidden px-5 py-16 text-center">
      <p class="font-medium text-red-600">No se pudieron cargar los pedidos</p>

      <p class="mt-1 text-sm text-slate-400">
        Comprueba que el backend esté disponible.
      </p>
    </div>

    <!-- Tabla -->
    <div id="pedidos-tabla" class="hidden overflow-x-auto">
      <table class="w-full min-w-225 text-left text-sm">
        <thead
          class="sticky top-0 z-10 bg-slate-50 text-xs uppercase tracking-wide text-slate-400"
        >
          <tr>
            <th class="w-12 px-3 py-3">
              <input
                id="pedidos-seleccionar-visibles"
                type="checkbox"
                aria-label="Seleccionar todos los pedidos disponibles del filtro actual"
                class="h-4 w-4 rounded border-slate-300 accent-cyan-700 focus:ring-cyan-600"
              />
            </th>
            <th class="px-5 py-3 font-medium">Pedido</th>
            <th class="px-5 py-3 font-medium">Cliente</th>
            <th class="px-5 py-3 font-medium">Servicio</th>
            <th class="px-5 py-3 font-medium">Medidas</th>
            <th class="px-5 py-3 font-medium">Precio</th>
            <th class="px-5 py-3 font-medium">Estado</th>
            <th class="px-5 py-3 font-medium">Pago</th>
            <th class="px-5 py-3 font-medium"></th>
          </tr>
        </thead>

        <tbody id="pedidos-body" class="divide-y divide-slate-100"></tbody>
      </table>
    </div>
  </div>
</section>

<div
  id="pedido-referencia-preview-modal"
  class="invisible fixed inset-0 z-[70] flex items-center justify-center bg-slate-950/75 p-4 opacity-0 transition-opacity"
  aria-hidden="true"
>
  <div
    class="relative flex max-h-full w-full max-w-4xl flex-col rounded-2xl bg-white p-4 shadow-2xl sm:p-6"
    role="dialog"
    aria-modal="true"
    aria-labelledby="pedido-referencia-preview-titulo"
  >
    <div class="mb-3 flex items-center justify-between gap-3">
      <h2
        id="pedido-referencia-preview-titulo"
        class="text-base font-semibold text-slate-900"
      >
        Imagen de referencia
      </h2>
      <button
        id="pedido-referencia-preview-cerrar"
        type="button"
        class="rounded-lg p-2 text-slate-500 transition hover:bg-slate-100 hover:text-slate-900"
        aria-label="Cerrar vista previa"
      >
        <svg
          class="h-5 w-5"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <path stroke-linecap="round" d="m6 6 12 12M18 6 6 18"></path>
        </svg>
      </button>
    </div>
    <p
      id="pedido-referencia-preview-estado"
      class="mb-3 text-sm text-slate-500"
      aria-live="polite"
    >
      Cargando imagen...
    </p>
    <img
      id="pedido-referencia-preview-imagen"
      class="hidden max-h-[75vh] w-full rounded-lg bg-slate-100 object-contain"
      alt="Vista previa de la imagen de referencia del pedido"
    />
  </div>
</div>

<div
  id="pedidos-valor-modal"
  class="invisible fixed inset-0 z-[80] flex items-center justify-center bg-slate-950/75 p-4 opacity-0 transition-opacity"
  aria-hidden="true"
>
  <section
    class="flex max-h-[90vh] w-full max-w-2xl flex-col rounded-2xl bg-white p-4 shadow-2xl sm:p-6"
    role="dialog"
    aria-modal="true"
    aria-labelledby="pedidos-valor-titulo"
  >
    <header class="mb-4 flex items-start justify-between gap-3">
      <div>
        <h2
          id="pedidos-valor-titulo"
          class="text-lg font-semibold text-slate-900"
        >
          Detalle de pedidos
        </h2>
        <p
          id="pedidos-valor-cliente"
          class="mt-1 text-sm text-slate-500"
        >
        </p>
      </div>
      <button
        id="pedidos-valor-cerrar"
        type="button"
        class="rounded-lg p-2 text-slate-500 transition hover:bg-slate-100 hover:text-slate-900"
        aria-label="Cerrar detalle de pedidos"
      >
        <svg
          class="h-5 w-5"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <path stroke-linecap="round" d="m6 6 12 12M18 6 6 18"></path>
        </svg>
      </button>
    </header>

    <ul
      id="pedidos-valor-detalle"
      class="min-h-0 divide-y divide-slate-200 overflow-y-auto rounded-xl border border-slate-200 px-3"
      aria-label="Detalle de los pedidos seleccionados"
    >
    </ul>

    <div
      class="mt-4 flex items-center justify-between border-t border-slate-200 pt-4"
    >
      <span class="text-sm font-semibold text-slate-700">Total a pagar</span>
      <span
        id="pedidos-valor-total"
        class="text-xl font-bold text-slate-900"
      ></span>
    </div>
    <p
      id="pedidos-valor-estado"
      class="mt-2 min-h-5 text-xs text-slate-500"
      aria-live="polite"
    >
    </p>

    <footer class="mt-4 flex flex-wrap justify-end gap-2">
      <button
        id="pedidos-valor-cerrar-secundario"
        type="button"
        class="rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm font-medium text-slate-700 transition hover:bg-slate-50"
      >
        Cerrar
      </button>
      <button
        id="pedidos-valor-copiar"
        type="button"
        class="rounded-lg border border-emerald-200 bg-white px-3 py-2 text-sm font-semibold text-emerald-800 transition hover:bg-emerald-50"
      >
        Copiar para WhatsApp
      </button>
      <button
        id="pedidos-valor-pdf"
        type="button"
        class="rounded-lg bg-cyan-800 px-3 py-2 text-sm font-semibold text-white transition hover:bg-cyan-900 disabled:cursor-not-allowed disabled:opacity-50"
      >
        Descargar comprobante PDF
      </button>
    </footer>
  </section>
</div>

<script>
  import {
    iniciarPedidosStore,
    suscribirsePedidos,
  } from "../../services/pedidos-store";

  import type { EstadoPedido, Pedido } from "../../types/pedido";
  import {
    cambiarEstadoPedido,
    emitirNotaVenta,
    obtenerImagenReferenciaPedido,
    type NotaVentaDetalle,
  } from "../../services/api";
  import { copiarTelefono, copiarTexto } from "../../utils/copiar-telefono";
  import { crearFilaPedido } from "../../utils/pedidos-render";
  import { mostrarNotificacion } from "../../utils/notificaciones";
  import { descargarNotaVentaPdf } from "../../utils/nota-venta-pdf";
  import { obtenerUsuario } from "../../services/auth";
  import { pedidoPerteneceAlArea } from "../../services/permisos";
  import {
    estados,
    formatearMedidas,
    formatearPrecio,
    obtenerPedidosFiltrados as obtenerPedidosFiltradosLista,
    type FiltroPedido,
    type FiltroServicioPedido,
  } from "../../utils/pedidos-lista";
  import { estadosSiguientes } from "../../utils/pedido-detalle";

  const loading = document.getElementById("pedidos-loading");
  const vacio = document.getElementById("pedidos-vacio");
  const vacioTitulo = document.getElementById("pedidos-vacio-titulo");
  const vacioDescripcion = document.getElementById("pedidos-vacio-descripcion");
  const error = document.getElementById("pedidos-error");
  const tabla = document.getElementById("pedidos-tabla");
  const body = document.getElementById("pedidos-body");
  const buscadorCliente = document.getElementById(
    "buscar-pedidos-cliente",
  ) as HTMLInputElement | null;
  const resultadosBusqueda = document.getElementById(
    "pedidos-busqueda-resultados",
  );
  const accionesSeleccion = document.getElementById(
    "pedidos-seleccion-acciones",
  );
  const resumenSeleccion = document.getElementById(
    "pedidos-seleccion-resumen",
  );
  const mensajeSeleccion = document.getElementById(
    "pedidos-seleccion-mensaje",
  );
  const ayudaVerTotal = document.getElementById(
    "pedidos-seleccion-total-ayuda",
  );
  const botonVerTotal = document.getElementById(
    "pedidos-seleccion-ver-total",
  ) as HTMLButtonElement | null;
  const modalTotalPedidos = document.getElementById("pedidos-valor-modal");
  const modalTotalCliente = document.getElementById("pedidos-valor-cliente");
  const modalTotalDetalle = document.getElementById("pedidos-valor-detalle");
  const modalTotalValor = document.getElementById("pedidos-valor-total");
  const modalTotalEstado = document.getElementById("pedidos-valor-estado");
  const modalTotalCerrar = document.getElementById("pedidos-valor-cerrar");
  const modalTotalCerrarSecundario = document.getElementById(
    "pedidos-valor-cerrar-secundario",
  );
  const modalTotalCopiar = document.getElementById(
    "pedidos-valor-copiar",
  ) as HTMLButtonElement | null;
  const modalTotalPdf = document.getElementById(
    "pedidos-valor-pdf",
  ) as HTMLButtonElement | null;
  const botonAvanzarSeleccion = document.getElementById(
    "pedidos-seleccion-avanzar",
  ) as HTMLButtonElement | null;
  const botonLimpiarSeleccion = document.getElementById(
    "pedidos-seleccion-limpiar",
  ) as HTMLButtonElement | null;
  const checkboxSeleccionarVisibles = document.getElementById(
    "pedidos-seleccionar-visibles",
  ) as HTMLInputElement | null;
  const previewModal = document.getElementById(
    "pedido-referencia-preview-modal",
  );
  const previewCerrar = document.getElementById(
    "pedido-referencia-preview-cerrar",
  );
  const previewEstado = document.getElementById(
    "pedido-referencia-preview-estado",
  );
  const previewImagen = document.getElementById(
    "pedido-referencia-preview-imagen",
  ) as HTMLImageElement | null;
  let solicitudPreviewReferencia = 0;

  function cerrarPreviewReferencia() {
    solicitudPreviewReferencia += 1;
    previewModal?.classList.add("invisible", "opacity-0");
    previewModal?.setAttribute("aria-hidden", "true");
    document.body.classList.remove("overflow-hidden");
    previewImagen?.classList.add("hidden");
    previewImagen?.removeAttribute("src");
    if (previewEstado) previewEstado.textContent = "";
  }

  async function abrirPreviewReferencia(pedidoId: number) {
    if (!previewModal || !previewEstado || !previewImagen) return;

    const solicitud = ++solicitudPreviewReferencia;
    previewModal.classList.remove("invisible", "opacity-0");
    previewModal.setAttribute("aria-hidden", "false");
    document.body.classList.add("overflow-hidden");
    previewEstado.textContent = `Cargando imagen del pedido #${pedidoId}...`;
    previewImagen.classList.add("hidden");
    previewImagen.removeAttribute("src");

    try {
      const referencia = await obtenerImagenReferenciaPedido(pedidoId);
      if (solicitud !== solicitudPreviewReferencia) return;
      previewImagen.src = referencia.url;
      previewImagen.classList.remove("hidden");
      previewEstado.textContent = `Pedido #${pedidoId} · Disponible hasta ${new Date(referencia.venceEn).toLocaleString("es-EC")}.`;
    } catch (error) {
      if (solicitud !== solicitudPreviewReferencia) return;
      previewEstado.textContent =
        error instanceof Error
          ? error.message
          : "No se pudo cargar la imagen de referencia.";
    }
  }

  previewCerrar?.addEventListener("click", cerrarPreviewReferencia);
  previewModal?.addEventListener("click", (event) => {
    if (event.target === previewModal) cerrarPreviewReferencia();
  });
  document.addEventListener("keydown", (event) => {
    if (
      event.key === "Escape" &&
      previewModal?.getAttribute("aria-hidden") === "false"
    ) {
      cerrarPreviewReferencia();
    }
  });

  let filtroActual: FiltroPedido = "TODOS";
  let filtroServicioActual: FiltroServicioPedido = "TODOS";
  let nombreBuscado = "";
  const pedidosSeleccionados = new Set<number>();
  let procesandoCambioMasivo = false;
  let progresoCambioMasivo = "";
  let pedidosResumenModal: Pedido[] = [];
  let idempotencyKeyNotaVenta: string | null = null;

  /*
   * Pedidos recibidos del store.
   */
  let pedidosActuales: Pedido[] = [];

  /*
   * Determina si una fecha corresponde al día
   * actual en la zona horaria local del navegador.
   *
   * createdAt viene del backend como un instante UTC
   * y puede contener el sufijo "Z".
   *
   * JavaScript convierte el instante a la zona
   * horaria local antes de obtener año, mes y día.
   */
  // function pedidoEsDeHoy(pedido: Pedido): boolean {
  //   const fechaPedido = new Date(pedido.createdAt);
  //   const hoy = new Date();

  //   return (
  //     fechaPedido.getFullYear() === hoy.getFullYear() &&
  //     fechaPedido.getMonth() === hoy.getMonth() &&
  //     fechaPedido.getDate() === hoy.getDate()
  //   );
  // }

  /*
   * Obtiene los pedidos de hoy,
   * aplica el filtro y posteriormente
   * los ordena.
   */

  function obtenerPedidosFiltrados(): Pedido[] {
    const pedidosFiltrados = obtenerPedidosFiltradosLista(
      pedidosActuales.filter((pedido) =>
        pedidoPerteneceAlArea(pedido, obtenerUsuario()),
      ),
      filtroActual,
      filtroServicioActual,
    );
    const consulta = normalizarTexto(nombreBuscado);

    if (!consulta) {
      return pedidosFiltrados;
    }

    return pedidosFiltrados.filter((pedido) =>
      normalizarTexto(pedido.cliente.nombre).includes(consulta),
    );
  }

  function normalizarTexto(valor: string): string {
    return valor
      .normalize("NFD")
      .replace(/[\u0300-\u036f]/g, "")
      .toLocaleLowerCase("es");
  }

  function obtenerSiguienteEstadoMasivo(
    estado: EstadoPedido,
  ): EstadoPedido | null {
    return estadosSiguientes[estado] ?? null;
  }

  function obtenerPrecioPedido(pedido: Pedido): number | null {
    const precio =
      pedido.valorCobrar ?? pedido.precioFinal ?? pedido.precioCalculado;
    return typeof precio === "number" && Number.isFinite(precio)
      ? precio
      : null;
  }

  function generarMensajePedidosSeleccionados(
    pedidos: Pedido[],
  ): string | null {
    const primerPedido = pedidos[0];
    if (
      !primerPedido ||
      pedidos.some((pedido) => pedido.cliente.id !== primerPedido.cliente.id)
    ) {
      return null;
    }

    const precios = pedidos.map(obtenerPrecioPedido);
    if (precios.some((precio) => precio === null)) return null;

    const detalle = pedidos
      .map((pedido, indice) => {
        const servicio =
          pedido.servicio === "TEXTIL" ? "DTF textil" : "DTF UV";
        return `• Pedido #${pedido.id} — ${servicio} — ${formatearMedidas(pedido)}: ${formatearPrecio(precios[indice])}`;
      })
      .join("\n");
    const total = precios.reduce((suma, precio) => suma + (precio ?? 0), 0);

    return `Hola ${primerPedido.cliente.nombre}, te comparto el detalle de tus pedidos:\n\n${detalle}\n\nTotal a pagar: ${formatearPrecio(total)}`;
  }

  function obtenerPedidosSeleccionadosVisibles(): Pedido[] {
    return obtenerPedidosFiltrados().filter((pedido) =>
      pedidosSeleccionados.has(pedido.id),
    );
  }

  function actualizarDetalleModalNota(
    cliente: string,
    pedidos: NotaVentaDetalle[],
    total: number,
  ) {
    if (!modalTotalCliente || !modalTotalValor || !modalTotalDetalle) return;

    modalTotalCliente.textContent = `Cliente: ${cliente}`;
    modalTotalValor.textContent = formatearPrecio(total);
    modalTotalDetalle.replaceChildren();

    for (const pedido of pedidos) {
      const item = document.createElement("li");
      item.className = "flex items-center justify-between gap-4 py-3";
      const descripcion = document.createElement("div");
      descripcion.className = "min-w-0";
      const titulo = document.createElement("p");
      titulo.className = "text-sm font-semibold text-slate-800";
      titulo.textContent = `Pedido #${pedido.pedidoId} · ${
        pedido.servicio === "TEXTIL" ? "DTF textil" : "DTF UV"
      }`;
      const medidas = document.createElement("p");
      medidas.className = "mt-0.5 text-xs text-slate-500";
      medidas.textContent = `Medida: ${
        pedido.largo === null
          ? `${pedido.ancho} cm`
          : `${pedido.ancho} × ${pedido.largo} cm`
      }`;
      const precio = document.createElement("p");
      precio.className = "shrink-0 text-sm font-semibold text-slate-800";
      precio.textContent = formatearPrecio(pedido.valor);
      descripcion.append(titulo, medidas);
      item.append(descripcion, precio);
      modalTotalDetalle.append(item);
    }
  }

  function abrirModalTotalPedidos() {
    const seleccionados = obtenerPedidosSeleccionadosVisibles();
    const mensaje = generarMensajePedidosSeleccionados(seleccionados);
    if (
      !mensaje ||
      !modalTotalPedidos ||
      !modalTotalDetalle ||
      !modalTotalCliente ||
      !modalTotalValor
    ) {
      return;
    }

    pedidosResumenModal = seleccionados;
    idempotencyKeyNotaVenta = crypto.randomUUID();
    const precios = seleccionados.map(obtenerPrecioPedido);
    const detalle = seleccionados.flatMap((pedido, indice) => {
      const valor = precios[indice];
      return valor === null
        ? []
        : [
            {
              pedidoId: pedido.id,
              servicio: pedido.servicio,
              ancho: pedido.ancho,
              largo: pedido.largo,
              valor,
            },
          ];
    });
    if (detalle.length !== seleccionados.length) {
      mostrarNotificacion(
        "No se pudo calcular el total de los pedidos seleccionados.",
        "error",
      );
      return;
    }
    const total = detalle.reduce((suma, pedido) => suma + pedido.valor, 0);
    actualizarDetalleModalNota(
      seleccionados[0]?.cliente.nombre ?? "",
      detalle,
      total,
    );

    modalTotalEstado && (modalTotalEstado.textContent = "");
    modalTotalPedidos.classList.remove("invisible", "opacity-0");
    modalTotalPedidos.setAttribute("aria-hidden", "false");
    document.body.classList.add("overflow-hidden");
    modalTotalCerrar?.focus();
  }

  function cerrarModalTotalPedidos() {
    if (modalTotalPdf?.disabled) return;
    modalTotalPedidos?.classList.add("invisible", "opacity-0");
    modalTotalPedidos?.setAttribute("aria-hidden", "true");
    document.body.classList.remove("overflow-hidden");
    pedidosResumenModal = [];
    idempotencyKeyNotaVenta = null;
    botonVerTotal?.focus();
  }

  function actualizarResumenSeleccion(pedidosVisibles: Pedido[]) {
    if (buscadorCliente) {
      buscadorCliente.disabled = procesandoCambioMasivo;
    }
    document
      .querySelectorAll<HTMLButtonElement>(
        "[data-filtro], [data-servicio-filtro]",
      )
      .forEach((boton) => {
        boton.disabled = procesandoCambioMasivo;
      });

    const pedidosPorId = new Map<number, Pedido>(
      pedidosVisibles.map((pedido) => [pedido.id, pedido] as const),
    );
    for (const id of pedidosSeleccionados) {
      const pedido = pedidosPorId.get(id);
      if (!pedido) pedidosSeleccionados.delete(id);
    }

    const seleccionados = pedidosVisibles.filter((pedido) =>
      pedidosSeleccionados.has(pedido.id),
    );
    const totalSeleccionadosVisibles = seleccionados.length;
    if (checkboxSeleccionarVisibles) {
      checkboxSeleccionarVisibles.checked =
        pedidosVisibles.length > 0 &&
        pedidosVisibles.length === totalSeleccionadosVisibles;
      checkboxSeleccionarVisibles.indeterminate =
        totalSeleccionadosVisibles > 0 &&
        totalSeleccionadosVisibles < pedidosVisibles.length;
      checkboxSeleccionarVisibles.disabled =
        procesandoCambioMasivo || pedidosVisibles.length === 0;
    }

    accionesSeleccion?.classList.toggle(
      "hidden",
      totalSeleccionadosVisibles === 0,
    );
    if (totalSeleccionadosVisibles === 0) return;

    if (resumenSeleccion) {
      resumenSeleccion.textContent = `${totalSeleccionadosVisibles} ${
        totalSeleccionadosVisibles === 1
          ? "pedido seleccionado"
          : "pedidos seleccionados"
      }`;
    }

    const preciosSeleccionados = seleccionados.map(obtenerPrecioPedido);
    const totalSeleccionado =
      preciosSeleccionados.every((precio) => precio !== null)
        ? preciosSeleccionados.reduce(
            (suma, precio) => suma + (precio ?? 0),
            0,
          )
        : null;
    const mismoCliente = seleccionados.every(
      (pedido) => pedido.cliente.id === seleccionados[0]?.cliente.id,
    );
    if (ayudaVerTotal) {
      ayudaVerTotal.textContent = !mismoCliente
        ? "Selecciona pedidos de un solo cliente para ver el total."
        : totalSeleccionado === null
          ? "Hay pedidos sin precio confirmado; no se puede calcular el total."
          : `Ver el comprobante de ${seleccionados[0]?.cliente.nombre}.`;
    }
    if (botonVerTotal) {
      botonVerTotal.disabled =
        procesandoCambioMasivo || !mismoCliente || totalSeleccionado === null;
    }

    const estadoActual = seleccionados[0]?.estado;
    const mismoEstado = seleccionados.every(
      (pedido) => pedido.estado === estadoActual,
    );
    const estadoSiguiente =
      mismoEstado && estadoActual
        ? estadosSiguientes[estadoActual]
        : undefined;
    const destinoMasivo =
      estadoSiguiente && estadoSiguiente !== "ENTREGADO"
        ? estadoSiguiente
        : null;

    if (mensajeSeleccion) {
      mensajeSeleccion.textContent = procesandoCambioMasivo
        ? progresoCambioMasivo
        : !mismoEstado
          ? "Selecciona pedidos que estén todos en el mismo estado."
          : estadoSiguiente === "ENTREGADO"
            ? "La entrega se gestiona desde cada pedido para registrar el pago."
            : destinoMasivo
              ? `Se aplicará la transición a ${estados[destinoMasivo].label}.`
              : "Estos pedidos no tienen un siguiente estado disponible.";
    }
    if (botonAvanzarSeleccion) {
      botonAvanzarSeleccion.textContent = procesandoCambioMasivo
        ? "Actualizando..."
        : destinoMasivo
          ? `Pasar a ${estados[destinoMasivo].label}`
          : "Avanzar";
      botonAvanzarSeleccion.disabled =
        procesandoCambioMasivo || !destinoMasivo || !mismoEstado;
    }
    if (botonLimpiarSeleccion) {
      botonLimpiarSeleccion.disabled = procesandoCambioMasivo;
    }
  }

  /*
   * Actualiza visualmente el botón de filtro activo.
   */
  function actualizarEstadoBotonesFiltro() {
    const botones =
      document.querySelectorAll<HTMLButtonElement>("[data-filtro]");
    const estilosActivos: Record<FiltroPedido, string[]> = {
      TODOS: ["bg-slate-900", "text-white", "shadow-sm", "hover:bg-slate-800"],
      REVISION: [
        "bg-amber-100",
        "text-amber-950",
        "ring-1",
        "ring-amber-200",
        "hover:bg-amber-200",
      ],
      IMPRIMIENDO: [
        "bg-cyan-100",
        "text-cyan-950",
        "ring-1",
        "ring-cyan-200",
        "hover:bg-cyan-200",
      ],
      LISTO: [
        "bg-emerald-100",
        "text-emerald-950",
        "ring-1",
        "ring-emerald-200",
        "hover:bg-emerald-200",
      ],
      ENTREGADO: [
        "bg-slate-700",
        "text-white",
        "shadow-sm",
        "hover:bg-slate-800",
      ],
    };
    const todasLasClasesActivas = Object.values(estilosActivos).flat();

    botones.forEach((boton) => {
      const filtro = boton.dataset.filtro;
      const activo = filtro === filtroActual;

      boton.classList.remove(
        ...todasLasClasesActivas,
        "bg-white/70",
        "text-slate-600",
        "hover:bg-white",
      );
      boton.classList.add(
        ...(activo && filtro && filtro in estilosActivos
          ? estilosActivos[filtro as FiltroPedido]
          : ["bg-white/70", "text-slate-600", "hover:bg-white"]),
      );
      boton.setAttribute("aria-pressed", String(activo));
    });
  }

  function actualizarEstadoBotonesServicio() {
    const botones = document.querySelectorAll<HTMLButtonElement>(
      "[data-servicio-filtro]",
    );
    const clasesActivas = [
      "bg-slate-900",
      "text-white",
      "shadow-sm",
      "hover:bg-slate-800",
    ];
    const clasesInactivas = [
      "bg-white/70",
      "text-slate-600",
      "hover:bg-white",
    ];

    botones.forEach((boton) => {
      const activo = boton.dataset.servicioFiltro === filtroServicioActual;
      boton.classList.remove(...clasesActivas, ...clasesInactivas);
      boton.classList.add(...(activo ? clasesActivas : clasesInactivas));
      boton.setAttribute("aria-pressed", String(activo));
    });
  }

  /*
   * Mensaje para cuando no existen
   * pedidos que mostrar.
   */
  function actualizarMensajeVacio() {
    if (!vacioTitulo || !vacioDescripcion) {
      return;
    }

    if (filtroServicioActual !== "TODOS") {
      const etiquetaServicio = {
        UV: "UV",
        TEXTIL_31: "Textil 31 cm",
        TEXTIL_58: "Textil 58 cm",
      }[filtroServicioActual];
      vacioTitulo.textContent = `No hay pedidos de ${etiquetaServicio}`;
      vacioDescripcion.textContent =
        "Prueba con otro servicio o ajusta los filtros seleccionados.";
      return;
    }

    if (nombreBuscado.trim()) {
      vacioTitulo.textContent = "No se encontraron pedidos";
      vacioDescripcion.textContent = `No hay pedidos de "${nombreBuscado.trim()}" con este filtro.`;
      return;
    }

    switch (filtroActual) {
      case "REVISION":
        vacioTitulo.textContent = "No hay pedidos por confirmar";

        vacioDescripcion.textContent =
          "Los pedidos pendientes de revisión aparecerán aquí.";
        break;

      case "IMPRIMIENDO":
        vacioTitulo.textContent = "No hay pedidos imprimiendo";

        vacioDescripcion.textContent =
          "Los pedidos enviados a impresión aparecerán aquí.";
        break;

      case "LISTO":
        vacioTitulo.textContent = "No hay pedidos listos";

        vacioDescripcion.textContent =
          "Los pedidos terminados aparecerán aquí.";
        break;

      case "ENTREGADO":
        vacioTitulo.textContent = "No hay pedidos entregados";

        vacioDescripcion.textContent =
          "Los pedidos entregados aparecerán aquí.";
        break;

      default:
        vacioTitulo.textContent = "No hay pedidos pendientes";
        vacioDescripcion.textContent =
          "Los pedidos por confirmar o en impresión aparecerán aquí.";
        break;
    }
  }

  /*
   * Render principal de la tabla.
   */
  function renderizarPedidos() {
    if (!body || !loading || !vacio || !error || !tabla) {
      return;
    }

    loading.classList.add("hidden");
    error.classList.add("hidden");

    const pedidos = obtenerPedidosFiltrados();

    actualizarEstadoBotonesFiltro();
    actualizarEstadoBotonesServicio();
    actualizarMensajeVacio();
    actualizarResumenSeleccion(pedidos);

    if (resultadosBusqueda) {
      const consultando = Boolean(nombreBuscado.trim());
      resultadosBusqueda.classList.toggle("hidden", !consultando);
      resultadosBusqueda.textContent = `${pedidos.length} ${pedidos.length === 1 ? "pedido encontrado" : "pedidos encontrados"}`;
    }

    if (pedidos.length === 0) {
      tabla.classList.add("hidden");
      vacio.classList.remove("hidden");

      return;
    }

    vacio.classList.add("hidden");
    tabla.classList.remove("hidden");

    body.innerHTML = "";

    pedidos.forEach((pedido) => {
      body.insertAdjacentHTML("beforeend", crearFilaPedido(pedido));
      const fila = body.lastElementChild as HTMLTableRowElement | null;

      if (!fila) {
        return;
      }

      const checkboxSeleccion = fila.querySelector<HTMLInputElement>(
        "[data-pedido-seleccion]",
      );
      if (checkboxSeleccion) {
        checkboxSeleccion.checked = pedidosSeleccionados.has(pedido.id);
        checkboxSeleccion.disabled = procesandoCambioMasivo;
        if (pedido.estado === "LISTO") {
          checkboxSeleccion.title =
            "La entrega debe gestionarse desde el detalle para registrar el pago.";
        }
        checkboxSeleccion.addEventListener("change", () => {
          if (checkboxSeleccion.checked) {
            pedidosSeleccionados.add(pedido.id);
          } else {
            pedidosSeleccionados.delete(pedido.id);
          }
          actualizarResumenSeleccion(pedidos);
        });
      }

      /*
       * Abrir detalle del pedido.
       */
      const abrirDetalle = () => {
        const id = Number(fila.dataset.pedidoRowId);

        if (!Number.isFinite(id)) {
          return;
        }

        document.dispatchEvent(
          new CustomEvent("centro-control:abrir-pedido", {
            detail: { id },
          }),
        );
      };

      fila.addEventListener("click", (evento) => {
        const target = evento.target;

        if (
          target instanceof Element &&
          target.closest("button, a, input, select, textarea")
        ) {
          return;
        }

        abrirDetalle();
      });

      fila.addEventListener("keydown", (evento) => {
        if (
          evento.target !== fila ||
          (evento.key !== "Enter" && evento.key !== " ")
        ) {
          return;
        }

        evento.preventDefault();
        abrirDetalle();
      });

      const botonDetalle =
        fila.querySelector<HTMLButtonElement>("[data-pedido-id]");

      botonDetalle?.addEventListener("click", () => {
        abrirDetalle();
      });

      fila
        .querySelector<HTMLButtonElement>("[data-referencia-preview]")
        ?.addEventListener("click", (event) => {
          event.stopPropagation();
          const pedidoId = Number(
            (event.currentTarget as HTMLButtonElement).dataset.referenciaPreview,
          );
          if (Number.isSafeInteger(pedidoId) && pedidoId > 0) {
            void abrirPreviewReferencia(pedidoId);
          }
        });
    });
  }

  if (checkboxSeleccionarVisibles) {
    checkboxSeleccionarVisibles.addEventListener("change", () => {
      const pedidosVisibles = obtenerPedidosFiltrados();
      for (const pedido of pedidosVisibles) {
        if (checkboxSeleccionarVisibles.checked) {
          pedidosSeleccionados.add(pedido.id);
        } else {
          pedidosSeleccionados.delete(pedido.id);
        }
      }
      renderizarPedidos();
    });
  }

  botonLimpiarSeleccion?.addEventListener("click", () => {
    pedidosSeleccionados.clear();
    renderizarPedidos();
  });

  botonVerTotal?.addEventListener("click", () => {
    if (!procesandoCambioMasivo) abrirModalTotalPedidos();
  });

  modalTotalCerrar?.addEventListener("click", cerrarModalTotalPedidos);
  modalTotalCerrarSecundario?.addEventListener(
    "click",
    cerrarModalTotalPedidos,
  );
  modalTotalPedidos?.addEventListener("click", (event) => {
    if (event.target === modalTotalPedidos) cerrarModalTotalPedidos();
  });
  document.addEventListener("keydown", (event) => {
    if (modalTotalPedidos?.getAttribute("aria-hidden") !== "false") return;
    if (event.key === "Escape") {
      cerrarModalTotalPedidos();
      return;
    }

    if (event.key === "Tab") {
      const elementosEnfocables =
        modalTotalPedidos.querySelectorAll<HTMLElement>(
          'button:not([disabled]), [href], input:not([disabled]), [tabindex]:not([tabindex="-1"])',
        );
      const primero = elementosEnfocables[0];
      const ultimo = elementosEnfocables[elementosEnfocables.length - 1];
      if (!primero || !ultimo) return;

      if (
        event.shiftKey &&
        (document.activeElement === primero ||
          !modalTotalPedidos.contains(document.activeElement))
      ) {
        event.preventDefault();
        ultimo.focus();
      } else if (!event.shiftKey && document.activeElement === ultimo) {
        event.preventDefault();
        primero.focus();
      }
    }
  });

  modalTotalCopiar?.addEventListener("click", () => {
    if (!modalTotalCopiar) return;
    const mensaje = generarMensajePedidosSeleccionados(pedidosResumenModal);
    if (!mensaje) {
      if (modalTotalEstado) {
        modalTotalEstado.textContent =
          "Selecciona pedidos de un solo cliente con precios confirmados.";
      }
      return;
    }

    void copiarTexto(
      modalTotalCopiar,
      mensaje,
      "el detalle de pedidos",
      "Detalle copiado",
      "Copiar para WhatsApp",
    );
  });

  modalTotalPdf?.addEventListener("click", async () => {
    if (!modalTotalPdf) return;
    const seleccionados = pedidosResumenModal;
    const mensaje = generarMensajePedidosSeleccionados(seleccionados);
    if (!mensaje) {
      if (modalTotalEstado) {
        modalTotalEstado.textContent =
          "No se puede generar el comprobante: revisa el cliente y los precios.";
      }
      return;
    }

    const idempotencyKey = idempotencyKeyNotaVenta;
    if (!idempotencyKey) {
      if (modalTotalEstado) {
        modalTotalEstado.textContent =
          "Cierra y vuelve a abrir el detalle para generar la nota de venta.";
      }
      return;
    }

    const textoOriginal = modalTotalPdf.textContent;
    modalTotalPdf.disabled = true;
    modalTotalPdf.textContent = "Generando PDF...";
    if (modalTotalEstado) {
      modalTotalEstado.textContent = "Asignando el número de nota de venta...";
    }

    try {
      const nota = await emitirNotaVenta(
        seleccionados.map((pedido) => pedido.id),
        idempotencyKey,
      );
      actualizarDetalleModalNota(
        nota.cliente.nombre,
        nota.pedidos,
        nota.total,
      );
      await descargarNotaVentaPdf(nota);
      if (modalTotalEstado) {
        modalTotalEstado.textContent = `Nota de venta ${nota.numero} descargada.`;
      }
    } catch (error) {
      console.error("No se pudo generar el comprobante de pedidos:", error);
      if (modalTotalEstado) {
        modalTotalEstado.textContent =
          "No se pudo generar el comprobante PDF.";
      }
      mostrarNotificacion(
        error instanceof Error
          ? `No se pudo generar el comprobante PDF: ${error.message}`
          : "No se pudo generar el comprobante PDF.",
        "error",
      );
    } finally {
      modalTotalPdf.disabled = false;
      modalTotalPdf.textContent = textoOriginal;
    }
  });

  async function avanzarPedidosSeleccionados() {
    if (procesandoCambioMasivo) return;

    const seleccionados = obtenerPedidosFiltrados().filter((pedido) =>
      pedidosSeleccionados.has(pedido.id),
    );
    const estadoActual = seleccionados[0]?.estado;
    const mismoEstado = seleccionados.every(
      (pedido) => pedido.estado === estadoActual,
    );
    const estadoSiguiente =
      mismoEstado && estadoActual
        ? estadosSiguientes[estadoActual]
        : undefined;
    if (
      seleccionados.length === 0 ||
      !estadoSiguiente ||
      estadoSiguiente === "ENTREGADO"
    ) {
      actualizarResumenSeleccion(obtenerPedidosFiltrados());
      return;
    }

    procesandoCambioMasivo = true;
    const total = seleccionados.length;
    let actualizados = 0;
    let fallidos = 0;
    progresoCambioMasivo = `Actualizando 0 de ${total}...`;
    renderizarPedidos();

    try {
      for (const [indice, pedido] of seleccionados.entries()) {
        progresoCambioMasivo = `Actualizando ${indice + 1} de ${total}...`;
        actualizarResumenSeleccion(obtenerPedidosFiltrados());

        const pedidoActual = pedidosActuales.find(
          (actual) => actual.id === pedido.id,
        );
        if (!pedidoActual || pedidoActual.estado !== estadoActual) {
          pedidosSeleccionados.delete(pedido.id);
          fallidos += 1;
          console.error(
            `No se actualizó el pedido #${pedido.id}: su estado cambió antes de aplicar la acción masiva.`,
          );
          continue;
        }

        try {
          const pedidoActualizado = await cambiarEstadoPedido(
            pedido.id,
            estadoSiguiente,
          );
          pedidosActuales = pedidosActuales.map((actual) =>
            actual.id === pedidoActualizado.id ? pedidoActualizado : actual,
          );
          pedidosSeleccionados.delete(pedido.id);
          actualizados += 1;
          renderizarPedidos();
        } catch (errorApi) {
          fallidos += 1;
          console.error(
            `No se pudo actualizar el estado del pedido #${pedido.id}:`,
            errorApi,
          );
        }
      }
    } finally {
      procesandoCambioMasivo = false;
      progresoCambioMasivo = "";
      renderizarPedidos();
    }

    if (fallidos > 0) {
      const resumenActualizados = `${actualizados} ${
        actualizados === 1 ? "pedido se actualizó" : "pedidos se actualizaron"
      }`;
      const resumenFallidos = `${fallidos} ${
        fallidos === 1
          ? "pedido no se pudo actualizar"
          : "pedidos no se pudieron actualizar"
      }`;
      mostrarNotificacion(
        `${resumenActualizados} y ${resumenFallidos}. Revisa los seleccionados e inténtalo de nuevo.`,
        "error",
      );
    } else if (actualizados > 0) {
      mostrarNotificacion(
        `${actualizados} ${
          actualizados === 1 ? "pedido actualizado" : "pedidos actualizados"
        } a ${estados[estadoSiguiente].label}.`,
      );
    }
  }

  botonAvanzarSeleccion?.addEventListener("click", () => {
    void avanzarPedidosSeleccionados();
  });

  buscadorCliente?.addEventListener("input", () => {
    pedidosSeleccionados.clear();
    nombreBuscado = buscadorCliente.value;
    renderizarPedidos();
  });

  /*
   * Eventos de filtros.
   */
  document
    .querySelectorAll<HTMLButtonElement>("[data-filtro]")
    .forEach((boton) => {
      boton.addEventListener("click", () => {
        const filtro = boton.dataset.filtro as FiltroPedido;

        if (!filtro) {
          return;
        }

        pedidosSeleccionados.clear();
        filtroActual = filtro;

        renderizarPedidos();
      });
    });

  document
    .querySelectorAll<HTMLButtonElement>("[data-servicio-filtro]")
    .forEach((boton) => {
      boton.addEventListener("click", () => {
        const filtro = boton.dataset
          .servicioFiltro as FiltroServicioPedido | undefined;

        if (!filtro) {
          return;
        }

        pedidosSeleccionados.clear();
        filtroServicioActual = filtro;
        renderizarPedidos();
      });
    });

  /*
   * Copiar teléfono.
   *
   * Se utiliza delegación de eventos porque
   * las filas son creadas dinámicamente.
   */
  document.addEventListener("click", async (event) => {
    const target = event.target as HTMLElement;

    const botonEtiqueta =
      target.closest<HTMLButtonElement>("button[data-etiqueta]");

    if (botonEtiqueta) {
      event.stopPropagation();
      const etiqueta = botonEtiqueta.dataset.etiqueta
        ? decodeURIComponent(botonEtiqueta.dataset.etiqueta)
        : "";
      if (etiqueta) {
        await copiarTexto(
          botonEtiqueta,
          etiqueta,
          "la etiqueta de impresión",
          "Etiqueta copiada",
          "Copiar etiqueta de impresión",
        );
      }
      return;
    }

    const boton = target.closest<HTMLButtonElement>("button[data-telefono]");

    if (!boton) {
      return;
    }

    event.stopPropagation();

    const telefono = boton.dataset.telefono;

    if (!telefono) {
      return;
    }

    await copiarTelefono(boton, telefono);
  });

  /*
   * Suscripción al store.
   */
  suscribirsePedidos((pedidos) => {
    pedidosActuales = pedidos;

    renderizarPedidos();
  });

  /*
   * Inicializar store.
   */
  iniciarPedidosStore().catch((errorApi) => {
    console.error("No se pudo iniciar el store:", errorApi);

    loading?.classList.add("hidden");
    error?.classList.remove("hidden");
  });

  /*
   * Nuevo pedido.
   */
  const btnNuevoPedido = document.getElementById("btn-nuevo-pedido");
  const usuarioActual = obtenerUsuario();
  const esEmpleado = usuarioActual?.rol === "EMPLEADO";

  if (esEmpleado) {
    btnNuevoPedido?.classList.add("hidden");
  }

  btnNuevoPedido?.addEventListener("click", () => {
    if (esEmpleado) return;
    document.dispatchEvent(new CustomEvent("centro-control:nuevo-pedido"));
  });
</script>
