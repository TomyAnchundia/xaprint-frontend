    async function quitarPrecioEspecial() {
      if (!pedidoActual || procesandoPrecioEspecial) {
        return;
      }

      procesandoPrecioEspecial = true;

      if (modalQuitarPrecioEspecialConfirmar) {
        modalQuitarPrecioEspecialConfirmar.disabled = true;
        modalQuitarPrecioEspecialConfirmar.textContent = "Quitando...";
      }

      try {
        const pedidoActualizado = await cambiarPrecioEspecial(
          pedidoActual.id,
          null,
        );

        renderizarPedido(pedidoActualizado);
        ocultarModalQuitarPrecioEspecial();
        mostrarNotificacion("El precio especial fue eliminado.");
      } catch (errorApi) {
        console.error("No se pudo quitar el precio especial:", errorApi);

        ocultarModalQuitarPrecioEspecial();

        if (precioEspecialError) {
          precioEspecialError.textContent =
            errorApi instanceof Error
              ? errorApi.message
              : "No se pudo quitar el precio especial.";

          precioEspecialError.classList.remove("hidden");

          setTimeout(() => {
            precioEspecialError.classList.add("hidden");
          }, 4000);
        }
        mostrarNotificacion(
          errorApi instanceof Error
            ? errorApi.message
            : "No se pudo quitar el precio especial.",
          "error",
        );
      } finally {
        procesandoPrecioEspecial = false;

        if (modalQuitarPrecioEspecialConfirmar) {
          modalQuitarPrecioEspecialConfirmar.disabled = false;
          modalQuitarPrecioEspecialConfirmar.textContent = "Quitar precio";
