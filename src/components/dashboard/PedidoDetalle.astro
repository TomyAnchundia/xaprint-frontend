    function mostrarModalPago(modo: "registrar" | "revertir") {
      if (!pedidoActual || !modalPago) return;
      modoModalPago = modo;
      const esReversion = modo === "revertir";

      if (modalPagoTitulo) {
        modalPagoTitulo.textContent = esReversion
          ? "Revertir último pago"
          : "¿El pedido fue pagado?";
      }
      if (modalPagoTexto) {
        modalPagoTexto.textContent = esReversion
          ? "Esto eliminará el último pago individual registrado para este pedido y recalculará su saldo. Si el pago fue compartido con otros pedidos, el sistema no permitirá revertirlo desde aquí."
          : "Confirma únicamente si recibiste el pago del cliente. Se registrará solo el saldo pendiente, descontando abonos anteriores. Si todavía no ha pagado, déjalo pendiente y podrás registrar el cobro después.";
      }
      if (modalPagoMonto) {
        modalPagoMonto.textContent = `Total del pedido: ${formatearPrecio(pedidoActual.valorCobrar)}`;
      }
      if (modalPagoCancelar) {
        modalPagoCancelar.textContent = esReversion
          ? "Cancelar"
          : "Dejar pendiente";
      }
      if (modalPagoConfirmar) {
        modalPagoConfirmar.textContent = esReversion
          ? "Sí, revertir pago"
          : "Sí, recibí el pago";
        modalPagoConfirmar.className = esReversion
          ? "h-9 rounded-lg bg-red-700 px-4 text-xs font-semibold text-white hover:bg-red-800 disabled:cursor-not-allowed disabled:opacity-50"
          : "h-9 rounded-lg bg-emerald-700 px-4 text-xs font-semibold text-white hover:bg-emerald-800 disabled:cursor-not-allowed disabled:opacity-50";
      }
      modalPagoError?.classList.add("hidden");
      mostrarModalElement(modalPago);
    }

    function ocultarModalPago() {
      ocultarModalElement(modalPago);
      if (
        modalCancelar?.classList.contains("hidden") &&
        modalPrecioEspecial?.classList.contains("hidden") &&
        modalCostoDiseno?.classList.contains("hidden") &&
        modalQuitarPrecioEspecial?.classList.contains("hidden") &&
        overlay?.classList.contains("invisible")
      ) {
        document.body.classList.remove("overflow-hidden");
      }
    }

    async function confirmarAccionPago() {
      if (!pedidoActual || procesandoPago || !modalPagoConfirmar) return;
      procesandoPago = true;
      modalPagoConfirmar.disabled = true;
      modalPagoError?.classList.add("hidden");

      try {
        if (modoModalPago === "registrar") {
          modalPagoConfirmar.textContent = "Registrando...";
          await registrarPagoPedido(pedidoActual.id);
        } else {
          modalPagoConfirmar.textContent = "Revirtiendo...";
          await revertirUltimoPagoPedido(pedidoActual.id);
        }

        const pedidoActualizado = await obtenerPedido(pedidoActual.id);
        renderizarPedido(pedidoActualizado);
        const registros = await obtenerHistorialPedido(pedidoActualizado.id);
        renderizarHistorial(registros);
        ocultarModalPago();
        mostrarNotificacion(
          modoModalPago === "revertir"
            ? "Último pago revertido."
            : "Pago registrado correctamente.",
        );
      } catch (errorApi) {
        console.error("No se pudo actualizar el pago del pedido:", errorApi);
        if (modalPagoError) {
          modalPagoError.textContent =
            errorApi instanceof Error
              ? errorApi.message
              : "No se pudo actualizar el estado de pago.";
          modalPagoError.classList.remove("hidden");
        }
        mostrarNotificacion(
          errorApi instanceof Error
            ? errorApi.message
            : "No se pudo actualizar el estado de pago.",
          "error",
        );
      } finally {
        procesandoPago = false;
        modalPagoConfirmar.disabled = false;
        modalPagoConfirmar.textContent =
          modoModalPago === "revertir"
            ? "Sí, revertir pago"
            : "Sí, recibí el pago";
      }
    }

