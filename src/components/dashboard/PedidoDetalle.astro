      if (modalPrecioEspecialActual) {
        modalPrecioEspecialActual.textContent = tienePrecioEspecial
          ? `Actual: ${formatearPrecio(pedidoActual.precioEspecial)}`
          : `Actual: ${formatearPrecio(pedidoActual.valorCobrar)}`;
      }

      if (modalPrecioEspecialInput) {
        modalPrecioEspecialInput.value =
          pedidoActual.precioEspecial !== null
            ? pedidoActual.precioEspecial.toFixed(2)
            : "";

        modalPrecioEspecialInput.disabled = false;
      }

      modalPrecioEspecialError?.classList.add("hidden");
      mostrarModalElement(modalPrecioEspecial);

      setTimeout(() => {
        modalPrecioEspecialInput?.focus();
        modalPrecioEspecialInput?.select();
      }, 50);
