---
import PedidoDetalleModales from "./PedidoDetalleModales.astro";
---

<div
  id="pedido-detalle-overlay"
  class="pointer-events-none invisible fixed inset-0 z-50"
>
  <!-- Fondo -->
  <div
    id="pedido-detalle-backdrop"
    class="absolute inset-0 bg-slate-900/30 opacity-0 transition-opacity duration-200"
  >
  </div>

  <!-- Panel -->
  <aside
    id="pedido-detalle-panel"
    class="absolute right-0 top-0 flex h-full w-full max-w-xl translate-x-full flex-col bg-slate-50 shadow-2xl transition-transform duration-200"
  >
    <!-- Header -->
    <div class="shrink-0 border-b border-slate-200 bg-slate-100 px-5 py-3">
      <div class="flex items-start justify-between gap-3">
        <div class="min-w-0 flex-1">
          <p
            class="text-[10px] font-medium uppercase tracking-wide text-slate-400"
          >
            Detalle del pedido
          </p>

          <h2
            id="detalle-titulo"
            class="mt-0.5 text-base font-bold text-slate-900"
          >
            Pedido
          </h2>

          <div class="mt-1.5 rounded-lg bg-white/80 px-2.5 py-1.5">
            <p class="text-[10px] font-medium uppercase text-slate-400">
              Cliente
            </p>
            <div class="mt-0.5 flex flex-wrap items-center gap-x-2">
              <p
                id="detalle-cliente-header"
                class="min-w-0 text-2xl font-semibold text-slate-700"
              >
                —
              </p>
              <p
                id="detalle-telefono-header"
                class="text-[11px] text-slate-500"
              >
                —
              </p>
            </div>
          </div>
        </div>

        <div class="flex shrink-0 items-center gap-2">
          <button
            id="detalle-eliminar"
            type="button"
            class="hidden h-9 items-center gap-2 rounded-lg border border-red-200 bg-red-50 px-3 text-xs font-semibold text-red-700 transition hover:bg-red-100 focus:outline-none focus:ring-2 focus:ring-red-200"
          >
            Eliminar
          </button>

          <!-- Editar -->
          <button
            id="detalle-editar"
            type="button"
            class="inline-flex h-9 items-center gap-2 rounded-lg border border-slate-200 bg-cyan-950 px-3 text-xs font-medium text-white transition hover:bg-cyan-900 hover:text-blue-100 focus:outline-none focus:ring-2 focus:ring-slate-300"
          >
            <svg
              class="h-3.5 w-3.5"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 20h9"
              ></path>
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M16.5 3.5a2.121 2.121 0 013 3L8 18l-4 1 1-4L16.5 3.5z"
              ></path>
            </svg>
            Editar
          </button>

          <!-- Cerrar -->
          <button
            id="detalle-cerrar"
            type="button"
            class="rounded-lg p-2 text-slate-400 transition hover:bg-slate-100 hover:text-slate-700"
            aria-label="Cerrar detalle"
          >
            <svg
              class="h-5 w-5"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M6 18L18 6M6 6l12 12"></path>
            </svg>
          </button>
        </div>
      </div>

      <div
        id="detalle-impresion-header"
        class="hidden mt-2 rounded-lg border border-cyan-100 bg-cyan-50 px-2.5 py-2"
      >
        <div class="grid grid-cols-3 gap-2 text-[11px] leading-4">
          <div class="min-w-0">
            <p class="text-slate-500">Servicio</p>
            <p
              id="detalle-servicio"
              class="truncate text-xs font-semibold text-slate-800"
            >
              —
            </p>
          </div>
          <div class="min-w-0">
            <p class="text-slate-500">Medidas</p>
            <p
              id="detalle-medidas"
              class="truncate text-xs font-semibold text-slate-800"
            >
              —
            </p>
          </div>
          <div class="min-w-0">
            <p class="text-slate-500">Ajustes</p>
            <div class="flex flex-wrap gap-x-2 text-[11px] text-slate-700">
              <span
                >Contr. <strong
                  id="detalle-contraer"
                  class="text-xs font-semibold text-slate-800">—</strong
                ></span
              >
              <span
                >Vel. <strong
                  id="detalle-velocidad"
                  class="text-xs font-semibold text-slate-800">—</strong
                ></span
              >
              <span
                >Obst. <strong
                  id="detalle-obstruccion"
                  class="text-xs font-semibold text-slate-800">—</strong
                ></span
              >
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Contenido -->
    <div class="min-h-0 flex-1 overflow-y-auto">
      <!-- Loading -->
      <div
        id="detalle-loading"
        class="flex items-center justify-center px-5 py-20"
      >
        <div class="flex items-center gap-3 text-sm text-slate-400">
          <span
            class="h-5 w-5 animate-spin rounded-full border-2 border-slate-200 border-t-slate-700"
          ></span>
          Cargando pedido...
        </div>

        <div
          class="mt-3 flex items-center justify-between gap-3 border-t border-slate-100 pt-3"
        >
          <div>
            <p class="text-xs font-medium text-slate-500">Estado de pago</p>
            <span
              id="detalle-estado-pago"
              class="mt-1 inline-flex rounded-full bg-amber-50 px-2.5 py-1 text-xs font-semibold text-amber-900"
              >No pagado</span
            >
          </div>
          <button
            id="detalle-pago-accion"
            type="button"
            class="hidden h-8 rounded-lg border border-slate-200 bg-white px-3 text-xs font-semibold text-slate-700 transition hover:bg-slate-50"
            >Registrar pago</button
          >
        </div>
      </div>

      <!-- Error -->
      <div id="detalle-error" class="hidden px-5 py-20 text-center">
        <p class="font-medium text-red-600">No se pudo cargar el pedido</p>
        <p id="detalle-error-mensaje" class="mt-1 text-sm text-slate-400">
          Comprueba que el backend esté disponible.
        </p>
      </div>

      <!-- Información -->
      <div id="detalle-contenido" class="hidden">
        <!-- Estado -->
        <section class="border-b border-slate-200 px-5 py-4">
          <div class="flex flex-wrap items-center gap-2.5">
            <p
              class="text-xs font-medium uppercase tracking-wide text-slate-400"
            >
              Estado actual
            </p>

            <span
              id="detalle-estado"
              class="inline-flex rounded-full px-3 py-1.5 text-sm font-medium"
            ></span>

            <span
              id="detalle-prioridad"
              class="hidden rounded-full bg-orange-50 px-2.5 py-1 text-xs font-medium text-orange-700"
            >
              Prioridad
            </span>
          </div>

          <!-- Acciones de estado -->
          <div class="mt-5 rounded-xl border border-slate-200 bg-white p-4">
            <div class="flex flex-col gap-3">
              <div>
                <p class="text-sm font-semibold text-slate-800">
                  Acciones de estado
                </p>

                <p
                  id="detalle-acciones-descripcion"
                  class="mt-1 text-xs leading-5 text-slate-400"
                >
                  Selecciona una acción.
                </p>
              </div>

              <div class="flex flex-wrap items-center justify-between gap-2">
                <!-- Retroceder -->
                <button
                  id="detalle-retroceder"
                  type="button"
                  class="hidden h-10 flex-1 min-w-35 items-center justify-center rounded-xl border border-slate-200 bg-slate-100 px-3 text-xs font-semibold text-slate-700 shadow-sm transition hover:border-slate-300 hover:bg-slate-200 focus:outline-none focus:ring-2 focus:ring-slate-300 disabled:cursor-not-allowed disabled:opacity-50"
                >
                  <span class="flex items-center justify-center gap-1.5">
                    <svg
                      class="h-3.5 w-3.5 shrink-0"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M15 18l-6-6 6-6"></path>
                    </svg>

                    <span id="detalle-retroceder-texto">Retroceder</span>
                  </span>
                </button>

                <!-- Avanzar -->
                <button
                  id="detalle-avanzar"
                  type="button"
                  class="hidden h-10 flex-1 min-w-35 items-center justify-center rounded-xl bg-slate-900 px-3 text-xs font-semibold text-white shadow-sm transition hover:bg-slate-800 focus:outline-none focus:ring-2 focus:ring-slate-400 disabled:cursor-not-allowed disabled:opacity-50"
                >
                  <span class="flex items-center justify-center gap-1.5">
                    <span id="detalle-avanzar-texto">Avanzar</span>

                    <svg
                      class="h-3.5 w-3.5 shrink-0"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M9 18l6-6-6-6"></path>
                    </svg>
                  </span>
                </button>
              </div>

              <!-- Cancelar -->
              <div
                id="detalle-cancelar-contenedor"
                class="hidden border-t border-slate-200 pt-2"
              >
                <button
                  id="detalle-cancelar"
                  type="button"
                  class="w-full h-9 items-center justify-center gap-1.5 rounded-xl border border-red-200 bg-red-50 px-3 text-xs font-semibold text-red-600 shadow-sm transition hover:bg-red-100 hover:text-red-700 focus:outline-none focus:ring-2 focus:ring-red-200 disabled:cursor-not-allowed disabled:opacity-50"
                >
                  <span class="flex items-center justify-center gap-1.5">
                    <svg
                      class="h-3.5 w-3.5 shrink-0"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.8"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M6 6l12 12M18 6L6 18"></path>
                    </svg>

                    <span>Cancelar pedido</span>
                  </span>
                </button>
              </div>

              <p
                id="detalle-acciones-error"
                class="hidden text-xs font-medium text-red-600"
              >
              </p>
            </div>
          </div>
        </section>

        <!-- Precio -->
        <section class="border-b border-slate-200 px-5 py-5">
          <div class="flex items-center justify-between">
            <h3 class="text-sm font-semibold text-slate-900">Precio</h3>
          </div>

          <div class="mt-4 rounded-xl border border-slate-200 bg-white p-4">
            <div class="space-y-2.5 text-sm">
              <div
                class="flex items-center justify-between gap-3 text-slate-500"
              >
                <span>Calculado</span>

                <span
                  id="detalle-precio-calculado"
                  class="font-medium text-slate-700"
                >
                  —
                </span>
              </div>

              <div
                class="flex items-center justify-between gap-3 text-slate-500"
              >
                <span>Costo de diseño</span>

                <div class="flex items-center gap-2">
                  <span
                    id="detalle-costo-diseno"
                    class="font-medium text-slate-700"
                  >
                    —
                  </span>
                  <button
                    id="detalle-costo-diseno-editar"
                    type="button"
                    class="rounded-md border border-slate-200 bg-white px-2 py-1 text-[11px] font-semibold text-slate-600 transition hover:border-cyan-300 hover:text-cyan-800 focus:outline-none focus:ring-2 focus:ring-cyan-200"
                    >Establecer</button
                  >
                </div>
              </div>

              <div
                class="flex items-center justify-between gap-3 text-slate-500"
              >
                <span>Aporte desarrollador</span>

                <span
                  id="detalle-aporte-desarrollador"
                  class="font-medium text-slate-700"
                >
                  —
                </span>
              </div>
            </div>

            <div class="mt-4 border-t border-slate-200 pt-3">
              <div class="flex items-center justify-between gap-3">
                <span class="text-sm font-semibold text-slate-700">
                  Valor a cobrar
                </span>
                <span
                  id="detalle-valor-cobrar"
                  class="text-xl font-bold text-slate-900">—</span
                >
              </div>
            </div>

            <!-- Precio especial -->
            <div id="detalle-precio-especial-contenedor" class="mt-3 hidden">
              <div class="flex items-center justify-between gap-3">
                <span class="text-sm text-violet-500">Precio especial</span>

                <span
                  id="detalle-precio-especial"
                  class="text-sm font-semibold text-violet-700"
                >
                  —
                </span>
              </div>

              <!-- Información del precio especial -->
              <div
                id="detalle-precio-especial-info"
                class="mt-2 text-right text-xs text-slate-400"
              >
              </div>

              <!-- Acciones precio especial -->
              <div class="mt-3 flex justify-end gap-2">
                <button
                  id="detalle-precio-especial-editar"
                  type="button"
                  class="inline-flex h-8 items-center gap-1.5 rounded-lg border border-violet-200 bg-violet-50 px-3 text-xs font-semibold text-violet-700 transition hover:bg-violet-100 hover:text-violet-800 focus:outline-none focus:ring-2 focus:ring-violet-200"
                >
                  <svg
                    class="h-3.5 w-3.5"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M12 20h9"></path>

                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M16.5 3.5a2.121 2.121 0 013 3L8 18l-4 1 1-4L16.5 3.5z"
                    ></path>
                  </svg>

                  Editar
                </button>

                <button
                  id="detalle-precio-especial-quitar"
                  type="button"
                  class="inline-flex h-8 items-center gap-1.5 rounded-lg border border-red-200 bg-red-50 px-3 text-xs font-semibold text-red-600 transition hover:bg-red-100 hover:text-red-700 focus:outline-none focus:ring-2 focus:ring-red-200"
                >
                  <svg
                    class="h-3.5 w-3.5"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M6 6l12 12M18 6L6 18"></path>
                  </svg>

                  Quitar
                </button>
              </div>
            </div>

            <!-- Establecer precio especial -->
            <div id="detalle-precio-especial-establecer" class="mt-3">
              <button
                id="detalle-precio-especial-nuevo"
                type="button"
                class="inline-flex h-9 w-full items-center justify-center gap-2 rounded-xl border border-violet-200 bg-violet-100 px-3 text-xs font-semibold text-violet-800 shadow-sm transition hover:-translate-y-0.5 hover:border-violet-300 hover:bg-violet-200 focus:outline-none focus:ring-2 focus:ring-violet-300"
              >
                <svg
                  class="h-4 w-4"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M12 5v14M5 12h14"></path>
                </svg>

                Establecer precio especial
              </button>
            </div>
          </div>

          <!-- Error precio especial -->
          <p
            id="detalle-precio-especial-error"
            class="mt-2 hidden text-xs font-medium text-red-600"
          >
          </p>
        </section>

        <!-- Mensajes para WhatsApp -->
        <section class="border-b border-slate-200 px-5 py-5">
          <div>
            <h3 class="text-sm font-semibold text-slate-900">
              Mensajes para WhatsApp
            </h3>
            <p class="mt-1 text-xs leading-5 text-slate-400">
              Copia un mensaje preparado para enviarlo al cliente.
            </p>
          </div>

          <div class="mt-3 grid gap-2 sm:grid-cols-2">
            <!-- Impresión lista -->
            <button
              id="detalle-whatsapp-listo"
              type="button"
              class="inline-flex min-h-9 items-center justify-center gap-1.5 rounded-lg border border-emerald-200 bg-emerald-100 px-2.5 py-2 text-[11px] font-semibold text-emerald-800 shadow-sm transition hover:border-emerald-300 hover:bg-emerald-200 hover:shadow focus:outline-none focus:ring-2 focus:ring-emerald-300 disabled:cursor-not-allowed disabled:opacity-50"
            >
              <svg
                class="h-3.5 w-3.5 shrink-0"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M9 12l2 2 4-4"></path>
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>

              <span id="detalle-whatsapp-listo-texto">
                Copiar aviso de impresión lista
              </span>
            </button>

            <!-- Detalle del precio -->
            <button
              id="detalle-whatsapp-precio"
              type="button"
              class="inline-flex min-h-9 items-center justify-center gap-1.5 rounded-lg border border-violet-200 bg-violet-100 px-2.5 py-2 text-[11px] font-semibold text-violet-800 shadow-sm transition hover:border-violet-300 hover:bg-violet-200 hover:shadow focus:outline-none focus:ring-2 focus:ring-violet-300 disabled:cursor-not-allowed disabled:opacity-50"
            >
              <svg
                class="h-3.5 w-3.5 shrink-0"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M12 1v22"></path>
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M17 5H9.5a3.5 3.5 0 000 7h5a3.5 3.5 0 010 7H6"></path>
              </svg>

              <span id="detalle-whatsapp-precio-texto">
                Copiar detalle del precio
              </span>
            </button>
          </div>

          <p
            id="detalle-whatsapp-mensaje"
            class="mt-2 hidden text-xs font-medium text-emerald-600"
          >
          </p>
        </section>

        <!-- Observaciones -->
        <section
          id="detalle-observaciones-seccion"
          class="hidden border-b border-slate-200 px-5 py-5"
        >
          <h3 class="text-sm font-semibold text-slate-900">Observaciones</h3>

          <p
            id="detalle-observaciones"
            class="mt-3 whitespace-pre-wrap text-sm leading-6 text-slate-600"
          >
          </p>
        </section>

        <!-- Fechas -->
        <section class="border-b border-slate-200 px-5 py-5">
          <h3 class="text-sm font-semibold text-slate-900">Fechas</h3>

          <div class="mt-4 grid gap-4 sm:grid-cols-2">
            <div>
              <p class="text-xs text-slate-400">Creado</p>

              <p id="detalle-creado" class="mt-1 text-sm text-slate-600">—</p>
            </div>

            <div>
              <p class="text-xs text-slate-400">Última actualización</p>

              <p id="detalle-actualizado" class="mt-1 text-sm text-slate-600">
                —
              </p>
            </div>

            <div>
              <p class="text-xs text-slate-400">Fecha de entrega</p>

              <p id="detalle-entrega" class="mt-1 text-sm text-slate-600">—</p>
            </div>
          </div>
        </section>

        <!-- Historial -->
        <section class="px-5 py-5">
          <div class="flex items-center justify-between">
            <h3 class="text-sm font-semibold text-slate-900">
              Historial de estados
            </h3>

            <span
              id="detalle-historial-cantidad"
              class="text-xs text-slate-400"
            >
              0 cambios
            </span>
          </div>

          <div id="detalle-historial" class="mt-4"></div>
        </section>
      </div>
    </div>
  </aside>

  <PedidoDetalleModales />

  <script>
    import {
      actualizarPedido,
      cambiarEstadoPedido,
      cambiarPrecioEspecial,
      eliminarPedido,
      obtenerHistorialPedido,
      obtenerPedido,
      registrarPagoPedido,
      revertirUltimoPagoPedido,
    } from "../../services/api";

    import { suscribirsePedidos } from "../../services/pedidos-store";
    import { obtenerUsuario } from "../../services/auth";
    import { mostrarNotificacion } from "../../utils/notificaciones";
    import { formatearFecha } from "../../utils/fecha";
    import {
      copiarMensaje,
      mostrarModalElement,
      ocultarModalElement,
      ocultarOverlayElement,
      renderizarHistorialElement,
      mostrarOverlayElement,
    } from "../../utils/pedido-detalle-ui";
    import {
      accionesSiguientes,
      estados,
      estadosAnteriores,
      estadosSiguientes,
      formatearMedidas,
      formatearPrecio,
      generarMensajeImpresionLista,
      generarMensajePrecio,
    } from "../../utils/pedido-detalle";

    import type {
      EstadoPedido,
      HistorialPedido,
      Pedido,
    } from "../../types/pedido";

    /*
     * --------------------------------------------------------------------------
     * Referencias DOM
     * --------------------------------------------------------------------------
     */

    const overlay = document.getElementById("pedido-detalle-overlay");
    const backdrop = document.getElementById("pedido-detalle-backdrop");
    const panel = document.getElementById("pedido-detalle-panel");

    const cerrar = document.getElementById("detalle-cerrar");

    const editar = document.getElementById(
      "detalle-editar",
    ) as HTMLButtonElement | null;
    const eliminar = document.getElementById(
      "detalle-eliminar",
    ) as HTMLButtonElement | null;

    if (obtenerUsuario()?.rol === "ADMIN") {
      eliminar?.classList.remove("hidden");
      eliminar?.classList.add("inline-flex");
    }

    const titulo = document.getElementById("detalle-titulo");
    const loading = document.getElementById("detalle-loading");
    const error = document.getElementById("detalle-error");
    const errorMensaje = document.getElementById("detalle-error-mensaje");
    const contenido = document.getElementById("detalle-contenido");

    const estadoElemento = document.getElementById("detalle-estado");
    const prioridad = document.getElementById("detalle-prioridad");

    const accionesDescripcion = document.getElementById(
      "detalle-acciones-descripcion",
    );

    const accionesError = document.getElementById("detalle-acciones-error");

    const avanzar = document.getElementById(
      "detalle-avanzar",
    ) as HTMLButtonElement | null;

    const avanzarTexto = document.getElementById("detalle-avanzar-texto");

    const retroceder = document.getElementById(
      "detalle-retroceder",
    ) as HTMLButtonElement | null;

    const retrocederTexto = document.getElementById("detalle-retroceder-texto");

    const cancelar = document.getElementById(
      "detalle-cancelar",
    ) as HTMLButtonElement | null;

