    function mostrarCarga() {
      loading?.classList.remove("hidden");
      error?.classList.add("hidden");
      contenido?.classList.add("hidden");
      impresionHeader?.classList.add("hidden");
    }

    function mostrarError(mensaje: string) {
      loading?.classList.add("hidden");
      contenido?.classList.add("hidden");
      error?.classList.remove("hidden");
      impresionHeader?.classList.add("hidden");

      if (errorMensaje) {
        errorMensaje.textContent = mensaje;
      }
    }

    function mostrarContenido() {
      loading?.classList.add("hidden");
      error?.classList.add("hidden");
      contenido?.classList.remove("hidden");
      impresionHeader?.classList.remove("hidden");
    }

    /*
     * --------------------------------------------------------------------------
     * Renderizado de acciones
     * --------------------------------------------------------------------------
     */

    function renderizarAcciones(estadoActual: EstadoPedido) {
      const estadoSiguiente = estadosSiguientes[estadoActual];
      const estadoAnterior = estadosAnteriores[estadoActual];

      accionesError?.classList.add("hidden");

      /*
       * Avanzar
       */

      if (avanzar) {
        if (estadoSiguiente) {
          avanzar.classList.remove("hidden");
          avanzar.disabled = false;

          if (avanzarTexto) {
            avanzarTexto.textContent =
              accionesSiguientes[estadoActual] ??
              `Pasar a ${estados[estadoSiguiente].label}`;
          }
        } else {
          avanzar.classList.add("hidden");
        }
      }

      /*
       * Retroceder
       */

      if (retroceder) {
        if (estadoAnterior) {
          retroceder.classList.remove("hidden");
          retroceder.disabled = false;

          if (retrocederTexto) {
            retrocederTexto.textContent = `Volver a ${estados[estadoAnterior].label}`;
          }
        } else {
          retroceder.classList.add("hidden");
        }
      }

      /*
       * Cancelar
       */

      if (cancelar && cancelarContenedor) {
        const puedeCancelar =
          estadoActual === "REVISION" ||
          estadoActual === "IMPRIMIENDO" ||
          estadoActual === "LISTO";

        if (puedeCancelar) {
          cancelarContenedor.classList.remove("hidden");
          cancelar.disabled = false;
        } else {
          cancelarContenedor.classList.add("hidden");
        }
      }

      /*
       * Descripción
       */

      if (accionesDescripcion) {
        if (estadoActual === "ENTREGADO") {
          accionesDescripcion.textContent =
            "El pedido fue entregado. Si fue un cambio accidental, puedes volver a Listo.";
        } else if (estadoActual === "CANCELADO") {
          accionesDescripcion.textContent =
            "El pedido está cancelado y no tiene movimientos disponibles.";
        } else if (estadoActual === "REVISION") {
          accionesDescripcion.textContent =
            "Cuando el pedido esté listo para producir, envíalo a impresión.";
        } else if (estadoActual === "IMPRIMIENDO") {
          accionesDescripcion.textContent =
            "Cuando termine la impresión, marca el pedido como listo.";
        } else if (estadoActual === "LISTO") {
          accionesDescripcion.textContent =
            "Cuando el cliente reciba el pedido, márcalo como entregado.";
        } else {
          accionesDescripcion.textContent =
            "Puedes modificar el estado del pedido.";
        }
      }
    }

    /*
     * --------------------------------------------------------------------------
     * Renderizado del precio
     * --------------------------------------------------------------------------
     */

    function renderizarPrecio(pedido: Pedido) {
      const valorCobrarActual =
        pedido.valorCobrar ??
        pedido.precioFinal ??
        pedido.precioCalculado ??
        null;

      if (precioCalculado) {
        precioCalculado.textContent = formatearPrecio(
          pedido.precioCalculado ?? valorCobrarActual,
        );
      }

      if (costoDiseno) {
        costoDiseno.textContent = formatearPrecio(pedido.costoDiseno ?? 0);
      }
      if (costoDisenoEditar) {
        costoDisenoEditar.textContent =
          (pedido.costoDiseno ?? 0) > 0 ? "Editar" : "Establecer";
        costoDisenoEditar.setAttribute(
          "aria-label",
          (pedido.costoDiseno ?? 0) > 0
            ? "Editar costo de diseño"
            : "Establecer costo de diseño",
        );
      }

      if (aporteDesarrollador) {
        aporteDesarrollador.textContent = formatearPrecio(
          pedido.aporteDesarrollador ?? 0,
        );
      }

      if (valorCobrar) {
        valorCobrar.textContent = formatearPrecio(
          pedido.valorCobrar ?? pedido.precioFinal ?? valorCobrarActual,
        );
      }

      const estadoPago = pedido.estadoPago ?? "NO_PAGADO";
      const pagoTexto =
        estadoPago === "PAGADO"
          ? "Pagado"
          : estadoPago === "PARCIALMENTE_PAGADO"
            ? "Parcialmente pagado"
            : "No pagado";
      const pagoClase =
        estadoPago === "PAGADO"
          ? "bg-emerald-50 text-emerald-800"
          : estadoPago === "PARCIALMENTE_PAGADO"
            ? "bg-amber-50 text-amber-900"
            : "bg-red-50 text-red-800";

      if (estadoPagoElemento) {
        estadoPagoElemento.textContent = pagoTexto;
        estadoPagoElemento.className = `mt-1 inline-flex rounded-full px-2.5 py-1 text-xs font-semibold ${pagoClase}`;
      }
      if (pagoAccion) {
        const puedeGestionarPago = pedido.estado === "ENTREGADO";
        pagoAccion.classList.toggle("hidden", !puedeGestionarPago);
        pagoAccion.textContent =
          estadoPago === "PAGADO" ? "Revertir último pago" : "Registrar pago";
        pagoAccion.className = `h-8 rounded-lg border px-3 text-xs font-semibold transition ${
          estadoPago === "PAGADO"
            ? "border-red-200 bg-red-50 text-red-700 hover:bg-red-100"
            : "border-emerald-200 bg-emerald-50 text-emerald-800 hover:bg-emerald-100"
        } ${puedeGestionarPago ? "" : "hidden"}`;
      }

      const tienePrecioEspecial = pedido.precioEspecial !== null;

      if (precioEspecialContenedor && precioEspecialEstablecer) {
        precioEspecialContenedor.classList.toggle(
          "hidden",
          !tienePrecioEspecial,
        );

        precioEspecialEstablecer.classList.toggle(
          "hidden",
          tienePrecioEspecial,
        );
      }

      if (precioEspecial) {
        precioEspecial.textContent = formatearPrecio(pedido.precioEspecial);
      }

      /*
       * Actualmente el backend devuelve el ID del usuario y la fecha,
       * pero no devuelve todavía el username.
       */

      if (precioEspecialInfo) {
        if (tienePrecioEspecial && pedido.precioEspecialFecha) {
          precioEspecialInfo.textContent = `Establecido el ${formatearFecha(
            pedido.precioEspecialFecha,
          )}`;
        } else {
          precioEspecialInfo.textContent = "";
        }
      }

      precioEspecialError?.classList.add("hidden");
    }

    /*
     * --------------------------------------------------------------------------
     * Renderizado del pedido
     * --------------------------------------------------------------------------
     */

    function renderizarPedido(pedido: Pedido) {
      pedidoActual = pedido;

      const estado = estados[pedido.estado];

      if (titulo) {
        titulo.textContent = `Pedido #${pedido.id}`;
      }

      if (estadoElemento) {
        estadoElemento.textContent = estado?.label ?? pedido.estado;

        estadoElemento.className = `inline-flex rounded-full px-3 py-1.5 text-sm font-medium ${
          estado?.clase ?? "bg-slate-100 text-slate-700"
        }`;
      }

      /*
       * Prioridad
       */

      if (prioridad) {
        prioridad.classList.toggle("hidden", pedido.prioridad <= 0);
      }

      renderizarAcciones(pedido.estado);

      /*
       * Cliente
       */

      if (clienteHeader) {
        clienteHeader.textContent = pedido.cliente?.nombre ?? "—";
      }

      if (telefonoHeader) {
        telefonoHeader.textContent = pedido.cliente?.telefono ?? "—";
      }

      /*
       * Impresión
       */

      if (servicio) {
        servicio.textContent = pedido.servicio;
      }

      if (medidas) {
        medidas.textContent = formatearMedidas(pedido);
      }

      if (contraer) {
        contraer.textContent =
          pedido.contraer === null ? "—" : pedido.contraer ? "Sí" : "No";
      }

      if (velocidad) {
        velocidad.textContent =
          pedido.velocidad !== null ? `${pedido.velocidad}%` : "—";
      }

      if (obstruccion) {
        obstruccion.textContent =
          pedido.obstruccion === null ? "—" : pedido.obstruccion ? "Sí" : "No";
      }

      /*
       * Precios
       */

      renderizarPrecio(pedido);

      /*
       * Observaciones
       */

      if (observacionesSeccion && observaciones) {
        const tieneObservaciones = Boolean(pedido.observaciones?.trim());

        observacionesSeccion.classList.toggle("hidden", !tieneObservaciones);

        if (tieneObservaciones) {
          observaciones.textContent = pedido.observaciones;
        }
      }

      /*
       * Fechas
       */

      if (creado) {
        creado.textContent = formatearFecha(pedido.createdAt);
      }

      if (actualizado) {
        actualizado.textContent = formatearFecha(pedido.updatedAt);
      }

      if (entrega) {
        entrega.textContent = formatearFecha(pedido.fechaEntrega);
      }

      renderizarHistorial(historialActual);

      mostrarContenido();
    }

    /*
     * --------------------------------------------------------------------------
     * Historial
     * --------------------------------------------------------------------------
     */

    function renderizarHistorial(registros: HistorialPedido[]) {
      historialActual = registros;
      renderizarHistorialElement(historial, registros, historialCantidad);
    }

    /*
     * --------------------------------------------------------------------------
     * Carga del pedido
     * --------------------------------------------------------------------------
     */

    async function cargarPedido(id: number) {
      mostrarCarga();

      try {
        const [pedido, historial] = await Promise.all([
          obtenerPedido(id),
          obtenerHistorialPedido(id),
        ]);

        historialActual = historial;

        renderizarPedido(pedido);
      } catch (errorApi) {
        console.error("No se pudo cargar el pedido:", errorApi);

        mostrarError(
          errorApi instanceof Error
            ? errorApi.message
            : "Ocurrió un error al cargar el pedido.",
        );
      }
    }

    /*
     * --------------------------------------------------------------------------
     * Cambio de estado
     * --------------------------------------------------------------------------
     */

    async function cambiarEstado(nuevoEstado: EstadoPedido) {
      if (!pedidoActual || procesandoEstado) {
        return false;
      }

      if (pedidoActual.estado === nuevoEstado) {
        return false;
      }

      procesandoEstado = true;

      avanzar?.setAttribute("disabled", "");
      retroceder?.setAttribute("disabled", "");
      cancelar?.setAttribute("disabled", "");

      if (avanzar) {
        avanzar.disabled = true;
      }

      if (retroceder) {
        retroceder.disabled = true;
      }

      if (cancelar) {
        cancelar.disabled = true;
      }

      accionesError?.classList.add("hidden");

      try {
        const pedidoActualizado = await cambiarEstadoPedido(
          pedidoActual.id,
          nuevoEstado,
        );
        renderizarPedido(pedidoActualizado);

        /*
         * El store/WebSocket actualizará el pedido.
         * Recargamos el historial inmediatamente.
         */

        const nuevoHistorial = await obtenerHistorialPedido(pedidoActual.id);

        renderizarHistorial(nuevoHistorial);
        if (nuevoEstado !== "CANCELADO") {
          mostrarNotificacion(
            `Pedido #${pedidoActual.id}: estado actualizado.`,
          );
        }

        if (
          nuevoEstado === "ENTREGADO" &&
          pedidoActual.estadoPago !== "PAGADO"
        ) {
          mostrarModalPago("registrar");
        }
        return true;
      } catch (errorApi) {
        console.error("No se pudo cambiar el estado:", errorApi);

        if (accionesError) {
          accionesError.textContent =
            errorApi instanceof Error
              ? errorApi.message
              : "No se pudo cambiar el estado.";

          accionesError.classList.remove("hidden");
        }
        mostrarNotificacion(
          errorApi instanceof Error
            ? errorApi.message
            : "No se pudo cambiar el estado.",
          "error",
        );
        return false;
      } finally {
        procesandoEstado = false;

        if (pedidoActual) {
          renderizarAcciones(pedidoActual.estado);
        }
      }
    }

    /*
     * --------------------------------------------------------------------------
     * Mensajes para WhatsApp
     * --------------------------------------------------------------------------
     */

    whatsappListo?.addEventListener("click", () => {
      if (!pedidoActual) {
        return;
      }

      void copiarMensaje(
        generarMensajeImpresionLista(pedidoActual),
        whatsappListo,
        whatsappListoTexto,
        "Copiar aviso de impresión lista",
      );
    });

    whatsappPrecio?.addEventListener("click", () => {
      if (!pedidoActual) {
        return;
      }

      void copiarMensaje(
        generarMensajePrecio(pedidoActual),
        whatsappPrecio,
        whatsappPrecioTexto,
        "Copiar detalle del precio",
      );
    });
    /*
     * --------------------------------------------------------------------------
     * Eventos de precio especial
     * --------------------------------------------------------------------------
     */

    precioEspecialNuevo?.addEventListener("click", () => {
      mostrarModalPrecioEspecial();
    });

    costoDisenoEditar?.addEventListener("click", mostrarModalCostoDiseno);

    modalCostoDisenoGuardar?.addEventListener("click", () => {
      void guardarCostoDiseno();
    });

    modalCostoDisenoCancelar?.addEventListener(
      "click",
      ocultarModalCostoDiseno,
    );

    modalCostoDisenoBackdrop?.addEventListener(
      "click",
      ocultarModalCostoDiseno,
    );

    modalCostoDisenoInput?.addEventListener("keydown", (evento) => {
      if (evento.key === "Enter") {
        evento.preventDefault();
        void guardarCostoDiseno();
      }
    });

    precioEspecialEditar?.addEventListener("click", () => {
      mostrarModalPrecioEspecial();
    });

    precioEspecialQuitar?.addEventListener("click", () => {
      mostrarModalQuitarPrecioEspecial();
    });

    modalPrecioEspecialGuardar?.addEventListener("click", () => {
      void guardarPrecioEspecial();
    });

    modalPrecioEspecialCancelar?.addEventListener("click", () => {
      ocultarModalPrecioEspecial();
    });

    modalPrecioEspecialBackdrop?.addEventListener("click", () => {
      ocultarModalPrecioEspecial();
    });

    modalPrecioEspecialInput?.addEventListener("keydown", (evento) => {
      if (evento.key === "Enter") {
        evento.preventDefault();
        void guardarPrecioEspecial();
      }
    });

    modalQuitarPrecioEspecialCancelar?.addEventListener("click", () => {
      ocultarModalQuitarPrecioEspecial();
      mostrarNotificacion("Se conservó el precio especial.", "info");
    });

    modalQuitarPrecioEspecialBackdrop?.addEventListener("click", () => {
      ocultarModalQuitarPrecioEspecial();
      mostrarNotificacion("Se conservó el precio especial.", "info");
    });

    modalQuitarPrecioEspecialConfirmar?.addEventListener("click", () => {
      void quitarPrecioEspecial();
    });

    /*
     * --------------------------------------------------------------------------
     * Eventos de acciones
     * --------------------------------------------------------------------------
     */

    avanzar?.addEventListener("click", () => {
      if (!pedidoActual) {
        return;
      }

      const estadoSiguiente = estadosSiguientes[pedidoActual.estado];

      if (!estadoSiguiente) {
        return;
      }

      void cambiarEstado(estadoSiguiente);
    });

    retroceder?.addEventListener("click", () => {
      if (!pedidoActual) {
        return;
      }

      const estadoAnterior = estadosAnteriores[pedidoActual.estado];

      if (!estadoAnterior) {
        return;
      }

      void cambiarEstado(estadoAnterior);
    });

    cancelar?.addEventListener("click", () => {
      if (!pedidoActual || procesandoEstado) {
        return;
      }

      mostrarModalCancelar();
    });

    pagoAccion?.addEventListener("click", () => {
      if (!pedidoActual || pedidoActual.estado !== "ENTREGADO") return;
      mostrarModalPago(
        pedidoActual.estadoPago === "PAGADO" ? "revertir" : "registrar",
      );
    });

    modalPagoCancelar?.addEventListener("click", () => {
      ocultarModalPago();
      mostrarNotificacion("No se hicieron cambios en el pago.", "info");
    });
    modalPagoBackdrop?.addEventListener("click", () => {
      ocultarModalPago();
      mostrarNotificacion("No se hicieron cambios en el pago.", "info");
    });
    modalPagoConfirmar?.addEventListener("click", () => {
      void confirmarAccionPago();
    });
    modalEliminarPedidoCancelar?.addEventListener("click", () => {
      ocultarModalElement(modalEliminarPedido);
      mostrarNotificacion("Eliminación del pedido cancelada.", "info");
    });
    document
      .getElementById("modal-eliminar-pedido-backdrop")
      ?.addEventListener("click", () => {
        ocultarModalElement(modalEliminarPedido);
        mostrarNotificacion("Eliminación del pedido cancelada.", "info");
      });
    modalEliminarPedidoConfirmar?.addEventListener("click", () => {
      void confirmarEliminacionPedido();
    });

    /*
     * --------------------------------------------------------------------------
     * Editar pedido
     * --------------------------------------------------------------------------
     */

    editar?.addEventListener("click", () => {
      if (!pedidoActual) {
        return;
      }

      document.dispatchEvent(
        new CustomEvent("centro-control:editar-pedido", {
          detail: {
            id: pedidoActual.id,
          },
        }),
      );
    });

    eliminar?.addEventListener("click", () => {
      if (!pedidoActual || procesandoEliminacion) return;
      if (modalEliminarPedidoTexto) {
        modalEliminarPedidoTexto.textContent = `¿Eliminar el pedido #${pedidoActual.id} de ${pedidoActual.cliente?.nombre ?? "este cliente"}? Esta acción no se puede deshacer.`;
      }
      mostrarModalElement(modalEliminarPedido);
    });

    async function confirmarEliminacionPedido() {
      const botonEliminar = eliminar;
      if (
        !pedidoActual ||
        procesandoEliminacion ||
        !modalEliminarPedidoConfirmar ||
        !botonEliminar
      )
        return;
      procesandoEliminacion = true;
      modalEliminarPedidoConfirmar.disabled = true;
      modalEliminarPedidoConfirmar.textContent = "Eliminando...";
      botonEliminar.disabled = true;
      botonEliminar.textContent = "Eliminando...";

      try {
        const pedidoId = pedidoActual.id;
        await eliminarPedido(pedidoId);
        ocultarModalElement(modalEliminarPedido);
        ocultarOverlay();
        mostrarNotificacion(`Pedido #${pedidoId} eliminado.`);
      } catch (caught) {
        mostrarNotificacion(
          caught instanceof Error
            ? caught.message
            : "No se pudo eliminar el pedido.",
          "error",
        );
      } finally {
        procesandoEliminacion = false;
        botonEliminar.disabled = false;
        botonEliminar.textContent = "Eliminar";
        modalEliminarPedidoConfirmar.disabled = false;
        modalEliminarPedidoConfirmar.textContent = "Eliminar";
      }
    }

    /*
     * --------------------------------------------------------------------------
     * Modal de cancelación
     * --------------------------------------------------------------------------
     */

    modalCancelarNo?.addEventListener("click", () => {
      ocultarModalCancelar();
      mostrarNotificacion("El pedido no fue cancelado.", "info");
    });

    modalCancelarBackdrop?.addEventListener("click", () => {
      ocultarModalCancelar();
      mostrarNotificacion("El pedido no fue cancelado.", "info");
    });

    modalCancelarSi?.addEventListener("click", async () => {
      if (!pedidoActual || procesandoEstado) {
        return;
      }

      ocultarModalCancelar();

      const pedidoId = pedidoActual.id;
      if (await cambiarEstado("CANCELADO")) {
        mostrarNotificacion(`Pedido #${pedidoId} cancelado.`);
      }
    });

    /*
     * --------------------------------------------------------------------------
     * Cierre del detalle
     * --------------------------------------------------------------------------
     */

    cerrar?.addEventListener("click", ocultarOverlay);

    backdrop?.addEventListener("click", ocultarOverlay);

    /*
     * --------------------------------------------------------------------------
     * Tecla Escape
     * --------------------------------------------------------------------------
     */

    document.addEventListener("keydown", (evento) => {
      if (evento.key !== "Escape") {
        return;
      }

      if (
        modalEliminarPedido &&
        !modalEliminarPedido.classList.contains("hidden")
      ) {
        ocultarModalElement(modalEliminarPedido);
        mostrarNotificacion("Eliminación del pedido cancelada.", "info");
        return;
      }

      if (
        modalQuitarPrecioEspecial &&
        !modalQuitarPrecioEspecial.classList.contains("hidden")
      ) {
        ocultarModalQuitarPrecioEspecial();
        mostrarNotificacion("Se conservó el precio especial.", "info");
        return;
      }

      if (
        modalPrecioEspecial &&
        !modalPrecioEspecial.classList.contains("hidden")
      ) {
        ocultarModalPrecioEspecial();
        return;
      }

      if (modalCostoDiseno && !modalCostoDiseno.classList.contains("hidden")) {
        ocultarModalCostoDiseno();
        return;
      }

      if (modalPago && !modalPago.classList.contains("hidden")) {
        ocultarModalPago();
        mostrarNotificacion("No se hicieron cambios en el pago.", "info");
        return;
      }

      if (modalCancelar && !modalCancelar.classList.contains("hidden")) {
        ocultarModalCancelar();
        mostrarNotificacion("El pedido no fue cancelado.", "info");
        return;
      }

      ocultarOverlay();
    });

    /*
     * --------------------------------------------------------------------------
     * Abrir pedido
     * --------------------------------------------------------------------------
     */

    document.addEventListener("centro-control:abrir-pedido", (evento) => {
      const customEvent = evento as CustomEvent<{ id: number }>;
      const id = customEvent.detail?.id;

      if (!id) {
        return;
      }

      mostrarOverlay();
      void cargarPedido(id);
    });

    /*
     * --------------------------------------------------------------------------
     * Sincronización con el store
     * --------------------------------------------------------------------------
     */

    suscribirsePedidos((pedidos) => {
      if (!pedidoActual) {
        return;
      }

      const pedidoActualizado = pedidos.find(
        (pedido) => pedido.id === pedidoActual?.id,
      );

      if (!pedidoActualizado) {
        return;
      }

      renderizarPedido(pedidoActualizado);
    });
  </script>
</div>
