    function mostrarModalCostoDiseno() {
      if (!modalCostoDiseno || !pedidoActual || !modalCostoDisenoInput) {
        return;
      }

      const costoActual = pedidoActual.costoDiseno ?? 0;
      if (modalCostoDisenoTitulo) {
        modalCostoDisenoTitulo.textContent =
          costoActual > 0
            ? "Editar costo de diseño"
            : "Establecer costo de diseño";
      }
      if (modalCostoDisenoActual) {
        modalCostoDisenoActual.textContent = `Actual: ${formatearPrecio(costoActual)}`;
      }

      modalCostoDisenoInput.value = costoActual.toFixed(2);
      modalCostoDisenoError?.classList.add("hidden");
      mostrarModalElement(modalCostoDiseno);

      setTimeout(() => {
        modalCostoDisenoInput.focus();
        modalCostoDisenoInput.select();
      }, 50);
    }

    function ocultarModalCostoDiseno() {
      ocultarModalElement(modalCostoDiseno);

      if (
        modalPrecioEspecial?.classList.contains("hidden") &&
        modalQuitarPrecioEspecial?.classList.contains("hidden") &&
        modalCancelar?.classList.contains("hidden") &&
        overlay?.classList.contains("invisible")
      ) {
        document.body.classList.remove("overflow-hidden");
      }
    }

    async function guardarCostoDiseno() {
      if (!pedidoActual || !modalCostoDisenoInput || procesandoCostoDiseno) {
        return;
      }

      const valorTexto = modalCostoDisenoInput.value.trim();
      const valor = Number(valorTexto);
      if (!valorTexto || !Number.isFinite(valor) || valor < 0) {
        if (modalCostoDisenoError) {
          modalCostoDisenoError.textContent =
            "Ingresa un costo válido igual o mayor que $0.00.";
          modalCostoDisenoError.classList.remove("hidden");
        }
        modalCostoDisenoInput.focus();
        return;
      }

      procesandoCostoDiseno = true;
      if (modalCostoDisenoGuardar) {
        modalCostoDisenoGuardar.disabled = true;
        modalCostoDisenoGuardar.textContent = "Guardando...";
      }
      modalCostoDisenoError?.classList.add("hidden");

      try {
        const pedidoActualizado = await actualizarPedido(pedidoActual.id, {
          costoDiseno: Number(valor.toFixed(2)),
        });
        renderizarPedido(pedidoActualizado);
        ocultarModalCostoDiseno();
      } catch (errorApi) {
        console.error("No se pudo actualizar el costo de diseño:", errorApi);
        if (modalCostoDisenoError) {
          modalCostoDisenoError.textContent =
            errorApi instanceof Error
              ? errorApi.message
              : "No se pudo guardar el costo de diseño.";
          modalCostoDisenoError.classList.remove("hidden");
        }
      } finally {
        procesandoCostoDiseno = false;
        if (modalCostoDisenoGuardar) {
          modalCostoDisenoGuardar.disabled = false;
          modalCostoDisenoGuardar.textContent = "Guardar costo";
        }
      }
    }

