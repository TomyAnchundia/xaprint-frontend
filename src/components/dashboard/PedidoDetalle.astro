    /*
     * --------------------------------------------------------------------------
     * Guardar precio especial
     * --------------------------------------------------------------------------
     */

    async function guardarPrecioEspecial() {
      if (
        !pedidoActual ||
        !modalPrecioEspecialInput ||
        procesandoPrecioEspecial
      ) {
        return;
      }

      const valorTexto = modalPrecioEspecialInput.value.trim();
      const valor = Number(valorTexto);

      if (!valorTexto || !Number.isFinite(valor) || valor <= 0) {
        if (modalPrecioEspecialError) {
          modalPrecioEspecialError.textContent =
            "Ingresa un precio válido mayor que $0.00.";

          modalPrecioEspecialError.classList.remove("hidden");
        }

        modalPrecioEspecialInput.focus();
        return;
      }

      procesandoPrecioEspecial = true;

      if (modalPrecioEspecialGuardar) {
        modalPrecioEspecialGuardar.disabled = true;
        modalPrecioEspecialGuardar.textContent = "Guardando...";
      }

      modalPrecioEspecialError?.classList.add("hidden");

      try {
        const pedidoActualizado = await cambiarPrecioEspecial(
          pedidoActual.id,
          Number(valor.toFixed(2)),
        );

        renderizarPedido(pedidoActualizado);
        ocultarModalPrecioEspecial();
      } catch (errorApi) {
        console.error("No se pudo cambiar el precio especial:", errorApi);

        if (modalPrecioEspecialError) {
          modalPrecioEspecialError.textContent =
            errorApi instanceof Error
              ? errorApi.message
              : "No se pudo guardar el precio especial.";

          modalPrecioEspecialError.classList.remove("hidden");
        }
      } finally {
        procesandoPrecioEspecial = false;

        if (modalPrecioEspecialGuardar) {
          modalPrecioEspecialGuardar.disabled = false;
          modalPrecioEspecialGuardar.textContent = "Guardar precio";
        }
      }
    }

