---
import Logo from "../Logo.astro";
---

<header
  class="sticky top-0 z-50 flex h-16 shrink-0 items-center justify-between border-b border-slate-200 bg-white px-4 sm:px-6"
>
  <div class="flex items-center gap-3">
    <button
      id="menu-button"
      type="button"
      class="inline-flex h-10 w-10 items-center justify-center rounded-lg text-slate-500 transition hover:bg-slate-100 hover:text-slate-900 focus:outline-none focus:ring-2 focus:ring-slate-200 lg:hidden"
      aria-label="Abrir menú"
    >
      <svg
        class="h-5 w-5"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M4 6h16M4 12h16M4 18h16"></path>
      </svg>
    </button>

    <Logo class="h-5 w-24 sm:h-7 sm:w-32 md:h-8 md:w-40 lg:hidden" />

    <div class="hidden md:block">
      <h1 class="text-base font-semibold text-slate-900 sm:text-lg">
        Centro de control
      </h1>
      <p class="text-xs text-slate-400">Impresiones</p>
    </div>
  </div>

  <div class="flex items-center gap-2 sm:gap-3">
    <!-- Estado de conexión -->
    <div
      id="estado-api"
      role="status"
      aria-label="Conectando con el servidor"
      class="flex items-center gap-2 rounded-full border border-slate-200 bg-slate-50 px-2 py-1.5 sm:px-3"
      title="Estado de conexión con el servidor"
    >
      <span class="relative flex h-2 w-2">
        <span
          id="estado-api-ping"
          class="absolute inline-flex h-full w-full animate-ping rounded-full bg-slate-400 opacity-75"
        ></span>

        <span
          id="estado-api-punto"
          class="relative inline-flex h-2 w-2 rounded-full bg-slate-400"></span>
      </span>

      <span
        id="estado-api-texto"
        class="sr-only text-xs font-medium text-slate-500 sm:not-sr-only"
      >
        Conectando...
      </span>
    </div>

    <!-- Notificaciones -->
    <button
      type="button"
      id="theme-toggle"
      class="flex h-10 w-10 items-center justify-center rounded-lg text-slate-500 transition hover:bg-slate-100 hover:text-slate-900 focus:outline-none focus:ring-2 focus:ring-slate-200"
      aria-label="Activar modo oscuro"
      title="Activar modo oscuro"
    >
      <svg
        id="theme-icon-moon"
        class="h-5 w-5"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        aria-hidden="true"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M20.5 15.5A8.5 8.5 0 0 1 8.5 3.5a8.5 8.5 0 1 0 12 12Z"></path>
      </svg>
      <svg
        id="theme-icon-sun"
        class="hidden h-5 w-5"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        aria-hidden="true"
      >
        <circle cx="12" cy="12" r="4"></circle>
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M12 2v2m0 16v2M4.93 4.93l1.42 1.42m11.3 11.3 1.42 1.42M2 12h2m16 0h2M4.93 19.07l1.42-1.42m11.3-11.3 1.42-1.42"
        ></path>
      </svg>
    </button>

    <button
      type="button"
      class="flex h-10 w-10 items-center justify-center rounded-lg text-slate-500 transition hover:bg-slate-100 hover:text-slate-900 focus:outline-none focus:ring-2 focus:ring-slate-200"
      aria-label="Notificaciones"
    >
      <svg
        class="h-5 w-5"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9M10 21h4"></path>
      </svg>
    </button>
  </div>
</header>

<script>
  import { suscribirseConexion } from "../../services/pedidos-store";

  const menuButton = document.getElementById("menu-button");
  const themeToggle = document.getElementById("theme-toggle");
  const moonIcon = document.getElementById("theme-icon-moon");
  const sunIcon = document.getElementById("theme-icon-sun");

  function updateThemeControl() {
    const darkMode = document.documentElement.dataset.theme === "dark";
    moonIcon?.classList.toggle("hidden", darkMode);
    sunIcon?.classList.toggle("hidden", !darkMode);
    themeToggle?.setAttribute(
      "aria-label",
      darkMode ? "Activar modo claro" : "Activar modo oscuro",
    );
    themeToggle?.setAttribute(
      "title",
      darkMode ? "Activar modo claro" : "Activar modo oscuro",
    );
  }

  updateThemeControl();

  themeToggle?.addEventListener("click", () => {
    const nextTheme =
      document.documentElement.dataset.theme === "dark" ? "light" : "dark";
    document.documentElement.dataset.theme = nextTheme;
    try {
      localStorage.setItem("centro-control:theme", nextTheme);
    } catch {
      // El tema también funciona en navegadores que bloquean el almacenamiento.
    }
    updateThemeControl();
  });

  const estadoApi = document.getElementById("estado-api");
  const estadoApiPunto = document.getElementById("estado-api-punto");
  const estadoApiPing = document.getElementById("estado-api-ping");
  const estadoApiTexto = document.getElementById("estado-api-texto");

  menuButton?.addEventListener("click", () => {
    window.dispatchEvent(new CustomEvent("centro-control:toggle-sidebar"));
  });

  suscribirseConexion((conectado) => {
    if (!estadoApi || !estadoApiPunto || !estadoApiPing || !estadoApiTexto) {
      return;
    }

    if (conectado) {
      estadoApi.className =
        "flex items-center gap-2 rounded-full border border-emerald-200 bg-emerald-50 px-2 py-1.5 sm:px-3";
      estadoApi.setAttribute("aria-label", "Sistema conectado");

      estadoApiPunto.className =
        "relative inline-flex h-2 w-2 rounded-full bg-emerald-500";

      estadoApiPing.className =
        "absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-400 opacity-75";

      estadoApiTexto.className =
        "sr-only text-xs font-medium text-emerald-700 sm:not-sr-only";

      estadoApiTexto.textContent = "Sistema conectado";
    } else {
      estadoApi.className =
        "flex items-center gap-2 rounded-full border border-red-200 bg-red-50 px-2 py-1.5 sm:px-3";
      estadoApi.setAttribute("aria-label", "Sin conexión");

      estadoApiPunto.className =
        "relative inline-flex h-2 w-2 rounded-full bg-red-500";

      estadoApiPing.className =
        "absolute inline-flex h-full w-full animate-ping rounded-full bg-red-400 opacity-75";

      estadoApiTexto.className =
        "sr-only text-xs font-medium text-red-700 sm:not-sr-only";

      estadoApiTexto.textContent = "Sin conexión";
    }
  });
</script>
