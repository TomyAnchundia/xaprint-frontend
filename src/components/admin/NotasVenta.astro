<section class="flex h-full min-h-0 flex-col gap-4">
  <header class="flex flex-wrap items-end justify-between gap-3">
    <div>
      <p class="text-xs font-semibold uppercase text-cyan-800">
        Pedidos pendientes de pago
      </p>
      <h2 class="mt-1 text-2xl font-bold text-slate-900">Notas de venta</h2>
      <p class="mt-1 text-sm text-slate-500">
        Abre un cliente para revisar sus pedidos pendientes de pago.
      </p>
    </div>
    <label class="group relative block w-full max-w-sm">
      <span class="sr-only">Buscar cliente</span>
      <svg
        class="pointer-events-none absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-slate-400"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        aria-hidden="true"
      >
        <circle cx="11" cy="11" r="7"></circle>
        <path stroke-linecap="round" d="m20 20-4-4"></path>
      </svg>
      <input
        id="notas-venta-buscar"
        type="search"
        autocomplete="off"
        placeholder="Buscar por cliente o teléfono"
        class="h-10 w-full rounded-lg border border-slate-200 bg-white pl-9 pr-3 text-sm text-slate-800 outline-none transition focus:border-cyan-600 focus:ring-2 focus:ring-cyan-100"
      />
    </label>
  </header>

  <div
    id="notas-venta-lista"
    class="min-h-0 flex-1 space-y-3 overflow-y-auto"
  >
    <p class="rounded-xl border border-slate-200 bg-white p-5 text-sm text-slate-500">
      Cargando pedidos...
    </p>
  </div>
</section>

<div
  id="modal-nota-venta"
  class="fixed inset-0 z-[200] hidden items-center justify-center p-2 sm:p-4"
  role="dialog"
  aria-modal="true"
  aria-labelledby="modal-nota-venta-titulo"
>
  <div
    id="modal-nota-venta-backdrop"
    class="absolute inset-0 bg-slate-950/50 backdrop-blur-sm"
  >
  </div>
  <section
    class="relative flex max-h-[min(94dvh,60rem)] w-full max-w-3xl flex-col overflow-hidden rounded-2xl bg-white shadow-2xl"
  >
    <header
      class="flex items-start justify-between gap-4 border-b border-slate-200 px-5 py-4"
    >
      <div>
        <p class="text-xs font-semibold uppercase text-cyan-800">
          Pedidos seleccionados
        </p>
        <h3
          id="modal-nota-venta-titulo"
          class="mt-1 text-lg font-bold text-slate-900"
        >
          Detalle de pedidos
        </h3>
      </div>
      <button
        id="modal-nota-venta-cerrar"
        type="button"
        aria-label="Cerrar detalle"
        class="rounded-lg p-2 text-slate-500 transition hover:bg-slate-100 hover:text-slate-800 focus:outline-none focus:ring-2 focus:ring-cyan-600"
      >
        <svg
          class="h-5 w-5"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="m6 6 12 12M18 6 6 18"></path>
        </svg>
      </button>
    </header>
    <div
      id="modal-nota-venta-detalle"
      class="min-h-0 flex-1 overflow-y-auto p-3 sm:p-5"
    >
    </div>
    <p
      id="modal-nota-venta-mensaje"
      class="hidden px-5 pb-3 text-sm"
      role="status"
      aria-live="polite"
    >
    </p>
    <footer
      class="grid grid-cols-2 gap-2 border-t border-slate-200 bg-slate-50 px-3 py-3 sm:flex sm:flex-wrap sm:items-center sm:justify-end sm:px-5"
    >
      <button
        id="modal-nota-venta-cancelar"
        type="button"
        class="col-span-2 h-10 rounded-lg border border-slate-200 bg-white px-2 text-xs font-medium text-slate-700 transition hover:bg-slate-100 focus:outline-none focus:ring-2 focus:ring-slate-300 sm:col-span-1 sm:px-4 sm:text-sm"
      >
        Cerrar
      </button>
      <button
        id="modal-nota-venta-compartir"
        type="button"
        class="inline-flex h-10 items-center justify-center gap-1 rounded-lg bg-emerald-700 px-2 text-xs font-semibold text-white transition hover:bg-emerald-800 focus:outline-none focus:ring-2 focus:ring-emerald-300 disabled:cursor-not-allowed disabled:opacity-50 sm:gap-2 sm:px-4 sm:text-sm"
      >
        <svg
          class="h-4 w-4"
          viewBox="0 0 24 24"
          fill="currentColor"
          aria-hidden="true"
        >
          <path d="M12.04 2a9.93 9.93 0 0 0-8.52 15.04L2 22l5.12-1.34A9.93 9.93 0 1 0 12.04 2Zm0 18.04a8.1 8.1 0 0 1-4.13-1.13l-.3-.18-3.04.8.81-2.96-.2-.31A8.1 8.1 0 1 1 12.04 20.04Zm4.45-6.07c-.24-.12-1.43-.7-1.65-.78-.22-.08-.38-.12-.54.12-.16.24-.62.78-.76.94-.14.16-.28.18-.52.06-.24-.12-1.02-.38-1.95-1.2-.72-.64-1.21-1.43-1.35-1.67-.14-.24-.02-.37.1-.49.11-.11.24-.28.36-.42.12-.14.16-.24.24-.4.08-.16.04-.3-.02-.42-.06-.12-.54-1.3-.74-1.78-.19-.46-.39-.4-.54-.41l-.46-.01c-.16 0-.42.06-.64.3-.22.24-.84.82-.84 2s.86 2.32.98 2.48c.12.16 1.69 2.58 4.1 3.62.57.25 1.02.4 1.37.51.58.18 1.1.15 1.51.09.46-.07 1.43-.58 1.63-1.14.2-.56.2-1.04.14-1.14-.06-.1-.22-.16-.46-.28Z"></path>
        </svg>
        Compartir
      </button>
      <button
        id="modal-nota-venta-descargar"
        type="button"
        class="h-10 rounded-lg bg-cyan-800 px-4 text-sm font-semibold text-white transition hover:bg-cyan-900 focus:outline-none focus:ring-2 focus:ring-cyan-300 disabled:cursor-not-allowed disabled:opacity-50"
      >
        Generar nota
      </button>
    </footer>
  </section>
</div>

<script>
  import {
    emitirNotaVentaNoPagados,
    type NotaVenta,
  } from "../../services/api";
  import {
    iniciarPedidosStore,
    obtenerPedidosStore,
    suscribirsePedidos,
  } from "../../services/pedidos-store";
  import type { EstadoPedido, Pedido } from "../../types/pedido";
  import { formatearFechaCorta } from "../../utils/fecha";
  import {
    escaparHtml,
    formatearMedidas,
    formatearPrecio,
  } from "../../utils/pedidos-lista";
  import { copiarImagenResumenPedidos } from "../../utils/resumen-pedidos-imagen";
  import { descargarNotaVentaPdf } from "../../utils/nota-venta-pdf";
  import { mostrarNotificacion } from "../../utils/notificaciones";
  import { generarUuidV4 } from "../../utils/uuid";

  interface GrupoCliente {
    clienteId: number;
    nombre: string;
    telefono: string | null;
    pedidos: Pedido[];
  }

  interface NotaEnRevision {
    grupo: GrupoCliente;
    pedidos: Pedido[];
    notaEmitida: NotaVenta | null;
  }

  const lista = document.getElementById("notas-venta-lista");
  const busqueda = document.getElementById(
    "notas-venta-buscar",
  ) as HTMLInputElement | null;
  const modal = document.getElementById("modal-nota-venta");
  const modalDetalle = document.getElementById("modal-nota-venta-detalle");
  const modalMensaje = document.getElementById("modal-nota-venta-mensaje");
  const modalCerrar = document.getElementById(
    "modal-nota-venta-cerrar",
  ) as HTMLButtonElement | null;
  const modalCancelar = document.getElementById(
    "modal-nota-venta-cancelar",
  ) as HTMLButtonElement | null;
  const modalCompartir = document.getElementById(
    "modal-nota-venta-compartir",
  ) as HTMLButtonElement | null;
  const modalDescargar = document.getElementById(
    "modal-nota-venta-descargar",
  ) as HTMLButtonElement | null;
  const estadosElegibles: ReadonlySet<EstadoPedido> = new Set([
    "REVISION",
    "IMPRIMIENDO",
    "LISTO",
    "ENTREGADO",
  ]);
  const etiquetasEstado: Record<EstadoPedido, string> = {
    REVISION: "Revisión",
    IMPRIMIENDO: "Imprimiendo",
    LISTO: "Listo",
    ENTREGADO: "Entregado",
    CANCELADO: "Cancelado",
  };
  const selecciones = new Map<number, Set<number>>();
  const clavesSolicitud = new Map<number, string>();
  const notasEmitidas = new Map<string, NotaVenta>();
  const accionesEnCurso = new Set<number>();
  const mensajesEstado = new Map<
    number,
    { texto: string; tipo: "success" | "error" }
  >();

  let pedidosActuales: Pedido[] = [];
  let pedidosCargados = false;
  let errorCarga: string | null = null;
  let notaEnRevision: NotaEnRevision | null = null;
  let mensajeModal: { texto: string; tipo: "success" | "error" } | null = null;
  let accionEnCurso: "pdf" | "imagen" | null = null;

  function normalizar(valor: string): string {
    return valor
      .trim()
      .toLocaleLowerCase("es")
      .normalize("NFD")
      .replace(/[\u0300-\u036f]/g, "");
  }

  function obtenerPrecio(pedido: Pedido): number | null {
    const precio =
      pedido.valorCobrar ?? pedido.precioEspecial ?? pedido.precioCalculado;
    return typeof precio === "number" && Number.isFinite(precio)
      ? precio
      : null;
  }

  function agruparPedidosElegibles(): GrupoCliente[] {
    const grupos = new Map<number, GrupoCliente>();

    for (const pedido of pedidosActuales) {
      if (
        pedido.estadoPago !== "NO_PAGADO" ||
        !estadosElegibles.has(pedido.estado) ||
        !Number.isSafeInteger(pedido.cliente?.id) ||
        pedido.cliente.id <= 0
      ) {
        continue;
      }

      let grupo = grupos.get(pedido.cliente.id);
      if (!grupo) {
        grupo = {
          clienteId: pedido.cliente.id,
          nombre: pedido.cliente.nombre,
          telefono: pedido.cliente.telefono,
          pedidos: [],
        };
        grupos.set(pedido.cliente.id, grupo);
      }
      grupo.pedidos.push(pedido);
    }

    return [...grupos.values()]
      .map((grupo) => ({
        ...grupo,
        pedidos: grupo.pedidos.sort(
          (a, b) => new Date(b.createdAt).getTime() - new Date(a.createdAt).getTime(),
        ),
      }))
      .sort((a, b) => a.nombre.localeCompare(b.nombre, "es"));
  }

  function reconciliarSelecciones(grupos: GrupoCliente[]) {
    const pedidosPorCliente = new Map(
      grupos.map((grupo) => [
        grupo.clienteId,
        new Set(
          grupo.pedidos
            .filter((pedido) => obtenerPrecio(pedido) !== null)
            .map((pedido) => pedido.id),
        ),
      ]),
    );

    for (const [clienteId, seleccion] of selecciones) {
      const elegibles = pedidosPorCliente.get(clienteId);
      let cambio = false;
      for (const pedidoId of seleccion) {
        if (!elegibles?.has(pedidoId)) {
          seleccion.delete(pedidoId);
          cambio = true;
        }
      }
      if (cambio) {
        clavesSolicitud.delete(clienteId);
        mensajesEstado.delete(clienteId);
      }
      if (seleccion.size === 0) selecciones.delete(clienteId);
    }
  }

  function obtenerSeleccion(clienteId: number): Set<number> {
    let seleccion = selecciones.get(clienteId);
    if (!seleccion) {
      seleccion = new Set<number>();
      selecciones.set(clienteId, seleccion);
    }
    return seleccion;
  }

  function obtenerFirmaNota(clienteId: number, pedidos: Pedido[]): string {
    const ids = pedidos
      .map((pedido) => pedido.id)
      .sort((a, b) => a - b)
      .join(",");
    return `${clienteId}:${ids}`;
  }

  function renderizarModalNota() {
    if (!notaEnRevision || !modalDetalle) return;

    const { grupo, pedidos, notaEmitida } = notaEnRevision;
    const procesando = accionesEnCurso.has(grupo.clienteId);
    const seleccion = selecciones.get(grupo.clienteId) ?? new Set<number>();
    const pedidosElegibles = grupo.pedidos.filter(
      (pedido) => obtenerPrecio(pedido) !== null,
    );
    const todosSeleccionados =
      pedidosElegibles.length > 0 &&
      pedidosElegibles.every((pedido) => seleccion.has(pedido.id));
    const total = pedidos.reduce(
      (suma, pedido) => suma + (obtenerPrecio(pedido) ?? 0),
      0,
    );
    const titulo = document.getElementById("modal-nota-venta-titulo");
    if (titulo) titulo.textContent = `Detalle para ${grupo.nombre}`;

    modalDetalle.innerHTML = `
      <div class="mb-3 flex flex-wrap items-center justify-between gap-3 rounded-lg bg-slate-50 p-3 sm:p-4">
        <div>
          <p class="text-sm font-semibold text-slate-900">${escaparHtml(grupo.nombre)}</p>
          <p class="mt-1 text-xs text-slate-500">
            ${grupo.telefono ? `${escaparHtml(grupo.telefono)} · ` : ""}
            ${grupo.pedidos.length} ${grupo.pedidos.length === 1 ? "pedido pendiente" : "pedidos pendientes"}
          </p>
        </div>
        <label class="inline-flex min-h-10 items-center gap-2 text-xs font-semibold text-slate-700">
          <input
            type="checkbox"
            data-seleccionar-modal-cliente="${grupo.clienteId}"
            ${todosSeleccionados ? "checked" : ""}
            ${procesando || pedidosElegibles.length === 0 ? "disabled" : ""}
            class="h-4 w-4 rounded border-slate-300 accent-cyan-700 focus:ring-cyan-600 disabled:cursor-not-allowed"
          />
          Seleccionar todos
        </label>
      </div>
      <p class="mb-2 text-xs text-slate-500">
        Marca los pedidos que incluirás en la imagen o nota de venta.
      </p>
      <ul class="divide-y divide-slate-100 rounded-lg border border-slate-200">
        ${grupo.pedidos
          .map((pedido) => {
            const precio = obtenerPrecio(pedido);
            return `
              <li>
                <label class="grid min-h-16 grid-cols-[auto_minmax(0,1fr)_auto] items-center gap-3 px-3 py-3 transition hover:bg-slate-50 sm:px-4">
                  <input
                    type="checkbox"
                    data-seleccionar-modal-pedido="${pedido.id}"
                    data-cliente-id="${grupo.clienteId}"
                    ${seleccion.has(pedido.id) ? "checked" : ""}
                    ${procesando || precio === null ? "disabled" : ""}
                    aria-label="Incluir pedido #${pedido.id}"
                    class="h-4 w-4 rounded border-slate-300 accent-cyan-700 focus:ring-cyan-600 disabled:cursor-not-allowed"
                  />
                  <span class="min-w-0">
                    <span class="block text-sm font-semibold text-slate-800">
                      Pedido #${pedido.id} · ${pedido.servicio === "TEXTIL" ? "DTF textil" : "DTF UV"}
                    </span>
                    <span class="mt-1 block text-xs text-slate-500">
                      ${formatearMedidas(pedido)} · ${formatearFechaCorta(pedido.createdAt)} · ${etiquetasEstado[pedido.estado]}
                    </span>
                    ${precio === null ? `<span class="mt-1 block text-xs font-medium text-red-600">No tiene un precio confirmado</span>` : ""}
                  </span>
                  <span class="text-right text-sm font-semibold tabular-nums text-slate-800">
                    ${formatearPrecio(precio)}
                  </span>
                </label>
              </li>
            `;
          })
          .join("")}
      </ul>
      ${
        pedidos.length === 0
          ? `<p class="mt-3 rounded-lg bg-amber-50 p-3 text-sm text-amber-900">Selecciona al menos un pedido con precio confirmado para continuar.</p>`
          : ""
      }
      <div class="mt-3 flex items-center justify-between gap-3 rounded-lg bg-cyan-50 px-3 py-3 sm:px-4">
        <p class="text-sm font-semibold text-slate-700">
          Total · ${pedidos.length} ${pedidos.length === 1 ? "pedido" : "pedidos"}
        </p>
        <p class="text-lg font-bold tabular-nums text-cyan-900">${formatearPrecio(total)}</p>
      </div>
      <p class="mt-3 text-xs leading-5 text-slate-500">
        Compartir copia una imagen temporal para pegar en WhatsApp. Generar nota
        registra los pedidos seleccionados y prepara el PDF.
      </p>
      ${
        notaEmitida
          ? `<p class="mt-2 text-sm font-semibold text-emerald-700">Nota ${escaparHtml(notaEmitida.numero)} emitida.</p>`
          : ""
      }
    `;

    const seleccionarTodos = modalDetalle.querySelector<HTMLInputElement>(
      `[data-seleccionar-modal-cliente="${grupo.clienteId}"]`,
    );
    if (seleccionarTodos) {
      seleccionarTodos.indeterminate =
        seleccion.size > 0 && !todosSeleccionados;
    }

    if (modalMensaje) {
      modalMensaje.textContent = mensajeModal?.texto ?? "";
      modalMensaje.classList.toggle("hidden", !mensajeModal);
      modalMensaje.classList.toggle(
        "text-red-700",
        mensajeModal?.tipo === "error",
      );
      modalMensaje.classList.toggle(
        "text-emerald-700",
        mensajeModal?.tipo === "success",
      );
    }

    if (modalDescargar) {
      modalDescargar.disabled = procesando || pedidos.length === 0;
      modalDescargar.textContent = procesando
        ? accionEnCurso === "pdf"
          ? "Generando nota..."
          : "Espera..."
        : notaEmitida
          ? "Volver a descargar nota"
          : "Generar nota";
    }
    if (modalCompartir) {
      modalCompartir.disabled = procesando || pedidos.length === 0;
      modalCompartir.setAttribute("aria-busy", String(procesando));
    }
    if (modalCerrar) modalCerrar.disabled = procesando;
    if (modalCancelar) modalCancelar.disabled = procesando;
  }

  function abrirModalNota(clienteId: number) {
    if (!modal || accionesEnCurso.has(clienteId)) return;
    const grupo = agruparPedidosElegibles().find(
      (actual) => actual.clienteId === clienteId,
    );
    const seleccion = selecciones.get(clienteId);
    const pedidos =
      grupo?.pedidos.filter(
        (pedido) => seleccion?.has(pedido.id) && obtenerPrecio(pedido) !== null,
      ) ?? [];
    if (!grupo) return;

    const firma = pedidos.length > 0 ? obtenerFirmaNota(clienteId, pedidos) : "";
    notaEnRevision = {
      grupo,
      pedidos,
      notaEmitida: firma ? notasEmitidas.get(firma) ?? null : null,
    };
    mensajeModal = null;
    renderizarModalNota();
    modal.classList.remove("hidden");
    modal.classList.add("flex");
    document.body.classList.add("overflow-hidden");
    modalCerrar?.focus();
  }

  function cerrarModalNota() {
    const clienteId = notaEnRevision?.grupo.clienteId;
    if (clienteId !== undefined && accionesEnCurso.has(clienteId)) return;
    modal?.classList.add("hidden");
    modal?.classList.remove("flex");
    document.body.classList.remove("overflow-hidden");
    notaEnRevision = null;
    mensajeModal = null;
    if (clienteId !== undefined) {
      lista
        ?.querySelector<HTMLButtonElement>(
          `[data-generar-nota="${clienteId}"]`,
        )
        ?.focus();
    }
  }

  function renderizar() {
    if (!lista) return;

    if (!pedidosCargados) {
      lista.innerHTML = `<p class="rounded-xl border border-slate-200 bg-white p-5 text-sm text-slate-500">Cargando pedidos...</p>`;
      return;
    }
    if (errorCarga) {
      lista.innerHTML = `<p class="rounded-xl border border-red-200 bg-red-50 p-5 text-sm text-red-700">${escaparHtml(errorCarga)}</p>`;
      return;
    }

    const todosLosGrupos = agruparPedidosElegibles();
    reconciliarSelecciones(todosLosGrupos);
    const consulta = normalizar(busqueda?.value ?? "");
    const grupos = todosLosGrupos.filter((grupo) =>
      normalizar(`${grupo.nombre} ${grupo.telefono ?? ""}`).includes(consulta),
    );

    if (grupos.length === 0) {
      lista.innerHTML = `
        <div class="rounded-xl border border-slate-200 bg-white p-8 text-center">
          <p class="font-medium text-slate-700">
            ${
              todosLosGrupos.length === 0
                ? "No hay pedidos no pagados en estos estados."
                : "No se encontraron clientes con esa búsqueda."
            }
          </p>
          <p class="mt-1 text-sm text-slate-500">
            Se muestran pedidos en revisión, imprimiendo, listos o entregados.
          </p>
        </div>
      `;
      return;
    }

    lista.innerHTML = grupos
      .map((grupo) => {
        const seleccion = selecciones.get(grupo.clienteId) ?? new Set<number>();
        const pedidosConPrecio = grupo.pedidos.filter(
          (pedido) => obtenerPrecio(pedido) !== null,
        );
        const pedidosSeleccionados = pedidosConPrecio.filter((pedido) =>
          seleccion.has(pedido.id),
        );
        const totalPendiente = pedidosConPrecio.reduce(
          (total, pedido) => total + (obtenerPrecio(pedido) ?? 0),
          0,
        );
        const procesando = accionesEnCurso.has(grupo.clienteId);
        const estado = mensajesEstado.get(grupo.clienteId);

        return `
          <button
            type="button"
            data-generar-nota="${grupo.clienteId}"
            aria-label="Abrir pedidos pendientes de ${escaparHtml(grupo.nombre)}"
            ${procesando ? "disabled" : ""}
            class="flex w-full items-center gap-3 rounded-xl border border-slate-200 bg-white p-4 text-left shadow-sm transition hover:border-cyan-300 hover:bg-cyan-50/50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-cyan-600 disabled:cursor-wait disabled:opacity-60"
          >
            <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-cyan-100 text-base font-bold text-cyan-900">
              ${escaparHtml(grupo.nombre.slice(0, 1).toUpperCase())}
            </span>
            <span class="min-w-0 flex-1">
              <span class="block truncate text-sm font-semibold text-slate-900">
                ${escaparHtml(grupo.nombre)}
              </span>
              <span class="mt-0.5 block truncate text-xs text-slate-500">
                ${grupo.telefono ? escaparHtml(grupo.telefono) + " · " : ""}
                ${grupo.pedidos.length} ${grupo.pedidos.length === 1 ? "pedido sin pagar" : "pedidos sin pagar"}
              </span>
              <span class="mt-1 block text-xs font-medium text-amber-800">
                ${formatearPrecio(totalPendiente)} por cobrar
                ${pedidosSeleccionados.length > 0 ? ` · ${pedidosSeleccionados.length} seleccionados` : ""}
              </span>
              ${
                estado
                  ? `<span class="mt-1 block text-xs ${estado.tipo === "error" ? "text-red-700" : "text-emerald-700"}" role="status">${escaparHtml(estado.texto)}</span>`
                  : ""
              }
            </span>
            <svg class="h-5 w-5 shrink-0 text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="m9 18 6-6-6-6"></path>
            </svg>
          </button>
        `;
      })
      .join("");

    if (notaEnRevision && !accionesEnCurso.has(notaEnRevision.grupo.clienteId)) {
      const grupoActual = todosLosGrupos.find(
        (grupo) => grupo.clienteId === notaEnRevision?.grupo.clienteId,
      );
      if (grupoActual) {
        notaEnRevision.grupo = grupoActual;
        const seleccion = selecciones.get(grupoActual.clienteId) ?? new Set();
        notaEnRevision.pedidos = grupoActual.pedidos.filter(
          (pedido) => seleccion.has(pedido.id) && obtenerPrecio(pedido) !== null,
        );
        const firma =
          notaEnRevision.pedidos.length > 0
            ? obtenerFirmaNota(grupoActual.clienteId, notaEnRevision.pedidos)
            : "";
        notaEnRevision.notaEmitida = firma
          ? notasEmitidas.get(firma) ?? null
          : null;
        renderizarModalNota();
      }
    }
  }

  modalDetalle?.addEventListener("change", (event) => {
    const target = event.target;
    if (!(target instanceof HTMLInputElement) || !notaEnRevision) return;

    const clienteId = notaEnRevision.grupo.clienteId;
    if (accionesEnCurso.has(clienteId)) return;
    const grupo = agruparPedidosElegibles().find(
      (actual) => actual.clienteId === clienteId,
    );
    if (!grupo) return;

    const seleccion = obtenerSeleccion(clienteId);
    if (target.matches("[data-seleccionar-modal-cliente]")) {
      if (target.checked) {
        grupo.pedidos.forEach((pedido) => {
          if (obtenerPrecio(pedido) !== null) seleccion.add(pedido.id);
        });
      } else {
        seleccion.clear();
      }
    } else {
      const pedidoId = Number(target.dataset.seleccionarModalPedido);
      if (!Number.isSafeInteger(pedidoId)) return;
      if (target.checked) seleccion.add(pedidoId);
      else seleccion.delete(pedidoId);
    }

    clavesSolicitud.delete(clienteId);
    mensajesEstado.delete(clienteId);
    if (seleccion.size === 0) selecciones.delete(clienteId);
    const pedidos = grupo.pedidos.filter(
      (pedido) => seleccion.has(pedido.id) && obtenerPrecio(pedido) !== null,
    );
    const firma = pedidos.length > 0 ? obtenerFirmaNota(clienteId, pedidos) : "";
    notaEnRevision = {
      grupo,
      pedidos,
      notaEmitida: firma ? notasEmitidas.get(firma) ?? null : null,
    };
    const foco =
      target.matches("[data-seleccionar-modal-cliente]")
        ? `[data-seleccionar-modal-cliente="${clienteId}"]`
        : `[data-seleccionar-modal-pedido="${target.dataset.seleccionarModalPedido}"]`;
    renderizar();
    modalDetalle
      ?.querySelector<HTMLInputElement>(foco)
      ?.focus();
  });

  lista?.addEventListener("click", (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;
    const boton = target.closest<HTMLButtonElement>("button[data-generar-nota]");
    if (!boton) return;
    event.preventDefault();
    const clienteId = Number(boton.dataset.generarNota);
    if (Number.isSafeInteger(clienteId) && clienteId > 0) {
      abrirModalNota(clienteId);
    }
  });

  modalCerrar?.addEventListener("click", cerrarModalNota);
  modalCancelar?.addEventListener("click", cerrarModalNota);
  document
    .getElementById("modal-nota-venta-backdrop")
    ?.addEventListener("click", cerrarModalNota);
  document.addEventListener("keydown", (event) => {
    if (!modal?.classList.contains("flex")) return;
    if (event.key === "Escape") {
      event.preventDefault();
      cerrarModalNota();
      return;
    }
    if (event.key !== "Tab") return;
    const controles = Array.from(
      modal.querySelectorAll<HTMLElement>(
        'button:not(:disabled), input:not(:disabled), [href], [tabindex]:not([tabindex="-1"])',
      ),
    ).filter((control) => control.offsetParent !== null);
    if (controles.length === 0) return;
    const primero = controles[0];
    const ultimo = controles[controles.length - 1];
    if (event.shiftKey && document.activeElement === primero) {
      event.preventDefault();
      ultimo.focus();
    } else if (!event.shiftKey && document.activeElement === ultimo) {
      event.preventDefault();
      primero.focus();
    }
  });
  modalDescargar?.addEventListener("click", () => {
    void procesarNotaEnRevision("pdf");
  });
  modalCompartir?.addEventListener("click", () => {
    void procesarNotaEnRevision("imagen");
  });

  function obtenerPedidosEnRevisionActualizados(
    revision: NotaEnRevision,
  ): Pedido[] {
    const clienteId = revision.grupo.clienteId;
    const pedidosPorId = new Map(
      pedidosActuales.map((pedido) => [pedido.id, pedido]),
    );
    const actualizados: Pedido[] = [];
    for (const pedido of revision.pedidos) {
      const actual = pedidosPorId.get(pedido.id);
      if (
        !actual ||
        actual.cliente.id !== clienteId ||
        actual.estadoPago !== "NO_PAGADO" ||
        !estadosElegibles.has(actual.estado) ||
        obtenerPrecio(actual) !== obtenerPrecio(pedido)
      ) {
        throw new Error(
          "La selección cambió. Cierra el detalle, actualiza la lista y vuelve a revisar.",
        );
      }
      actualizados.push(actual);
    }

    return actualizados;
  }

  async function obtenerNotaEnRevision(
    revision: NotaEnRevision,
  ): Promise<NotaVenta> {
    if (revision.notaEmitida) return revision.notaEmitida;

    const clienteId = revision.grupo.clienteId;
    const pedidos = obtenerPedidosEnRevisionActualizados(revision);
    const idempotencyKey =
      clavesSolicitud.get(clienteId) ?? generarUuidV4();
    clavesSolicitud.set(clienteId, idempotencyKey);
    const nota = await emitirNotaVentaNoPagados(
      pedidos.map((pedido) => pedido.id),
      idempotencyKey,
    );
    revision.notaEmitida = nota;
    notasEmitidas.set(
      obtenerFirmaNota(clienteId, revision.pedidos),
      nota,
    );
    clavesSolicitud.delete(clienteId);
    return nota;
  }

  async function procesarNotaEnRevision(accion: "pdf" | "imagen") {
    const revision = notaEnRevision;
    if (!revision || accionesEnCurso.has(revision.grupo.clienteId)) return;
    const { grupo } = revision;
    const clienteId = grupo.clienteId;
    const notaYaEmitida = accion === "pdf" && revision.notaEmitida !== null;
    accionesEnCurso.add(clienteId);
    accionEnCurso = accion;
    mensajeModal = {
      texto:
        accion === "pdf"
          ? notaYaEmitida
            ? "Preparando el PDF..."
            : "Emitiendo la nota de venta y preparando el PDF..."
          : "Preparando el resumen temporal. No se guardará una nota.",
      tipo: "success",
    };
    mensajesEstado.set(clienteId, {
      texto:
        accion === "pdf"
          ? notaYaEmitida
            ? "Preparando el PDF..."
            : "Emitiendo la nota de venta..."
          : "Preparando resumen temporal...",
      tipo: "success",
    });
    renderizarModalNota();
    renderizar();

    try {
      let mensaje: string;
      if (accion === "pdf") {
        const nota = await obtenerNotaEnRevision(revision);
        await descargarNotaVentaPdf(nota);
        mensaje = `Nota de venta ${nota.numero} descargada.`;
      } else {
        const pedidos = obtenerPedidosEnRevisionActualizados(revision);
        const pedidosResumen = pedidos.map((pedido) => {
          const valor = obtenerPrecio(pedido);
          if (valor === null) {
            throw new Error(`El pedido #${pedido.id} no tiene un precio válido.`);
          }
          return {
            id: pedido.id,
            servicio: pedido.servicio === "TEXTIL" ? "DTF textil" : "DTF UV",
            medidas: formatearMedidas(pedido),
            valor,
          };
        });
        const compartirPromesa = copiarImagenResumenPedidos({
          cliente: grupo.nombre,
          pedidos: pedidosResumen,
          total:
            Math.round(
              pedidosResumen.reduce((total, pedido) => total + pedido.valor, 0) *
                100,
            ) / 100,
        }).then(
          (resultado) => ({ resultado }),
          (error: unknown) => ({ error }),
        );
        const intentoCompartir = await compartirPromesa;
        if ("error" in intentoCompartir) throw intentoCompartir.error;
        const resultado = intentoCompartir.resultado;
        mensaje = resultado.copiada
          ? "Resumen temporal copiado. Abre WhatsApp y pégalo con Ctrl+V."
          : `No se pudo copiar el resumen (${resultado.motivo}). Se descargó para compartirlo manualmente.`;
      }

      mensajeModal = { texto: mensaje, tipo: "success" };
      mensajesEstado.set(clienteId, { texto: mensaje, tipo: "success" });
      mostrarNotificacion(mensaje);
    } catch (caught) {
      const prefijoError =
        accion === "pdf"
          ? revision.notaEmitida
            ? "No se pudo descargar el PDF"
            : "No se pudo generar la nota de venta"
          : "No se pudo preparar el resumen temporal";
      const mensaje =
        caught instanceof Error
          ? `${prefijoError}: ${caught.message}`
          : `${prefijoError}.`;
      mensajeModal = { texto: mensaje, tipo: "error" };
      mensajesEstado.set(clienteId, { texto: mensaje, tipo: "error" });
      mostrarNotificacion(mensaje, "error");
    } finally {
      accionesEnCurso.delete(clienteId);
      accionEnCurso = null;
      renderizarModalNota();
      renderizar();
    }
  }

  busqueda?.addEventListener("input", () => {
    selecciones.clear();
    clavesSolicitud.clear();
    mensajesEstado.clear();
    renderizar();
  });

  suscribirsePedidos((pedidos) => {
    pedidosActuales = pedidos;
    renderizar();
  });

  iniciarPedidosStore()
    .then(() => {
      pedidosActuales = obtenerPedidosStore();
      pedidosCargados = true;
      renderizar();
    })
    .catch((error: unknown) => {
      console.error("No se pudieron cargar los pedidos para notas de venta:", error);
      errorCarga = "No se pudieron cargar los pedidos.";
      pedidosCargados = true;
      renderizar();
    });
</script>
