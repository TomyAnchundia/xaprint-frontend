<section class="flex h-full min-h-0 flex-col gap-4 overflow-y-auto pr-1">
  <header class="flex flex-wrap items-end justify-between gap-3">
    <div>
      <p class="text-[10px] font-semibold uppercase text-cyan-800 sm:text-xs">
        Finanzas y producción
      </p>

      <h2 class="mt-1 text-xl font-bold text-slate-900 sm:text-2xl">
        Estadísticas
      </h2>

      <p class="mt-1 text-xs text-slate-500 sm:text-sm">
        Producción lista, cobros y saldo pendiente.
      </p>
    </div>
  </header>

  <div
    id="estadisticas-error"
    class="hidden rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700"
    role="alert"
  >
  </div>

  <section class="grid grid-cols-2 gap-2 sm:grid-cols-3 sm:gap-3">
    <article
      class="stat-card rounded-lg border border-slate-200 bg-white p-3 sm:p-4"
    >
      <p class="text-xs font-semibold text-slate-700 sm:text-sm">Cobrado hoy</p>

      <p
        id="estadisticas-cobrado"
        class="mt-1 text-2xl font-bold text-slate-900 sm:mt-2 sm:text-3xl"
      >
        —
      </p>

      <p class="mt-1 text-[11px] leading-snug text-slate-500 sm:text-xs">
        Pagos recibidos durante el día de hoy
      </p>
    </article>

    <article
      class="stat-card rounded-lg border border-slate-200 bg-white p-3 sm:p-4"
    >
      <p class="text-xs font-semibold text-slate-700 sm:text-sm">
        Por cobrar total
      </p>

      <p
        id="estadisticas-por-cobrar"
        class="mt-1 text-2xl font-bold text-slate-900 sm:mt-2 sm:text-3xl"
      >
        —
      </p>

      <p
        id="estadisticas-deudores"
        class="mt-1 text-[11px] leading-snug text-slate-500 sm:text-xs"
      >
        Saldo pendiente de pedidos entregados
      </p>
    </article>

    <article
      class="stat-card col-span-2 rounded-lg border border-slate-200 bg-white p-3 sm:col-span-1 sm:p-4"
    >
      <p class="text-xs font-semibold text-slate-700 sm:text-sm">
        Aporte desarrollador acumulado
      </p>

      <p
        id="estadisticas-aporte-acumulado"
        class="mt-1 text-2xl font-bold text-slate-900 sm:mt-2 sm:text-3xl"
      >
        —
      </p>

      <p class="mt-1 text-[11px] leading-snug text-slate-500 sm:text-xs">
        Total acumulado de pedidos completamente pagados
      </p>
    </article>
  </section>

  <section class="overflow-hidden rounded-xl border border-slate-200 bg-white">
    <div
      class="flex flex-wrap items-center justify-between gap-2 border-b border-slate-200 px-4 py-3"
    >
      <div>
        <h3 class="text-sm font-bold text-slate-900">Producción lista</h3>

        <p id="estadisticas-subtitulo" class="mt-0.5 text-xs text-slate-500">
          Pedidos que pasaron a Listo en la fecha seleccionada
        </p>
      </div>

      <div class="flex flex-wrap items-end gap-3">
        <label class="text-xs font-semibold text-slate-500">
          Fecha de producción

          <input
            id="estadisticas-fecha"
            type="date"
            class="mt-1 block h-10 rounded-lg border border-slate-200 bg-white px-3 text-sm font-medium text-slate-800 outline-none focus:border-cyan-600 focus:ring-2 focus:ring-cyan-100"
          />
        </label>

        <span
          id="estadisticas-total-metros"
          class="mb-0.5 rounded-md bg-slate-100 px-2.5 py-1 text-xs font-semibold text-slate-700"
        >
          — m producidos
        </span>
      </div>
    </div>

    <div class="overflow-x-auto">
      <table class="w-full min-w-[640px] text-left text-sm">
        <thead class="bg-slate-50 text-xs uppercase text-slate-500">
          <tr>
            <th class="px-4 py-3 font-semibold"> Servicio </th>

            <th class="px-4 py-3 text-right font-semibold"> Metros </th>

            <th class="px-4 py-3 text-right font-semibold"> Valor a cobrar </th>

            <th class="px-4 py-3 text-right font-semibold"> Aporte </th>

            <th class="px-4 py-3 text-right font-semibold">
              Ingreso negocio
            </th>
          </tr>
        </thead>

        <tbody id="estadisticas-produccion" class="divide-y divide-slate-100">
          <tr>
            <td colspan="5" class="px-4 py-8 text-center text-slate-500">
              Cargando estadísticas...
            </td>
          </tr>
        </tbody>

        <tfoot
          id="estadisticas-produccion-total"
          class="bg-slate-50 font-bold text-slate-900"
        >
        </tfoot>
      </table>
    </div>
  </section>
</section>

<script>
  import {
    obtenerResumenPagos,
    obtenerResumenProduccion,
    type ResumenProduccionItem,
  } from "../../services/api";

  const fechaInput = document.getElementById(
    "estadisticas-fecha",
  ) as HTMLInputElement | null;

  const cuerpo = document.getElementById("estadisticas-produccion");
  const pie = document.getElementById("estadisticas-produccion-total");
  const error = document.getElementById("estadisticas-error");

  const cobrado = document.getElementById("estadisticas-cobrado");
  const porCobrar = document.getElementById("estadisticas-por-cobrar");
  const deudores = document.getElementById("estadisticas-deudores");
  const metrosTotal = document.getElementById("estadisticas-total-metros");

  function fechaEcuador() {
    const partes = new Intl.DateTimeFormat("en-CA", {
      timeZone: "America/Guayaquil",
      year: "numeric",
      month: "2-digit",
      day: "2-digit",
    }).formatToParts(new Date());

    const obtener = (tipo: string) =>
      partes.find((parte) => parte.type === tipo)?.value ?? "";

    return `${obtener("year")}-${obtener("month")}-${obtener("day")}`;
  }

  function moneda(valor: number) {
    return new Intl.NumberFormat("es-EC", {
      style: "currency",
      currency: "USD",
    }).format(valor);
  }

  function fila(nombre: string, datos: ResumenProduccionItem) {
    return `
      <tr>
        <td class="px-4 py-3 font-semibold text-slate-800">
          ${nombre}
        </td>

        <td class="px-4 py-3 text-right tabular-nums text-slate-600">
          ${datos.metros.toFixed(2)} m
        </td>

        <td class="px-4 py-3 text-right tabular-nums font-semibold text-slate-800">
          ${moneda(datos.total)}
        </td>

        <td class="px-4 py-3 text-right tabular-nums text-slate-600">
          ${moneda(datos.aporteDesarrollador)}
        </td>

        <td class="px-4 py-3 text-right tabular-nums font-bold text-slate-800">
          ${moneda(datos.ingresoNegocio)}
        </td>
      </tr>
    `;
  }

  async function cargarProduccion(fecha: string) {
    if (!cuerpo || !pie) return;

    error?.classList.add("hidden");

    cuerpo.innerHTML = `
      <tr>
        <td
          colspan="5"
          class="px-4 py-8 text-center text-slate-500"
        >
          Cargando estadísticas...
        </td>
      </tr>
    `;

    try {
      const produccion = await obtenerResumenProduccion(fecha);

      cuerpo.innerHTML = [
        fila("DTF Textil · 31 cm", produccion.textil31),
        fila("DTF Textil · 58 cm", produccion.textil58),
        fila("DTF UV · 29 cm", produccion.uv),
      ].join("");

      pie.innerHTML = `
        <tr>
          <td class="px-4 py-3">
            Total producción
          </td>

          <td class="px-4 py-3 text-right tabular-nums">
            ${produccion.totalGeneral.metros.toFixed(2)} m
          </td>

          <td class="px-4 py-3 text-right tabular-nums">
            ${moneda(produccion.totalGeneral.total)}
          </td>

          <td class="px-4 py-3 text-right tabular-nums">
            ${moneda(produccion.totalGeneral.aporteDesarrollador)}
          </td>

          <td class="px-4 py-3 text-right tabular-nums text-slate-800">
            ${moneda(produccion.totalGeneral.ingresoNegocio)}
          </td>
        </tr>
      `;

      if (metrosTotal) {
        metrosTotal.textContent = `${produccion.totalGeneral.metros.toFixed(2)} m producidos`;
      }
    } catch (caught) {
      console.error("No se pudieron cargar las estadísticas:", caught);

      cuerpo.innerHTML = "";
      pie.innerHTML = "";

      if (error) {
        error.textContent =
          caught instanceof Error
            ? caught.message
            : "No se pudieron cargar las estadísticas.";

        error.classList.remove("hidden");
      }
    }
  }

  async function cargarResumenFinanciero() {
    try {
      const pagos = await obtenerResumenPagos(fechaEcuador());

      if (cobrado) {
        cobrado.textContent = moneda(pagos.cobradoHoy);
      }

      if (porCobrar) {
        porCobrar.textContent = moneda(pagos.porCobrar);
      }

      if (deudores) {
        deudores.textContent = `${pagos.pedidosPorCobrar} pedidos entregados con saldo pendiente`;
      }

      const aporteAcumulado = document.getElementById(
        "estadisticas-aporte-acumulado",
      );

      if (aporteAcumulado) {
        aporteAcumulado.textContent = moneda(
          pagos.aporteDesarrolladorAcumulado,
        );
      }
    } catch (caught) {
      console.error("No se pudo cargar el resumen financiero:", caught);

      if (error) {
        error.textContent =
          caught instanceof Error
            ? caught.message
            : "No se pudo cargar el resumen financiero.";

        error.classList.remove("hidden");
      }
    }
  }

  if (fechaInput) {
    fechaInput.value = fechaEcuador();

    fechaInput.addEventListener("change", () => {
      if (fechaInput.value) {
        void cargarProduccion(fechaInput.value);
      }
    });

    void cargarProduccion(fechaInput.value);
  }

  void cargarResumenFinanciero();

  window.addEventListener("centro-control:actualizar-datos", () => {
    if (fechaInput?.value) {
      void cargarProduccion(fechaInput.value);
    }
    void cargarResumenFinanciero();
  });
</script>
