<section class="flex h-full min-h-0 flex-col gap-4">
  <header class="flex flex-wrap items-end justify-between gap-3">
    <div>
      <p class="text-xs font-semibold uppercase text-emerald-800">Accesos</p>
      <h2 class="mt-1 text-2xl font-bold text-slate-900">Usuarios</h2>
      <p class="mt-1 text-sm text-slate-500">
        Administra cuentas, roles y áreas de trabajo.
      </p>
    </div>
    <button
      id="usuarios-nuevo"
      type="button"
      class="h-10 rounded-lg bg-emerald-800 px-4 text-sm font-semibold text-white transition hover:bg-emerald-900"
      >+ Nuevo usuario</button
    >
  </header>

  <div
    class="grid min-h-0 flex-1 gap-4 lg:grid-cols-[minmax(0,1.1fr)_minmax(300px,0.9fr)]"
  >
    <section
      class="flex min-h-0 flex-col overflow-hidden rounded-xl border border-slate-200 bg-white"
    >
      <div class="border-b border-slate-200 p-3">
        <label class="sr-only" for="usuarios-buscar">Buscar usuarios</label>
        <input
          id="usuarios-buscar"
          type="search"
          placeholder="Buscar por usuario, rol o área"
          class="h-10 w-full rounded-lg border border-slate-200 bg-slate-50 px-3 text-sm outline-none transition focus:border-emerald-600 focus:bg-white focus:ring-2 focus:ring-emerald-100"
        />
      </div>
      <div
        id="usuarios-lista"
        class="min-h-0 flex-1 overflow-y-auto divide-y divide-slate-100"
      >
        <p class="p-5 text-sm text-slate-500">Cargando usuarios...</p>
      </div>
    </section>
    <section
      id="usuario-detalle"
      class="min-h-0 overflow-y-auto rounded-xl border border-slate-200 bg-white p-5"
    >
      <div
        class="flex h-full min-h-40 items-center justify-center text-center text-sm text-slate-500"
      >
        Selecciona un usuario para ver su ficha.
      </div>
    </section>
  </div>

  <div
    id="usuario-form-overlay"
    class="fixed inset-0 z-70 hidden items-center justify-center bg-slate-950/40 p-4 backdrop-blur-sm"
  >
    <form
      id="usuario-form"
      class="w-full max-w-md rounded-xl border border-slate-200 bg-white p-5 shadow-2xl"
    >
      <h3 id="usuario-form-titulo" class="text-lg font-bold text-slate-900">
        Nuevo usuario
      </h3>
      <label
        for="usuario-form-username"
        class="mb-1 mt-4 block text-sm font-medium text-slate-700"
        >Nombre de usuario</label
      >
      <input
        id="usuario-form-username"
        required
        maxlength="80"
        autocomplete="username"
        class="h-10 w-full rounded-lg border border-slate-300 px-3 text-sm outline-none focus:border-emerald-600 focus:ring-2 focus:ring-emerald-100"
      />
      <label
        for="usuario-form-password"
        class="mb-1 mt-3 block text-sm font-medium text-slate-700"
        >Contraseña</label
      >
      <input
        id="usuario-form-password"
        type="password"
        autocomplete="new-password"
        class="h-10 w-full rounded-lg border border-slate-300 px-3 text-sm outline-none focus:border-emerald-600 focus:ring-2 focus:ring-emerald-100"
      />
      <p id="usuario-form-password-ayuda" class="mt-1 text-xs text-slate-500">
        Obligatoria para crear; déjala vacía para conservarla al editar.
      </p>
      <div class="mt-3 grid grid-cols-2 gap-3">
        <div>
          <label
            for="usuario-form-rol"
            class="mb-1 block text-sm font-medium text-slate-700">Rol</label
          ><select
            id="usuario-form-rol"
            class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2.5 text-sm"
            ><option value="EMPLEADO">Empleado</option><option value="DISENADOR"
              >Diseñador</option
            ><option value="ADMIN">Administrador</option></select
          >
        </div>
        <div>
          <label
            for="usuario-form-area"
            class="mb-1 block text-sm font-medium text-slate-700">Área</label
          ><select
            id="usuario-form-area"
            class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2.5 text-sm"
            ><option value="TEXTIL31">Textil 31</option><option value="TEXTIL58"
              >Textil 58</option
            ><option value="UV">UV</option></select
          >
        </div>
      </div>
      <p id="usuario-form-error" class="mt-3 hidden text-sm text-red-700"></p>
      <div class="mt-5 flex justify-end gap-2">
        <button
          id="usuario-form-cancelar"
          type="button"
          class="h-9 rounded-lg border border-slate-200 px-4 text-sm font-medium text-slate-700 hover:bg-slate-50"
          >Cancelar</button
        ><button
          id="usuario-form-guardar"
          type="submit"
          class="h-9 rounded-lg bg-emerald-800 px-4 text-sm font-semibold text-white hover:bg-emerald-900"
          >Guardar</button
        >
      </div>
    </form>
  </div>
  <div
    id="usuario-eliminar-modal"
    class="fixed inset-0 z-120 hidden items-center justify-center bg-slate-950/55 p-4 backdrop-blur-sm"
    role="dialog"
    aria-modal="true"
    aria-labelledby="usuario-eliminar-titulo"
  >
    <button
      id="usuario-eliminar-backdrop"
      type="button"
      class="absolute inset-0 cursor-default"
      aria-label="Cerrar confirmación de eliminación"></button>
    <section
      class="relative w-full max-w-sm rounded-xl border border-slate-200 bg-white p-5 shadow-2xl"
    >
      <h3
        id="usuario-eliminar-titulo"
        class="text-base font-bold text-slate-900"
      >
        Eliminar usuario
      </h3>
      <p class="mt-2 text-sm leading-6 text-slate-600">
        ¿Confirmas que deseas eliminar a <strong
          id="usuario-eliminar-nombre"
          class="font-semibold text-slate-900"></strong>? Esta acción no se
        puede deshacer.
      </p>
      <div class="mt-5 flex justify-end gap-2">
        <button
          id="usuario-eliminar-cancelar"
          type="button"
          class="h-9 rounded-lg border border-slate-200 bg-white px-4 text-sm font-medium text-slate-700 transition hover:bg-slate-50"
          >No, conservar</button
        >
        <button
          id="usuario-eliminar-confirmar"
          type="button"
          class="h-9 rounded-lg bg-red-700 px-4 text-sm font-semibold text-white transition hover:bg-red-800 disabled:cursor-not-allowed disabled:opacity-50"
          >Sí, eliminar</button
        >
      </div>
    </section>
  </div>
</section>

<script>
  import {
    actualizarUsuario,
    crearUsuario,
    eliminarUsuario,
    obtenerUsuarios,
    type CrearUsuarioData,
    type Usuario,
  } from "../../services/api";
  import {
    establecerCargaBoton,
    mostrarNotificacion,
  } from "../../utils/notificaciones";

  const lista = document.getElementById("usuarios-lista");
  const detalle = document.getElementById("usuario-detalle");
  const buscar = document.getElementById(
    "usuarios-buscar",
  ) as HTMLInputElement | null;
  const overlay = document.getElementById("usuario-form-overlay");
  const form = document.getElementById(
    "usuario-form",
  ) as HTMLFormElement | null;
  const username = document.getElementById(
    "usuario-form-username",
  ) as HTMLInputElement | null;
  const password = document.getElementById(
    "usuario-form-password",
  ) as HTMLInputElement | null;
  const rol = document.getElementById(
    "usuario-form-rol",
  ) as HTMLSelectElement | null;
  const area = document.getElementById(
    "usuario-form-area",
  ) as HTMLSelectElement | null;
  const titulo = document.getElementById("usuario-form-titulo");
  const error = document.getElementById("usuario-form-error");
  const modalEliminar = document.getElementById("usuario-eliminar-modal");
  const nombreEliminar = document.getElementById("usuario-eliminar-nombre");
  const confirmarEliminar = document.getElementById(
    "usuario-eliminar-confirmar",
  ) as HTMLButtonElement | null;
  let usuarios: Usuario[] = [];
  let datosCargados = false;
  let cargandoDatos = false;
  let seleccionado: Usuario | null = null;
  let editandoId: number | null = null;
  let usuarioPendienteEliminar: Usuario | null = null;

  function escapar(texto: string) {
    const span = document.createElement("span");
    span.textContent = texto;
    return span.innerHTML;
  }

  function notificar(texto: string, esError = false) {
    mostrarNotificacion(texto, esError ? "error" : "success");
  }

  function renderizarLista() {
    if (!lista) return;
    const termino = (buscar?.value ?? "").toLocaleLowerCase("es").trim();
    const filtrados = usuarios.filter((usuario) =>
      `${usuario.username} ${usuario.rol} ${usuario.area}`
        .toLocaleLowerCase("es")
        .includes(termino),
    );
    lista.innerHTML = filtrados.length
      ? filtrados
          .map(
            (usuario) =>
              `<button type="button" data-usuario-id="${usuario.id}" class="flex w-full items-center gap-3 px-4 py-3 text-left transition hover:bg-emerald-50 ${seleccionado?.id === usuario.id ? "bg-emerald-50" : ""}"><span class="flex h-9 w-9 items-center justify-center rounded-full bg-emerald-100 text-sm font-bold text-emerald-900">${escapar(usuario.username.charAt(0).toUpperCase())}</span><span class="min-w-0 flex-1"><span class="block truncate text-sm font-semibold text-slate-800">${escapar(usuario.username)}</span><span class="mt-0.5 block text-xs text-slate-500">${escapar(usuario.rol)} · ${escapar(usuario.area)}</span></span></button>`,
          )
          .join("")
      : `<p class="p-5 text-sm text-slate-500">No hay coincidencias.</p>`;
    lista
      .querySelectorAll<HTMLButtonElement>("[data-usuario-id]")
      .forEach((boton) =>
        boton.addEventListener("click", () => {
          seleccionado =
            usuarios.find(
              (usuario) => usuario.id === Number(boton.dataset.usuarioId),
            ) ?? null;
          renderizarLista();
          renderizarDetalle();
        }),
      );
  }

  function renderizarDetalle() {
    if (!detalle) return;
    if (!seleccionado) {
      detalle.innerHTML = `<div class="flex h-full min-h-40 items-center justify-center text-center text-sm text-slate-500">Selecciona un usuario para ver su ficha.</div>`;
      return;
    }
    detalle.innerHTML = `<p class="text-xs font-semibold uppercase text-emerald-800">Ficha de usuario</p><h3 class="mt-1 text-xl font-bold text-slate-900">${escapar(seleccionado.username)}</h3><dl class="mt-6 divide-y divide-slate-100 rounded-lg border border-slate-200"><div class="px-3 py-3"><dt class="text-xs text-slate-500">Rol</dt><dd class="mt-1 text-sm font-semibold text-slate-800">${escapar(seleccionado.rol)}</dd></div><div class="px-3 py-3"><dt class="text-xs text-slate-500">Área</dt><dd class="mt-1 text-sm font-semibold text-slate-800">${escapar(seleccionado.area)}</dd></div></dl><div class="mt-5 flex gap-2"><button id="usuario-editar" type="button" class="h-9 rounded-lg bg-emerald-800 px-4 text-sm font-semibold text-white hover:bg-emerald-900">Editar</button><button id="usuario-eliminar" type="button" class="h-9 rounded-lg border border-red-200 bg-red-50 px-4 text-sm font-semibold text-red-700 hover:bg-red-100">Eliminar</button></div>`;
    detalle
      .querySelector("#usuario-editar")
      ?.addEventListener("click", () => abrirFormulario(seleccionado!));
    detalle
      .querySelector("#usuario-eliminar")
      ?.addEventListener("click", () => void borrar(seleccionado!));
  }

  function abrirFormulario(usuario?: Usuario) {
    editandoId = usuario?.id ?? null;
    if (titulo)
      titulo.textContent = usuario ? "Editar usuario" : "Nuevo usuario";
    if (username) username.value = usuario?.username ?? "";
    if (password) {
      password.value = "";
      password.required = !usuario;
    }
    if (rol) rol.value = usuario?.rol ?? "EMPLEADO";
    if (area) area.value = usuario?.area ?? "TEXTIL31";
    error?.classList.add("hidden");
    overlay?.classList.remove("hidden");
    overlay?.classList.add("flex");
    username?.focus();
  }

  function cerrarFormulario() {
    overlay?.classList.add("hidden");
    overlay?.classList.remove("flex");
  }

  async function cargar() {
    if (!lista || cargandoDatos) return;
    cargandoDatos = true;
    lista.innerHTML = `<p class="p-5 text-sm text-slate-500">Cargando usuarios...</p>`;
    try {
      usuarios = await obtenerUsuarios();
      datosCargados = true;
      renderizarLista();
      renderizarDetalle();
    } catch (caught) {
      lista.innerHTML = `<p class="p-5 text-sm text-red-700">${escapar(caught instanceof Error ? caught.message : "No se pudieron cargar los usuarios.")}</p>`;
    } finally {
      cargandoDatos = false;
    }
  }

  async function borrar(usuario: Usuario) {
    usuarioPendienteEliminar = usuario;
    if (nombreEliminar) nombreEliminar.textContent = usuario.username;
    modalEliminar?.classList.remove("hidden");
    modalEliminar?.classList.add("flex");
    document.getElementById("usuario-eliminar-cancelar")?.focus();
  }

  function cancelarBorrado(notificar = true) {
    modalEliminar?.classList.add("hidden");
    modalEliminar?.classList.remove("flex");
    usuarioPendienteEliminar = null;
    if (notificar)
      mostrarNotificacion("Eliminación de usuario cancelada.", "info");
  }

  async function confirmarBorrado() {
    const usuario = usuarioPendienteEliminar;
    if (!usuario || !confirmarEliminar) return;
    establecerCargaBoton(confirmarEliminar, true, "Eliminando...");
    try {
      await eliminarUsuario(usuario.id);
      cancelarBorrado(false);
      seleccionado = null;
      await cargar();
      mostrarNotificacion(`Usuario ${usuario.username} eliminado.`);
    } catch (caught) {
      const mensaje =
        caught instanceof Error
          ? caught.message
          : "No se pudo eliminar el usuario.";
      mostrarNotificacion(mensaje, "error");
    } finally {
      establecerCargaBoton(confirmarEliminar, false, "Sí, eliminar");
    }
  }

  confirmarEliminar?.addEventListener("click", () => {
    void confirmarBorrado();
  });
  document
    .getElementById("usuario-eliminar-cancelar")
    ?.addEventListener("click", () => cancelarBorrado());
  document
    .getElementById("usuario-eliminar-backdrop")
    ?.addEventListener("click", () => cancelarBorrado());
  window.addEventListener("keydown", (event) => {
    if (
      event.key === "Escape" &&
      !modalEliminar?.classList.contains("hidden")
    ) {
      cancelarBorrado();
    }
  });

  document
    .getElementById("usuarios-nuevo")
    ?.addEventListener("click", () => abrirFormulario());
  document
    .getElementById("usuario-form-cancelar")
    ?.addEventListener("click", cerrarFormulario);
  buscar?.addEventListener("input", renderizarLista);
  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (!username || !password || !rol || !area) return;
    const datos = {
      username: username.value.trim(),
      password: password.value,
      rol: rol.value as CrearUsuarioData["rol"],
      area: area.value as Usuario["area"],
    };
    const guardar = document.getElementById(
      "usuario-form-guardar",
    ) as HTMLButtonElement | null;
    if (guardar) establecerCargaBoton(guardar, true, "Guardando...");
    try {
      const guardado =
        editandoId === null
          ? await crearUsuario(datos)
          : await actualizarUsuario(editandoId, {
              username: datos.username,
              rol: datos.rol,
              area: datos.area,
              ...(datos.password ? { password: datos.password } : {}),
            });
      await cargar();
      seleccionado =
        usuarios.find((usuario) => usuario.id === guardado.id) ?? guardado;
      renderizarLista();
      renderizarDetalle();
      cerrarFormulario();
      notificar(
        editandoId === null ? "Usuario creado." : "Usuario actualizado.",
      );
    } catch (caught) {
      mostrarNotificacion(
        caught instanceof Error
          ? caught.message
          : "No se pudo guardar el usuario.",
        "error",
      );
      if (error) {
        error.textContent =
          caught instanceof Error
            ? caught.message
            : "No se pudo guardar el usuario.";
        error.classList.remove("hidden");
      }
    } finally {
      if (guardar) establecerCargaBoton(guardar, false, "Guardar");
    }
  });

  window.addEventListener("centro-control:vista-activada", (event) => {
    const vista = (event as CustomEvent<{ vista?: string }>).detail?.vista;
    if (vista === "usuarios" && !datosCargados) void cargar();
  });
</script>
