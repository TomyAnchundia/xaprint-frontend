<section class="flex h-full min-h-0 flex-col gap-4">
  <header class="flex flex-wrap items-end justify-between gap-3">
    <div>
      <p class="text-xs font-semibold uppercase text-cyan-800">Directorio</p>
      <h2 class="mt-1 text-2xl font-bold text-slate-900">Clientes</h2>
      <p class="mt-1 text-sm text-slate-500">
        Consulta y administra tus clientes.
      </p>
    </div>
    <button
      id="clientes-nuevo"
      class="inline-flex h-10 items-center gap-2 rounded-lg bg-cyan-800 px-4 text-sm font-semibold text-white transition hover:bg-cyan-900"
    >
      <span aria-hidden="true">+</span> Nuevo cliente
    </button>
  </header>

  <div
    class="grid min-h-0 flex-1 gap-4 lg:grid-cols-[minmax(0,1.1fr)_minmax(300px,0.9fr)]"
  >
    <section
      class="flex min-h-0 flex-col overflow-hidden rounded-xl border border-slate-200 bg-white"
    >
      <div class="space-y-3 border-b border-slate-200 bg-slate-50/70 p-3">
        <div class="flex items-center justify-between gap-2">
          <h3 class="text-sm font-semibold text-slate-800">
            Lista de clientes
          </h3>
          <span
            id="clientes-cantidad"
            class="text-xs font-medium text-slate-500"
            aria-live="polite">—</span
          >
        </div>
        <label class="group relative block">
          <span class="sr-only">Buscar clientes por nombre, teléfono o cédula</span>
          <svg
            class="pointer-events-none absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-slate-400 transition group-focus-within:text-cyan-700"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true"
          >
            <circle cx="11" cy="11" r="7"></circle>
            <path stroke-linecap="round" d="m20 20-4-4"></path>
          </svg>
          <input
            id="clientes-buscar"
            type="search"
            placeholder="Buscar por nombre, teléfono o cédula"
            class="h-10 w-full rounded-lg border border-slate-200 bg-white pl-9 pr-3 text-sm outline-none transition focus:border-cyan-600 focus:ring-2 focus:ring-cyan-100"
          />
        </label>
      </div>
      <div
        id="clientes-lista"
        class="min-h-0 flex-1 overflow-y-auto divide-y divide-slate-100"
      >
        <p class="p-5 text-sm text-slate-500">Cargando clientes...</p>
      </div>
    </section>

    <section
      id="cliente-detalle"
      class="min-h-0 overflow-y-auto rounded-xl border border-slate-200 bg-white p-5"
    >
      <div
        class="flex h-full min-h-40 items-center justify-center text-center text-sm text-slate-500"
      >
        Selecciona un cliente para ver su ficha.
      </div>
    </section>
  </div>

  <div
    id="cliente-form-overlay"
    class="fixed inset-0 z-70 hidden items-center justify-center bg-slate-950/40 p-4 backdrop-blur-sm"
  >
    <form
      id="cliente-form"
      class="w-full max-w-md rounded-xl border border-slate-200 bg-white p-5 shadow-2xl"
    >
      <h3 id="cliente-form-titulo" class="text-lg font-bold text-slate-900">
        Nuevo cliente
      </h3>
      <label
        for="cliente-form-nombre"
        class="mb-1 mt-4 block text-sm font-medium text-slate-700">Nombre</label
      >
      <input
        id="cliente-form-nombre"
        required
        maxlength="120"
        class="h-10 w-full rounded-lg border border-slate-300 px-3 text-sm outline-none focus:border-cyan-600 focus:ring-2 focus:ring-cyan-100"
      />
      <label
        for="cliente-form-telefono"
        class="mb-1 mt-3 block text-sm font-medium text-slate-700"
        >Teléfono</label
      >
      <input
        id="cliente-form-telefono"
        required
        maxlength="30"
        type="tel"
        class="h-10 w-full rounded-lg border border-slate-300 px-3 text-sm outline-none focus:border-cyan-600 focus:ring-2 focus:ring-cyan-100"
      />
      <label
        for="cliente-form-cedula"
        class="mb-1 mt-3 block text-sm font-medium text-slate-700"
        >Cédula</label
      >
      <input
        id="cliente-form-cedula"
        maxlength="20"
        class="h-10 w-full rounded-lg border border-slate-300 px-3 text-sm outline-none focus:border-cyan-600 focus:ring-2 focus:ring-cyan-100"
      />
      <label
        for="cliente-form-direccion"
        class="mb-1 mt-3 block text-sm font-medium text-slate-700"
        >Dirección</label
      >
      <input
        id="cliente-form-direccion"
        maxlength="250"
        class="h-10 w-full rounded-lg border border-slate-300 px-3 text-sm outline-none focus:border-cyan-600 focus:ring-2 focus:ring-cyan-100"
      />
      <p id="cliente-form-error" class="mt-3 hidden text-sm text-red-700"></p>
      <div class="mt-5 flex justify-end gap-2">
        <button
          id="cliente-form-cancelar"
          type="button"
          class="h-9 rounded-lg border border-slate-200 px-4 text-sm font-medium text-slate-700 hover:bg-slate-50"
          >Cancelar</button
        >
        <button
          id="cliente-form-guardar"
          type="submit"
          class="h-9 rounded-lg bg-cyan-800 px-4 text-sm font-semibold text-white hover:bg-cyan-900"
          >Guardar</button
        >
      </div>
    </form>
  </div>
  <div
    id="cliente-eliminar-modal"
    class="fixed inset-0 z-120 hidden items-center justify-center bg-slate-950/55 p-4 backdrop-blur-sm"
    role="dialog"
    aria-modal="true"
    aria-labelledby="cliente-eliminar-titulo"
  >
    <button
      id="cliente-eliminar-backdrop"
      type="button"
      class="absolute inset-0 cursor-default"
      aria-label="Cerrar confirmación de eliminación"></button>
    <section
      class="relative w-full max-w-sm rounded-xl border border-slate-200 bg-white p-5 shadow-2xl"
    >
      <h3
        id="cliente-eliminar-titulo"
        class="text-base font-bold text-slate-900"
      >
        Eliminar cliente
      </h3>
      <p class="mt-2 text-sm leading-6 text-slate-600">
        ¿Confirmas que deseas eliminar a <strong
          id="cliente-eliminar-nombre"
          class="font-semibold text-slate-900"></strong>? Esta acción no se
        puede deshacer.
      </p>
      <div class="mt-5 flex justify-end gap-2">
        <button
          id="cliente-eliminar-cancelar"
          type="button"
          class="h-9 rounded-lg border border-slate-200 bg-white px-4 text-sm font-medium text-slate-700 transition hover:bg-slate-50"
          >No, conservar</button
        >
        <button
          id="cliente-eliminar-confirmar"
          type="button"
          class="h-9 rounded-lg bg-red-700 px-4 text-sm font-semibold text-white transition hover:bg-red-800 disabled:cursor-not-allowed disabled:opacity-50"
          >Sí, eliminar</button
        >
      </div>
    </section>
  </div>
  <div
    id="cliente-deuda-modal"
    class="fixed inset-0 z-130 hidden items-center justify-center bg-slate-950/60 p-4 backdrop-blur-sm"
    role="dialog"
    aria-modal="true"
    aria-labelledby="cliente-deuda-titulo"
    aria-describedby="cliente-deuda-resumen"
  >
    <button
      id="cliente-deuda-backdrop"
      type="button"
      class="absolute inset-0 cursor-default"
      aria-label="Cerrar detalle de pedidos por cobrar"></button>
    <section
      class="relative flex max-h-[min(85vh,48rem)] w-full max-w-2xl flex-col overflow-hidden rounded-xl border border-slate-200 bg-white shadow-2xl"
    >
      <header
        class="flex items-start justify-between gap-4 border-b border-slate-200 p-5"
      >
        <div>
          <p class="text-xs font-semibold uppercase text-amber-800">
            Saldo pendiente
          </p>
          <h3
            id="cliente-deuda-titulo"
            class="mt-1 text-lg font-bold text-slate-900"
          >
            Pedidos por cobrar
          </h3>
          <p
            id="cliente-deuda-resumen"
            class="mt-1 text-sm text-slate-500"
          >
          </p>
        </div>
        <button
          id="cliente-deuda-cerrar"
          type="button"
          class="rounded-lg p-2 text-slate-500 transition hover:bg-slate-100 hover:text-slate-900 focus:outline-none focus-visible:ring-2 focus-visible:ring-cyan-600"
          aria-label="Cerrar detalle de deuda"
        >
          <svg
            class="h-5 w-5"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true"
          >
            <path stroke-linecap="round" d="m6 6 12 12M18 6 6 18"></path>
          </svg>
        </button>
      </header>
      <div class="overflow-y-auto p-5">
        <div
          class="overflow-x-auto rounded-lg border border-slate-200"
        >
          <table class="w-full min-w-140 text-left text-sm">
            <thead class="bg-slate-50 text-xs uppercase text-slate-500">
              <tr>
                <th scope="col" class="px-4 py-3">Pedido</th>
                <th scope="col" class="px-4 py-3">Fecha</th>
                <th scope="col" class="px-4 py-3 text-right">Total</th>
                <th scope="col" class="px-4 py-3 text-right">Pagado</th>
                <th scope="col" class="px-4 py-3 text-right">Por cobrar</th>
              </tr>
            </thead>
            <tbody
              id="cliente-deuda-pedidos"
              class="divide-y divide-slate-100"
            >
            </tbody>
          </table>
        </div>
        <div
          class="mt-4 flex items-center justify-between gap-3 rounded-lg bg-amber-50 px-4 py-3"
        >
          <span class="text-sm font-semibold text-amber-900"
            >Saldo total pendiente</span
          >
          <strong
            id="cliente-deuda-total"
            class="text-lg font-bold tabular-nums text-amber-950"></strong>
        </div>
      </div>
      <footer
        class="flex justify-end border-t border-slate-200 bg-slate-50 px-5 py-3"
      >
        <button
          id="cliente-deuda-cerrar-pie"
          type="button"
          class="h-9 rounded-lg border border-slate-200 bg-white px-4 text-sm font-medium text-slate-700 transition hover:bg-slate-100 focus:outline-none focus-visible:ring-2 focus-visible:ring-cyan-600"
          >Cerrar</button
        >
      </footer>
    </section>
  </div>
  <div
    id="cliente-tarifas-modal"
    class="fixed inset-0 z-140 hidden items-center justify-center bg-slate-950/60 p-3 backdrop-blur-sm"
    role="dialog"
    aria-modal="true"
    aria-labelledby="cliente-tarifas-titulo"
  >
    <button
      id="cliente-tarifas-backdrop"
      type="button"
      class="absolute inset-0 cursor-default"
      aria-label="Cerrar tarifas exclusivas"></button>
    <section
      class="relative flex max-h-[min(92vh,52rem)] w-full max-w-3xl flex-col overflow-hidden rounded-xl border border-slate-200 bg-white shadow-2xl"
    >
      <header
        class="flex items-start justify-between gap-4 border-b border-slate-200 p-5"
      >
        <div>
          <p class="text-xs font-semibold uppercase text-cyan-800">
            Configuración de precios
          </p>
          <h3
            id="cliente-tarifas-titulo"
            class="mt-1 text-lg font-bold text-slate-900"
          >
            Tarifas exclusivas
          </h3>
          <p
            id="cliente-tarifas-cliente"
            class="mt-1 text-sm text-slate-500"
          >
          </p>
        </div>
        <button
          id="cliente-tarifas-cerrar"
          type="button"
          class="rounded-lg p-2 text-slate-500 transition hover:bg-slate-100 hover:text-slate-900"
          aria-label="Cerrar tarifas exclusivas">✕</button>
      </header>
      <div class="min-h-0 space-y-5 overflow-y-auto p-5">
        <div
          class="flex flex-wrap items-center justify-between gap-3 rounded-lg border border-cyan-100 bg-cyan-50/60 p-3"
        >
          <p class="max-w-xl text-sm text-slate-700">
            Guardar el primer rango activa automáticamente estas tarifas para
            el cliente. Si falta el servicio, ancho o rango requerido, el
            pedido no podrá guardarse.
          </p>
          <button
            id="cliente-tarifas-toggle"
            type="button"
            class="h-9 rounded-lg px-4 text-sm font-semibold text-white"
          >
          </button>
        </div>
        <form
          id="cliente-tarifa-form"
          class="rounded-lg border border-slate-200 p-4"
        >
          <h4 id="cliente-tarifa-form-titulo" class="text-sm font-bold text-slate-900">
            Agregar rango de tarifa
          </h4>
          <div class="mt-3 grid grid-cols-2 gap-3 sm:grid-cols-3">
            <label class="text-xs font-medium text-slate-600">
              Servicio
              <select
                id="cliente-tarifa-servicio"
                required
                class="mt-1 h-10 w-full rounded-lg border border-slate-300 bg-white px-3 text-sm text-slate-800"
              >
                <option value="TEXTIL">DTF Textil</option>
                <option value="UV">DTF UV</option>
              </select>
            </label>
            <label class="text-xs font-medium text-slate-600">
              Ancho
              <select
                id="cliente-tarifa-ancho"
                required
                class="mt-1 h-10 w-full rounded-lg border border-slate-300 bg-white px-3 text-sm text-slate-800"
              >
                <option value="31">31 cm</option>
                <option value="58">58 cm</option>
              </select>
            </label>
            <label class="text-xs font-medium text-slate-600">
              Precio por metro
              <input
                id="cliente-tarifa-precio"
                type="number"
                min="0.01"
                step="0.01"
                required
                inputmode="decimal"
                class="mt-1 h-10 w-full rounded-lg border border-slate-300 px-3 text-sm text-slate-800"
              />
            </label>
            <label class="text-xs font-medium text-slate-600">
              Desde (cm)
              <input
                id="cliente-tarifa-desde"
                type="number"
                min="0"
                step="0.01"
                required
                class="mt-1 h-10 w-full rounded-lg border border-slate-300 px-3 text-sm text-slate-800"
              />
            </label>
            <label class="text-xs font-medium text-slate-600">
              Hasta (cm)
              <input
                id="cliente-tarifa-hasta"
                type="number"
                min="0.01"
                step="0.01"
                placeholder="Sin límite"
                class="mt-1 h-10 w-full rounded-lg border border-slate-300 px-3 text-sm text-slate-800"
              />
            </label>
            <div class="flex items-end gap-2">
              <button
                id="cliente-tarifa-guardar"
                type="submit"
                class="h-10 flex-1 rounded-lg bg-cyan-800 px-3 text-sm font-semibold text-white hover:bg-cyan-900"
                >Guardar tarifa</button
              >
              <button
                id="cliente-tarifa-cancelar-edicion"
                type="button"
                class="hidden h-10 rounded-lg border border-slate-200 px-3 text-sm font-medium text-slate-700 hover:bg-slate-50"
                >Cancelar</button
              >
            </div>
          </div>
          <p
            id="cliente-tarifa-error"
            class="mt-3 hidden text-sm text-red-700"
            role="alert"
          >
          </p>
        </form>
        <div>
          <h4 class="text-sm font-bold text-slate-900">Rangos configurados</h4>
          <div
            id="cliente-tarifas-lista"
            class="mt-2 divide-y divide-slate-100 rounded-lg border border-slate-200"
          >
            <p class="p-4 text-sm text-slate-500">Cargando tarifas...</p>
          </div>
        </div>
      </div>
      <footer
        class="flex justify-end border-t border-slate-200 bg-slate-50 px-5 py-3"
      >
        <button
          id="cliente-tarifas-cerrar-pie"
          type="button"
          class="h-9 rounded-lg border border-slate-200 bg-white px-4 text-sm font-medium text-slate-700 hover:bg-slate-100"
          >Cerrar</button
        >
      </footer>
    </section>
  </div>
</section>

<script>
  import {
    actualizarCliente,
    actualizarTarifaCliente,
    crearCliente,
    crearTarifaCliente,
    eliminarCliente,
    eliminarTarifaCliente,
    establecerTarifaEspecialCliente,
    obtenerClientes,
    obtenerDeudaCliente,
    obtenerDeudasClientes,
    obtenerPagosCliente,
    obtenerTarifasCliente,
    registrarAbonoCliente,
    type Cliente,
    type DeudaCliente,
    type ResumenDeudaCliente,
    type TarifaCliente,
    type TarifaClienteData,
  } from "../../services/api";
  import { formatearFechaCorta } from "../../utils/fecha";
  import {
    establecerCargaBoton,
    mostrarNotificacion,
  } from "../../utils/notificaciones";

  const lista = document.getElementById("clientes-lista");
  const detalle = document.getElementById("cliente-detalle");
  const buscar = document.getElementById(
    "clientes-buscar",
  ) as HTMLInputElement | null;
  const overlay = document.getElementById("cliente-form-overlay");
  const form = document.getElementById(
    "cliente-form",
  ) as HTMLFormElement | null;
  const nombreInput = document.getElementById(
    "cliente-form-nombre",
  ) as HTMLInputElement | null;
  const telefonoInput = document.getElementById(
    "cliente-form-telefono",
  ) as HTMLInputElement | null;
  const cedulaInput = document.getElementById(
    "cliente-form-cedula",
  ) as HTMLInputElement | null;
  const direccionInput = document.getElementById(
    "cliente-form-direccion",
  ) as HTMLInputElement | null;
  const formTitulo = document.getElementById("cliente-form-titulo");
  const error = document.getElementById("cliente-form-error");
  const modalEliminar = document.getElementById("cliente-eliminar-modal");
  const modalDeuda = document.getElementById("cliente-deuda-modal");
  const deudaPedidos = document.getElementById("cliente-deuda-pedidos");
  const deudaResumen = document.getElementById("cliente-deuda-resumen");
  const deudaTotal = document.getElementById("cliente-deuda-total");
  const nombreEliminar = document.getElementById("cliente-eliminar-nombre");
  const botonEliminarConfirmar = document.getElementById(
    "cliente-eliminar-confirmar",
  ) as HTMLButtonElement | null;

  let clientes: Cliente[] = [];
  let resumenesDeuda: ResumenDeudaCliente[] = [];
  let datosCargados = false;
  let cargandoDatos = false;
  let recargaPendiente = false;
  let clienteSeleccionado: Cliente | null = null;
  let editandoId: number | null = null;
  let solicitudDetalle = 0;
  let clientePendienteEliminar: Cliente | null = null;
  let deudaTrigger: HTMLElement | null = null;
  let tarifasClienteActual: TarifaCliente[] = [];
  let editandoTarifaClienteId: number | null = null;

  const tarifasClienteModal = document.getElementById(
    "cliente-tarifas-modal",
  );
  const tarifasClienteLista = document.getElementById(
    "cliente-tarifas-lista",
  );
  const tarifasClienteTitulo = document.getElementById(
    "cliente-tarifas-cliente",
  );
  const tarifasClienteForm = document.getElementById(
    "cliente-tarifa-form",
  ) as HTMLFormElement | null;
  const tarifaServicioInput = document.getElementById(
    "cliente-tarifa-servicio",
  ) as HTMLSelectElement | null;
  const tarifaAnchoInput = document.getElementById(
    "cliente-tarifa-ancho",
  ) as HTMLSelectElement | null;
  const tarifaDesdeInput = document.getElementById(
    "cliente-tarifa-desde",
  ) as HTMLInputElement | null;
  const tarifaHastaInput = document.getElementById(
    "cliente-tarifa-hasta",
  ) as HTMLInputElement | null;
  const tarifaPrecioInput = document.getElementById(
    "cliente-tarifa-precio",
  ) as HTMLInputElement | null;
  const tarifaError = document.getElementById("cliente-tarifa-error");

  function normalizar(texto: string) {
    return texto
      .normalize("NFD")
      .replace(/[\u0300-\u036f]/g, "")
      .toLocaleLowerCase("es")
      .trim();
  }

  function avisar(texto: string, esError = false) {
    mostrarNotificacion(texto, esError ? "error" : "success");
  }

  function abrirConfirmacionEliminar(cliente: Cliente) {
    clientePendienteEliminar = cliente;
    if (nombreEliminar) nombreEliminar.textContent = cliente.nombre;
    modalEliminar?.classList.remove("hidden");
    modalEliminar?.classList.add("flex");
    document.getElementById("cliente-eliminar-cancelar")?.focus();
  }

  function cerrarConfirmacionEliminar(notificarCancelacion = true) {
    modalEliminar?.classList.add("hidden");
    modalEliminar?.classList.remove("flex");
    clientePendienteEliminar = null;
    if (notificarCancelacion) {
      mostrarNotificacion("Eliminación de cliente cancelada.", "info");
    }
  }

  function abrirDetalleDeuda(
    trigger: HTMLElement,
    cliente: Cliente,
    deuda: DeudaCliente,
  ) {
    if (!modalDeuda || !deudaPedidos || !deudaResumen || !deudaTotal) return;
    deudaTrigger = trigger;
    deudaResumen.textContent = `${cliente.nombre} · ${deuda.pedidos.length} ${deuda.pedidos.length === 1 ? "pedido pendiente" : "pedidos pendientes"}`;
    deudaPedidos.innerHTML = deuda.pedidos
      .filter((pedido) => pedido.porCobrar > 0)
      .sort((a, b) => new Date(b.fecha).getTime() - new Date(a.fecha).getTime())
      .map(
        (pedido) => `
          <tr>
            <th scope="row" class="px-4 py-3 font-semibold text-slate-800">#${pedido.id}</th>
            <td class="px-4 py-3 text-sm text-slate-600">${formatearFechaCorta(pedido.fecha)}</td>
            <td class="px-4 py-3 text-right tabular-nums text-slate-600">${formatearMoneda(pedido.total)}</td>
            <td class="px-4 py-3 text-right tabular-nums text-slate-600">${formatearMoneda(pedido.pagado)}</td>
            <td class="px-4 py-3 text-right font-semibold tabular-nums text-amber-800">${formatearMoneda(pedido.porCobrar)}</td>
          </tr>`,
      )
      .join("");
    deudaTotal.textContent = formatearMoneda(deuda.totalDeuda);
    modalDeuda.classList.remove("hidden");
    modalDeuda.classList.add("flex");
    document.getElementById("cliente-deuda-cerrar")?.focus();
  }

  function restablecerFormularioTarifaCliente() {
    editandoTarifaClienteId = null;
    tarifasClienteForm?.reset();
    const titulo = document.getElementById("cliente-tarifa-form-titulo");
    const guardar = document.getElementById("cliente-tarifa-guardar");
    const cancelar = document.getElementById(
      "cliente-tarifa-cancelar-edicion",
    );
    if (titulo) titulo.textContent = "Agregar rango de tarifa";
    if (guardar) guardar.textContent = "Guardar tarifa";
    cancelar?.classList.add("hidden");
    tarifaError?.classList.add("hidden");
    actualizarAnchosTarifaCliente();
  }

  function actualizarAnchosTarifaCliente() {
    if (!tarifaServicioInput || !tarifaAnchoInput) return;
    const anchoActual = tarifaAnchoInput.value;
    const anchos = tarifaServicioInput.value === "UV" ? [29] : [31, 58];
    tarifaAnchoInput.innerHTML = anchos
      .map((ancho) => `<option value="${ancho}">${ancho} cm</option>`)
      .join("");
    tarifaAnchoInput.value = anchos.includes(Number(anchoActual))
      ? anchoActual
      : String(anchos[0]);
  }

  function renderizarTarifasCliente() {
    if (!tarifasClienteLista) return;
    tarifasClienteLista.innerHTML = tarifasClienteActual.length
      ? tarifasClienteActual
          .map(
            (tarifa) => `
              <article class="flex flex-wrap items-center justify-between gap-3 p-3">
                <div>
                  <p class="text-sm font-semibold text-slate-800">${tarifa.servicio === "TEXTIL" ? "DTF Textil" : "DTF UV"} · ${tarifa.ancho} cm</p>
                  <p class="mt-0.5 text-xs text-slate-500">${tarifa.desde}–${tarifa.hasta === null ? "∞" : tarifa.hasta} cm · ${formatearMoneda(tarifa.precio)}/m</p>
                </div>
                <div class="flex gap-2">
                  <button type="button" data-tarifa-cliente-editar="${tarifa.id}" class="rounded-md border border-slate-200 px-3 py-1.5 text-xs font-semibold text-slate-700 hover:bg-slate-50">Editar</button>
                  <button type="button" data-tarifa-cliente-eliminar="${tarifa.id}" class="rounded-md border border-red-200 px-3 py-1.5 text-xs font-semibold text-red-700 hover:bg-red-50">Eliminar</button>
                </div>
              </article>`,
          )
          .join("")
      : `<p class="p-4 text-sm text-slate-500">Todavía no hay rangos exclusivos configurados.</p>`;
  }

  async function cargarTarifasClienteModal() {
    if (!clienteSeleccionado || !tarifasClienteLista) return;
    tarifasClienteLista.innerHTML =
      '<p class="p-4 text-sm text-slate-500">Cargando tarifas...</p>';
    try {
      tarifasClienteActual = await obtenerTarifasCliente(clienteSeleccionado.id);
      tarifasClienteActual.sort(
        (a, b) =>
          a.servicio.localeCompare(b.servicio) ||
          a.ancho - b.ancho ||
          a.desde - b.desde,
      );
      renderizarTarifasCliente();
    } catch (caught) {
      console.error("No se pudieron cargar las tarifas exclusivas:", caught);
      tarifasClienteLista.innerHTML =
        '<p class="p-4 text-sm text-red-700">No se pudieron cargar las tarifas. Cierra y vuelve a abrir esta ventana para reintentar.</p>';
    }
  }

  async function abrirModalTarifasCliente() {
    if (!clienteSeleccionado || !tarifasClienteModal) return;
    if (tarifasClienteTitulo) {
      tarifasClienteTitulo.textContent = clienteSeleccionado.nombre;
    }
    const toggle = document.getElementById("cliente-tarifas-toggle");
    if (toggle) {
      toggle.textContent = clienteSeleccionado.tarifaEspecial
        ? "Desactivar tarifas exclusivas"
        : "Activar tarifas exclusivas";
      toggle.className = `h-9 rounded-lg px-4 text-sm font-semibold text-white ${
        clienteSeleccionado.tarifaEspecial
          ? "bg-slate-700 hover:bg-slate-800"
          : "bg-cyan-800 hover:bg-cyan-900"
      }`;
    }
    restablecerFormularioTarifaCliente();
    tarifasClienteModal.classList.remove("hidden");
    tarifasClienteModal.classList.add("flex");
    document.getElementById("cliente-tarifas-cerrar")?.focus();
    await cargarTarifasClienteModal();
  }

  function cerrarModalTarifasCliente() {
    tarifasClienteModal?.classList.add("hidden");
    tarifasClienteModal?.classList.remove("flex");
    restablecerFormularioTarifaCliente();
    detalle?.querySelector<HTMLButtonElement>("#cliente-tarifas-abrir")?.focus();
  }

  function cerrarDetalleDeuda() {
    modalDeuda?.classList.add("hidden");
    modalDeuda?.classList.remove("flex");
    deudaTrigger?.focus();
    deudaTrigger = null;
  }

  modalDeuda?.addEventListener("keydown", (event: KeyboardEvent) => {
    if (event.key !== "Tab") return;
    const elementosEnfocables = modalDeuda.querySelectorAll<HTMLElement>(
      'button:not(:disabled):not(#cliente-deuda-backdrop), [href], input:not(:disabled), select:not(:disabled), textarea:not(:disabled), [tabindex]:not([tabindex="-1"])',
    );
    const primero = elementosEnfocables.item(0);
    const ultimo = elementosEnfocables.item(elementosEnfocables.length - 1);
    if (!primero || !ultimo) return;
    if (event.shiftKey && document.activeElement === primero) {
      event.preventDefault();
      ultimo.focus();
    } else if (!event.shiftKey && document.activeElement === ultimo) {
      event.preventDefault();
      primero.focus();
    }
  });

  function renderLista() {
    if (!lista) return;
    const consulta = normalizar(buscar?.value ?? "");
    const encontrados = clientes.filter((cliente) => {
      const coincide = normalizar(
        `${cliente.nombre} ${cliente.telefono ?? ""} ${cliente.cedula ?? ""}`,
      ).includes(consulta);
      const resumen = resumenesDeuda.find(
        (item) => item.cliente.id === cliente.id,
      );
      return coincide && (Boolean(consulta) || (resumen?.totalDeuda ?? 0) > 0);
    });
    const cantidad = document.getElementById("clientes-cantidad");
    if (cantidad) {
      cantidad.textContent = `${encontrados.length} ${encontrados.length === 1 ? "cliente" : "clientes"}`;
    }

    if (
      clienteSeleccionado &&
      !encontrados.some((cliente) => cliente.id === clienteSeleccionado?.id)
    ) {
      clienteSeleccionado = null;
      renderDetalle();
    }
    lista.innerHTML = encontrados.length
      ? encontrados
          .map((cliente) => {
            const resumen = resumenesDeuda.find(
              (item) => item.cliente.id === cliente.id,
            );
            return `
      <button type="button" data-cliente-id="${cliente.id}" class="flex w-full items-center gap-3 px-4 py-3 text-left transition hover:bg-cyan-50 ${clienteSeleccionado?.id === cliente.id ? "bg-cyan-50" : ""}">
        <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-cyan-100 text-sm font-bold text-cyan-900">${escapeHtml(cliente.nombre.slice(0, 1).toUpperCase())}</span>
        <span class="min-w-0 flex-1"><span class="block truncate text-sm font-semibold text-slate-800">${escapeHtml(cliente.nombre)}</span><span class="mt-0.5 block truncate text-xs text-slate-500">${escapeHtml(cliente.telefono ?? "Sin teléfono")}</span></span>
        <span class="text-right"><span class="block text-xs text-slate-400">#${cliente.id}</span>${(resumen?.totalDeuda ?? 0) > 0 ? `<span class="mt-1 block rounded-full bg-amber-50 px-2 py-0.5 text-[11px] font-semibold text-amber-900">${formatearMoneda(resumen!.totalDeuda)}</span>` : `<span class="mt-1 block text-[11px] text-slate-400">Sin deuda</span>`}</span>
      </button>`;
          })
          .join("")
      : `<p class="p-5 text-sm text-slate-500">No hay coincidencias.</p>`;

    lista
      .querySelectorAll<HTMLButtonElement>("[data-cliente-id]")
      .forEach((boton) => {
        boton.addEventListener("click", () => {
          const id = Number(boton.dataset.clienteId);
          clienteSeleccionado =
            clientes.find((cliente) => cliente.id === id) ?? null;
          renderLista();
          renderDetalle();
        });
      });
  }

  async function renderDetalle() {
    if (!detalle) return;
    const cliente = clienteSeleccionado;
    const idSolicitud = ++solicitudDetalle;
    if (!cliente) {
      detalle.innerHTML = `<div class="flex h-full min-h-40 items-center justify-center text-center text-sm text-slate-500">Selecciona un cliente para ver su ficha.</div>`;
      return;
    }
    detalle.innerHTML = `
      <div class="flex items-start justify-between gap-3"><div><p class="text-xs font-semibold uppercase text-cyan-800">Ficha de cliente</p><h3 class="mt-1 text-xl font-bold text-slate-900">${escapeHtml(cliente.nombre)}</h3></div><span class="rounded-md bg-slate-100 px-2 py-1 text-xs font-semibold text-slate-600">#${cliente.id}</span></div>
      <dl class="mt-6 divide-y divide-slate-100 rounded-lg border border-slate-200"><div class="px-3 py-3"><dt class="text-xs text-slate-500">Teléfono</dt><dd class="mt-1 text-sm font-medium text-slate-800">${escapeHtml(cliente.telefono ?? "No registrado")}</dd></div><div class="px-3 py-3"><dt class="text-xs text-slate-500">Cédula</dt><dd class="mt-1 text-sm font-medium text-slate-800">${escapeHtml(cliente.cedula || "No registrada")}</dd></div><div class="px-3 py-3"><dt class="text-xs text-slate-500">Dirección</dt><dd class="mt-1 text-sm font-medium text-slate-800">${escapeHtml(cliente.direccion || "No registrada")}</dd></div></dl>
      <div id="cliente-finanzas" class="mt-4"><p class="text-sm text-slate-500">Cargando saldo y pagos...</p></div>
      <div class="mt-5 flex flex-wrap gap-2"><button id="cliente-editar" type="button" class="h-9 rounded-lg bg-cyan-800 px-4 text-sm font-semibold text-white hover:bg-cyan-900">Editar cliente</button><button id="cliente-eliminar" type="button" class="h-9 rounded-lg border border-red-200 bg-red-50 px-4 text-sm font-semibold text-red-700 hover:bg-red-100">Eliminar</button></div>`;
    detalle
      .querySelector("#cliente-editar")
      ?.addEventListener("click", () => abrirFormulario(cliente));
    detalle
      .querySelector("#cliente-eliminar")
      ?.addEventListener("click", () => abrirConfirmacionEliminar(cliente));
    detalle.insertAdjacentHTML(
      "beforeend",
      `<section class="mt-4 rounded-lg border border-cyan-100 bg-cyan-50/50 p-3"><div class="flex flex-wrap items-center justify-between gap-3"><div><p class="text-sm font-semibold text-slate-800">Tarifas del cliente</p><p class="mt-0.5 text-xs text-slate-500">${cliente.tarifaEspecial ? "Usa tarifas exclusivas. Si falta un rango, no se podrá crear el pedido." : "Usa las tarifas generales."}</p></div><button id="cliente-tarifas-abrir" type="button" class="h-9 rounded-lg border border-cyan-200 bg-white px-3 text-xs font-semibold text-cyan-900 hover:bg-cyan-50">Administrar</button></div></section>`,
    );
    detalle
      .querySelector("#cliente-tarifas-abrir")
      ?.addEventListener("click", () => void abrirModalTarifasCliente());

    try {
      const [deuda, pagosCliente] = await Promise.all([
        obtenerDeudaCliente(cliente.id),
        obtenerPagosCliente(cliente.id),
      ]);
      if (
        idSolicitud !== solicitudDetalle ||
        clienteSeleccionado?.id !== cliente.id
      )
        return;
      const finanzas = detalle.querySelector("#cliente-finanzas");
      if (!finanzas) return;
      const pagosRecientes = [...pagosCliente.pagos].reverse().slice(0, 5);
      finanzas.innerHTML = `
        <div class="grid grid-cols-2 gap-2">
          ${
            deuda.totalDeuda > 0
              ? `<button id="cliente-ver-deuda" type="button" class="rounded-lg border border-amber-200 bg-amber-50 p-3 text-left transition hover:bg-amber-100 focus:outline-none focus-visible:ring-2 focus-visible:ring-amber-500" aria-haspopup="dialog" aria-controls="cliente-deuda-modal"><span class="block text-xs font-medium text-amber-800">Por cobrar</span><span class="mt-1 block text-lg font-bold text-amber-950">${formatearMoneda(deuda.totalDeuda)}</span><span class="block text-[11px] text-amber-800">${deuda.pedidos.length} pedidos con saldo</span></button>`
              : `<div class="rounded-lg border border-amber-200 bg-amber-50 p-3"><p class="text-xs font-medium text-amber-800">Por cobrar</p><p class="mt-1 text-lg font-bold text-amber-950">${formatearMoneda(deuda.totalDeuda)}</p><p class="text-[11px] text-amber-800">Sin pedidos con saldo</p></div>`
          }
          <div class="rounded-lg border border-emerald-200 bg-emerald-50 p-3"><p class="text-xs font-medium text-emerald-800">Pagos registrados</p><p class="mt-1 text-lg font-bold text-emerald-950">${pagosCliente.pagos.length}</p><p class="text-[11px] text-emerald-800">Abonos recibidos</p></div>
        </div>
        ${deuda.totalDeuda > 0 ? `<form id="cliente-abono-form" class="mt-4 rounded-lg border border-slate-200 p-3"><label for="cliente-abono-monto" class="block text-sm font-semibold text-slate-800">Registrar abono</label><p class="mt-1 text-xs text-slate-500">Se aplicará a los pedidos entregados más antiguos. Máximo: ${formatearMoneda(deuda.totalDeuda)}</p><div class="mt-3 grid gap-3 sm:grid-cols-[minmax(0,1fr)_minmax(0,1fr)_auto] sm:items-end"><div class="min-w-0"><label for="cliente-abono-monto" class="sr-only">Monto del abono</label><input id="cliente-abono-monto" name="monto" type="number" min="0.01" max="${deuda.totalDeuda.toFixed(2)}" step="0.01" required inputmode="decimal" placeholder="0.00" class="h-10 w-full rounded-lg border border-slate-300 px-3 text-sm outline-none focus:border-cyan-600 focus:ring-2 focus:ring-cyan-100" /></div><label for="cliente-abono-metodo" class="block text-xs font-medium text-slate-600">Método de pago<select id="cliente-abono-metodo" name="metodoPago" required class="mt-1 h-10 w-full rounded-lg border border-slate-300 bg-white px-3 text-sm text-slate-800"><option value="Efectivo">Efectivo</option><option value="Transferencia">Transferencia</option></select></label><button type="submit" class="h-10 shrink-0 rounded-lg bg-emerald-700 px-4 text-sm font-semibold text-white hover:bg-emerald-800 disabled:cursor-not-allowed disabled:opacity-50">Guardar abono</button></div><p id="cliente-abono-error" class="mt-2 hidden text-sm text-red-700" role="alert"></p></form>` : ""}
        <h4 class="mt-5 text-sm font-bold text-slate-900">Últimos pagos</h4>
        ${pagosRecientes.length ? `<ul class="mt-2 divide-y divide-slate-100 rounded-lg border border-slate-200">${pagosRecientes.map((pago) => `<li class="flex flex-wrap items-start justify-between gap-3 px-3 py-2.5"><span class="min-w-0"><span class="block text-sm font-semibold text-slate-800">${formatearMoneda(pago.monto)} · ${escapeHtml(pago.metodoPago)}</span><span class="mt-0.5 block text-xs text-slate-500">${new Intl.DateTimeFormat("es-EC", { dateStyle: "medium", timeStyle: "short", timeZone: "America/Guayaquil" }).format(new Date(pago.fecha))} · ${escapeHtml(pago.usuario.username)}</span></span><span class="text-right text-xs text-slate-500">${pago.aplicaciones.map((aplicacion: { pedidoId: number; monto: number }) => `#${aplicacion.pedidoId}: ${formatearMoneda(aplicacion.monto)}`).join("<br>")}</span></li>`).join("")}</ul>` : `<p class="mt-2 rounded-lg bg-slate-50 p-3 text-sm text-slate-500">Aún no hay pagos registrados.</p>`}
      `;

      finanzas
        .querySelector<HTMLButtonElement>("#cliente-ver-deuda")
        ?.addEventListener("click", (event) => {
          abrirDetalleDeuda(event.currentTarget as HTMLButtonElement, cliente, deuda);
        });

      const formularioAbono = finanzas.querySelector<HTMLFormElement>(
        "#cliente-abono-form",
      );
      formularioAbono?.addEventListener("submit", async (event) => {
        event.preventDefault();
        const entrada = formularioAbono.querySelector<HTMLInputElement>(
          "#cliente-abono-monto",
        );
        const boton = formularioAbono.querySelector<HTMLButtonElement>(
          'button[type="submit"]',
        );
        const errorAbono = formularioAbono.querySelector(
          "#cliente-abono-error",
        );
        const monto = Number(entrada?.value);
        if (!entrada || !boton || !Number.isFinite(monto) || monto <= 0) {
          entrada?.setCustomValidity("Ingresa un monto mayor a 0.");
          entrada?.reportValidity();
          return;
        }
        if (monto > deuda.totalDeuda) {
          entrada.setCustomValidity(
            `El abono no puede superar ${formatearMoneda(deuda.totalDeuda)}.`,
          );
          entrada.reportValidity();
          return;
        }

        entrada.setCustomValidity("");
        establecerCargaBoton(boton, true, "Guardando...");
        errorAbono?.classList.add("hidden");

        try {
          const metodoPago =
            formularioAbono.querySelector<HTMLSelectElement>(
              "#cliente-abono-metodo",
            )?.value === "Transferencia"
              ? "Transferencia"
              : "Efectivo";
          await registrarAbonoCliente(cliente.id, monto, metodoPago);
          await cargar();
          avisar("Abono registrado correctamente.");
        } catch (caught) {
          if (errorAbono) {
            errorAbono.textContent =
              caught instanceof Error
                ? caught.message
                : "No se pudo registrar el abono.";
            errorAbono.classList.remove("hidden");
          }
          mostrarNotificacion(
            caught instanceof Error
              ? caught.message
              : "No se pudo registrar el abono.",
            "error",
          );
          establecerCargaBoton(boton, false, "Guardar abono");
        }
      });
      formularioAbono
        ?.querySelector<HTMLInputElement>("#cliente-abono-monto")
        ?.addEventListener("input", (event) => {
          (event.currentTarget as HTMLInputElement).setCustomValidity("");
        });
    } catch (caught) {
      if (idSolicitud !== solicitudDetalle) return;
      const finanzas = detalle.querySelector("#cliente-finanzas");
      if (finanzas)
        finanzas.innerHTML = `<p class="text-sm text-slate-500">No se pudo cargar el resumen de pagos: ${escapeHtml(caught instanceof Error ? caught.message : "error desconocido")}</p>`;
    }
  }

  function formatearMoneda(valor: number) {
    return new Intl.NumberFormat("es-EC", {
      style: "currency",
      currency: "USD",
    }).format(valor);
  }

  function escapeHtml(texto: string) {
    const span = document.createElement("span");
    span.textContent = texto;
    return span.innerHTML;
  }

  function abrirFormulario(cliente?: Cliente) {
    editandoId = cliente?.id ?? null;
    if (formTitulo)
      formTitulo.textContent = cliente ? "Editar cliente" : "Nuevo cliente";
    if (nombreInput) nombreInput.value = cliente?.nombre ?? "";
    if (telefonoInput) telefonoInput.value = cliente?.telefono ?? "";
    if (cedulaInput) cedulaInput.value = cliente?.cedula ?? "";
    if (direccionInput) direccionInput.value = cliente?.direccion ?? "";
    error?.classList.add("hidden");
    overlay?.classList.remove("hidden");
    overlay?.classList.add("flex");
    nombreInput?.focus();
  }

  function cerrarFormulario() {
    overlay?.classList.add("hidden");
    overlay?.classList.remove("flex");
  }

  async function cargar() {
    if (!lista || cargandoDatos) return;
    cargandoDatos = true;
    lista.innerHTML = `<p class="p-5 text-sm text-slate-500">Cargando clientes...</p>`;
    try {
      [clientes, resumenesDeuda] = await Promise.all([
        obtenerClientes(),
        obtenerDeudasClientes(),
      ]);
      datosCargados = true;
      renderLista();
      renderDetalle();
    } catch (caught) {
      lista.innerHTML = `<p class="p-5 text-sm text-red-700">${escapeHtml(caught instanceof Error ? caught.message : "No se pudieron cargar los clientes.")}</p>`;
    } finally {
      cargandoDatos = false;
      if (recargaPendiente) {
        recargaPendiente = false;
        void cargar();
      }
    }
  }

  async function borrarCliente() {
    const cliente = clientePendienteEliminar;
    if (!cliente || !botonEliminarConfirmar) return;
    establecerCargaBoton(botonEliminarConfirmar, true, "Eliminando...");
    try {
      await eliminarCliente(cliente.id);
      cerrarConfirmacionEliminar(false);
      clienteSeleccionado = null;
      await cargar();
      mostrarNotificacion(`Cliente ${cliente.nombre} eliminado.`);
    } catch (caught) {
      const mensaje =
        caught instanceof Error
          ? caught.message
          : "No se pudo eliminar el cliente.";
      mostrarNotificacion(mensaje, "error");
    } finally {
      establecerCargaBoton(botonEliminarConfirmar, false, "Sí, eliminar");
    }
  }

  botonEliminarConfirmar?.addEventListener("click", () => {
    void borrarCliente();
  });
  document
    .getElementById("cliente-eliminar-cancelar")
    ?.addEventListener("click", () => cerrarConfirmacionEliminar());
  document
    .getElementById("cliente-eliminar-backdrop")
    ?.addEventListener("click", () => cerrarConfirmacionEliminar());
  document
    .querySelectorAll("#cliente-deuda-cerrar, #cliente-deuda-cerrar-pie, #cliente-deuda-backdrop")
    .forEach((boton) => boton.addEventListener("click", cerrarDetalleDeuda));
  document
    .querySelectorAll(
      "#cliente-tarifas-cerrar, #cliente-tarifas-cerrar-pie, #cliente-tarifas-backdrop",
    )
    .forEach((boton) =>
      boton.addEventListener("click", cerrarModalTarifasCliente),
    );
  document
    .getElementById("cliente-tarifas-abrir")
    ?.addEventListener("click", () => void abrirModalTarifasCliente());
  document
    .getElementById("cliente-tarifas-toggle")
    ?.addEventListener("click", async () => {
      if (!clienteSeleccionado) return;
      const toggle = document.getElementById(
        "cliente-tarifas-toggle",
      ) as HTMLButtonElement | null;
      if (toggle) establecerCargaBoton(toggle, true, "Actualizando...");
      try {
        const cliente = await establecerTarifaEspecialCliente(
          clienteSeleccionado.id,
          !clienteSeleccionado.tarifaEspecial,
        );
        clienteSeleccionado = cliente;
        clientes = clientes.map((actual) =>
          actual.id === cliente.id ? cliente : actual,
        );
        renderLista();
        renderDetalle();
        await abrirModalTarifasCliente();
        mostrarNotificacion(
          cliente.tarifaEspecial
            ? "Tarifas exclusivas activadas. Completa los rangos necesarios."
            : "Se restablecieron las tarifas generales para este cliente.",
        );
      } catch (caught) {
        const mensaje =
          caught instanceof Error
            ? caught.message
            : "No se pudo cambiar el tipo de tarifa.";
        mostrarNotificacion(mensaje, "error");
      } finally {
        if (toggle) establecerCargaBoton(toggle, false);
      }
    });
  tarifaServicioInput?.addEventListener(
    "change",
    actualizarAnchosTarifaCliente,
  );
  document
    .getElementById("cliente-tarifa-cancelar-edicion")
    ?.addEventListener("click", restablecerFormularioTarifaCliente);
  tarifasClienteForm?.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (
      !clienteSeleccionado ||
      !tarifaServicioInput ||
      !tarifaAnchoInput ||
      !tarifaDesdeInput ||
      !tarifaHastaInput ||
      !tarifaPrecioInput
    ) {
      return;
    }
    const data: TarifaClienteData = {
      servicio: tarifaServicioInput.value as "TEXTIL" | "UV",
      ancho: Number(tarifaAnchoInput.value),
      desde: Number(tarifaDesdeInput.value),
      hasta: tarifaHastaInput.value
        ? Number(tarifaHastaInput.value)
        : null,
      precio: Number(tarifaPrecioInput.value),
    };
    const boton = document.getElementById(
      "cliente-tarifa-guardar",
    ) as HTMLButtonElement | null;
    if (boton) establecerCargaBoton(boton, true, "Guardando...");
    tarifaError?.classList.add("hidden");
    try {
      if (editandoTarifaClienteId === null) {
        await crearTarifaCliente(clienteSeleccionado.id, data);
        clienteSeleccionado = {
          ...clienteSeleccionado,
          tarifaEspecial: true,
        };
        clientes = clientes.map((cliente) =>
          cliente.id === clienteSeleccionado?.id
            ? clienteSeleccionado
            : cliente,
        );
        const toggle = document.getElementById("cliente-tarifas-toggle");
        if (toggle) {
          toggle.textContent = "Desactivar tarifas exclusivas";
          toggle.className =
            "h-9 rounded-lg bg-slate-700 px-4 text-sm font-semibold text-white hover:bg-slate-800";
        }
        void renderDetalle();
      } else {
        await actualizarTarifaCliente(
          clienteSeleccionado.id,
          editandoTarifaClienteId,
          data,
        );
      }
      restablecerFormularioTarifaCliente();
      await cargarTarifasClienteModal();
      mostrarNotificacion("Tarifa exclusiva guardada.");
    } catch (caught) {
      if (tarifaError) {
        tarifaError.textContent =
          caught instanceof Error
            ? caught.message
            : "No se pudo guardar la tarifa exclusiva.";
        tarifaError.classList.remove("hidden");
      }
    } finally {
      if (boton) establecerCargaBoton(boton, false, "Guardar tarifa");
    }
  });
  tarifasClienteLista?.addEventListener("click", async (event) => {
    const target = event.target;
    if (!(target instanceof Element) || !clienteSeleccionado) return;
    const editButton = target.closest<HTMLButtonElement>(
      "[data-tarifa-cliente-editar]",
    );
    if (editButton) {
      const tarifa = tarifasClienteActual.find(
        (item) => item.id === Number(editButton.dataset.tarifaClienteEditar),
      );
      if (!tarifa) return;
      editandoTarifaClienteId = tarifa.id;
      if (tarifaServicioInput) tarifaServicioInput.value = tarifa.servicio;
      actualizarAnchosTarifaCliente();
      if (tarifaAnchoInput) tarifaAnchoInput.value = String(tarifa.ancho);
      if (tarifaDesdeInput) tarifaDesdeInput.value = String(tarifa.desde);
      if (tarifaHastaInput) tarifaHastaInput.value = tarifa.hasta?.toString() ?? "";
      if (tarifaPrecioInput) tarifaPrecioInput.value = String(tarifa.precio);
      const titulo = document.getElementById("cliente-tarifa-form-titulo");
      const guardar = document.getElementById("cliente-tarifa-guardar");
      const cancelar = document.getElementById(
        "cliente-tarifa-cancelar-edicion",
      );
      if (titulo) titulo.textContent = "Editar rango de tarifa";
      if (guardar) guardar.textContent = "Guardar cambios";
      cancelar?.classList.remove("hidden");
      tarifaError?.classList.add("hidden");
      tarifaServicioInput?.focus();
      return;
    }

    const deleteButton = target.closest<HTMLButtonElement>(
      "[data-tarifa-cliente-eliminar]",
    );
    if (!deleteButton) return;
    const tarifaId = Number(deleteButton.dataset.tarifaClienteEliminar);
    if (!window.confirm("¿Eliminar este rango de tarifa exclusiva?")) return;
    try {
      await eliminarTarifaCliente(clienteSeleccionado.id, tarifaId);
      if (editandoTarifaClienteId === tarifaId) {
        restablecerFormularioTarifaCliente();
      }
      await cargarTarifasClienteModal();
      mostrarNotificacion("Tarifa exclusiva eliminada.");
    } catch (caught) {
      mostrarNotificacion(
        caught instanceof Error
          ? caught.message
          : "No se pudo eliminar la tarifa exclusiva.",
        "error",
      );
    }
  });
  window.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && !modalDeuda?.classList.contains("hidden")) {
      cerrarDetalleDeuda();
    }
    if (
      event.key === "Escape" &&
      !tarifasClienteModal?.classList.contains("hidden")
    ) {
      cerrarModalTarifasCliente();
    }
    if (
      event.key === "Escape" &&
      !modalEliminar?.classList.contains("hidden")
    ) {
      cerrarConfirmacionEliminar();
    }
  });

  document
    .getElementById("clientes-nuevo")
    ?.addEventListener("click", () => abrirFormulario());
  document
    .getElementById("cliente-form-cancelar")
    ?.addEventListener("click", cerrarFormulario);
  buscar?.addEventListener("input", renderLista);
  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (!nombreInput || !telefonoInput) return;
    const datos = {
      nombre: nombreInput.value.trim(),
      telefono: telefonoInput.value.trim(),
      cedula: cedulaInput?.value.trim() || null,
      direccion: direccionInput?.value.trim() || null,
    };
    const guardar = document.getElementById(
      "cliente-form-guardar",
    ) as HTMLButtonElement | null;
    if (guardar) establecerCargaBoton(guardar, true, "Guardando...");
    try {
      const guardado =
        editandoId === null
          ? await crearCliente(datos)
          : await actualizarCliente(editandoId, datos);
      await cargar();
      clienteSeleccionado =
        clientes.find((cliente) => cliente.id === guardado.id) ?? guardado;
      renderLista();
      renderDetalle();
      cerrarFormulario();
      avisar(editandoId === null ? "Cliente creado." : "Cliente actualizado.");
    } catch (caught) {
      mostrarNotificacion(
        caught instanceof Error
          ? caught.message
          : "No se pudo guardar el cliente.",
        "error",
      );
      if (error) {
        error.textContent =
          caught instanceof Error
            ? caught.message
            : "No se pudo guardar el cliente.";
        error.classList.remove("hidden");
      }
    } finally {
      if (guardar) establecerCargaBoton(guardar, false, "Guardar");
    }
  });

  window.addEventListener("centro-control:actualizar-datos", () => {
    if (cargandoDatos) {
      recargaPendiente = true;
    } else if (datosCargados) {
      void cargar();
    }
  });

  window.addEventListener("centro-control:vista-activada", (event) => {
    const vista = (event as CustomEvent<{ vista?: string }>).detail?.vista;
    if (vista === "clientes" && !datosCargados && !cargandoDatos)
      void cargar();
  });
</script>
