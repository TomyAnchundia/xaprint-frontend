---
interface Props {
  pedidoId?: number;
  cliente?: string;
  estado?: "ENTREGADO" | "CANCELADO";
  fecha?: string;
  hora?: string;
  servicio?: string;
  medidas?: string;
  precio?: number | null;
}

const {
  pedidoId = 0,
  cliente = "Cliente",
  estado = "ENTREGADO",
  fecha = "",
  hora = "",
  servicio = "",
  medidas = "",
  precio = null,
} = Astro.props;
---

<article class="rounded-xl border border-gray-200 bg-white p-4 shadow-sm">
  <div
    class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between"
  >
    <div class="min-w-0">
      <div class="flex flex-wrap items-center gap-2">
        <span class="text-sm font-semibold text-gray-900">
          Pedido #{pedidoId}
        </span>

        <span
          class:list={[
            "rounded-full px-2.5 py-1 text-xs font-medium",
            estado === "ENTREGADO"
              ? " text-green-800  "
              : "bg-red-100 text-red-800 ",
          ]}
        >
          {estado === "ENTREGADO" ? "Entregado" : "Cancelado"}
        </span>
      </div>

      <p class="mt-2 truncate text-sm font-medium text-gray-900">
        {cliente}
      </p>

      <div class="mt-1 flex flex-wrap gap-x-3 gap-y-1 text-sm text-gray-500">
        {servicio && <span>{servicio}</span>}
        {medidas && <span>{medidas}</span>}
      </div>
    </div>

    <div class="shrink-0 text-left sm:text-right">
      {
        precio !== null && (
          <p class="text-base font-semibold text-gray-900 ">
            ${precio.toFixed(2)}
          </p>
        )
      }

      <p class="mt-1 text-sm text-gray-500">
        {fecha}
        {hora && ` · ${hora}`}
      </p>
    </div>
  </div>
</article>
