---
import HistorialFiltros from "./HistorialFiltros.astro";
import HistorialLista from "./HistorialLista.astro";
---

<section id="historial-contenido" class="flex h-full min-h-0 flex-col">
  <!-- Encabezado -->
  <div
    class="flex shrink-0 flex-col gap-1 pb-5 sm:flex-row sm:items-end sm:justify-between"
  >
    <div>
      <h2 class="text-2xl font-bold tracking-tight text-slate-900">
        Historial
      </h2>

      <p class="mt-1 text-sm text-slate-500">Pedidos listos y cancelados.</p>
    </div>
  </div>

  <!-- Filtros -->
  <div class="shrink-0 pb-4">
    <HistorialFiltros />
  </div>

  <!-- Lista -->
  <div class="min-h-0 flex-1 overflow-hidden">
    <HistorialLista />
  </div>
</section>
