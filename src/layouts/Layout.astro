---
import "../styles/global.css";

interface Props {
  title?: string;
}

const { title = "Centro de Control" } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />

    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <meta
      name="description"
      content="Centro de Control para gestión y monitoreo de pedidos de impresión."
    />

    <title>{title}</title>
  </head>

  <body>
    <slot />

    <script>
      import "flowbite";
    </script>
  </body>
</html>
