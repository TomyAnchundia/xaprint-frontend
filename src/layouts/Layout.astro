---
import "../styles/global.css";

interface Props {
  title?: string;
}

const { title = "Centro de Control" } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />

    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <meta
      name="description"
      content="Centro de Control para gestión y monitoreo de pedidos de impresión."
    />
    <meta name="theme-color" content="#1200ff" />
    <link rel="icon" type="image/png" href="/xaprint-fondo.png" />
    <link rel="apple-touch-icon" href="/xaprint-fondo.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <script is:inline>
      try {
        const theme = localStorage.getItem("centro-control:theme");
        if (theme === "dark" || theme === "light") {
          document.documentElement.dataset.theme = theme;
        }
      } catch {
        // El tema claro permanece como valor predeterminado si storage no está disponible.
      }
    </script>

    <title>{title}</title>
  </head>

  <body>
    <slot />

    <div
      id="notificaciones-globales"
      class="pointer-events-none fixed left-1/2 top-4 z-200 w-[calc(100%-2rem)] max-w-sm -translate-x-1/2"
      aria-live="polite"
      aria-atomic="true"
    >
    </div>

    <script>
      import "flowbite";
      import { Dismiss } from "flowbite";

      const notificaciones = document.getElementById("notificaciones-globales");
      let dismissActual: Dismiss | null = null;
      let temporizadorNotificacion = 0;

      window.addEventListener("centro-control:notificacion", (evento) => {
        const detalle = (
          evento as CustomEvent<{
            mensaje?: string;
            tipo?: "success" | "error" | "info";
          }>
        ).detail;
        if (!notificaciones || !detalle?.mensaje) return;

        window.clearTimeout(temporizadorNotificacion);
        dismissActual?.destroyAndRemoveInstance();

        const esError = detalle.tipo === "error";
        const toast = document.createElement("div");
        toast.className = `toast-notificacion toast-${detalle.tipo ?? "success"} pointer-events-auto flex w-full items-center gap-3 rounded-lg border bg-white p-4 text-sm text-slate-700 shadow-lg transition-opacity`;
        toast.setAttribute("role", esError ? "alert" : "status");

        const icono = document.createElement("span");
        icono.className =
          "toast-icono flex h-9 w-9 shrink-0 items-center justify-center rounded-full font-bold";
        icono.textContent = esError ? "!" : detalle.tipo === "info" ? "i" : "✓";
        icono.setAttribute("aria-hidden", "true");

        const texto = document.createElement("p");
        texto.className = "min-w-0 flex-1 font-medium";
        texto.textContent = detalle.mensaje;

        const cerrar = document.createElement("button");
        cerrar.type = "button";
        cerrar.className =
          "toast-cerrar inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-lg text-slate-500 transition";
        cerrar.setAttribute("aria-label", "Cerrar notificación");
        cerrar.innerHTML =
          '<svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" d="m6 6 12 12M18 6 6 18"></path></svg>';
        toast.append(icono, texto, cerrar);
        notificaciones.replaceChildren(toast);

        dismissActual = new Dismiss(toast, cerrar, {
          duration: 250,
          onHide: () => window.setTimeout(() => toast.remove(), 260),
        });
        temporizadorNotificacion = window.setTimeout(
          () => dismissActual?.hide(),
          4500,
        );
      });
    </script>
  </body>
</html>
