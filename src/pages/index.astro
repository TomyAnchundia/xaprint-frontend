---
import Layout from "../layouts/Layout.astro";
import Sidebar from "../components/layout/Sidebar.astro";
import Header from "../components/layout/Header.astro";
import EstadisticasPedidos from "../components/dashboard/EstadisticasPedidos.astro";
import ListaPedidos from "../components/dashboard/ListaPedidos.astro";
import PedidoDetalle from "../components/dashboard/PedidoDetalle.astro";
import PedidoForm from "../components/dashboard/PedidoForm.astro";
import Historial from "../components/historial/Historial.astro";
import Clientes from "../components/admin/Clientes.astro";
import Usuarios from "../components/admin/Usuarios.astro";
import Tarifas from "../components/admin/Tarifas.astro";
import Estadisticas from "../components/admin/Estadisticas.astro";
---

<Layout title="Pedidos | Centro de Control">
  <div
    class="dashboard-shell flex min-h-dvh overflow-x-hidden bg-slate-50 lg:h-dvh lg:overflow-hidden"
  >
    <Sidebar />

    <div class="flex min-w-0 flex-1 flex-col lg:overflow-hidden">
      <Header />

      <main
        class="dashboard-main min-h-0 flex-1 overflow-y-auto lg:overflow-hidden"
      >
        <div
          class="flex min-h-full flex-col p-2 sm:p-3 lg:h-full lg:min-h-0 lg:p-4"
        >
          <div
            class="dashboard-views mx-auto flex min-h-full w-full max-w-[1600px] flex-col lg:h-full lg:min-h-0"
          >
            <!-- ============================================ -->
            <!-- VISTA: PEDIDOS                               -->
            <!-- ============================================ -->

            <section
              id="vista-pedidos"
              class="flex min-h-[calc(100dvh-4rem)] flex-col lg:h-full lg:min-h-0"
            >
              <!-- Encabezado -->
              <div
                class="flex shrink-0 flex-col gap-4 sm:flex-row sm:items-end sm:justify-between"
              >
                <div>
                  <h2 class="text-2xl font-bold tracking-tight text-slate-900">
                    Resumen de Impresiones
                  </h2>
                </div>
              </div>

              <!-- Estadísticas -->
              <div class="shrink-0 pb-3">
                <EstadisticasPedidos />
              </div>

              <!-- Lista -->
              <div class="min-h-0 flex-1 overflow-hidden">
                <ListaPedidos />
              </div>
            </section>

            <!-- ============================================ -->
            <!-- VISTA: HISTORIAL                             -->
            <!-- ============================================ -->

            <section
              id="vista-historial"
              class="hidden min-h-[calc(100dvh-4rem)] flex-col lg:h-full lg:min-h-0"
            >
              <Historial />
            </section>

            <section
              id="vista-clientes"
              class="hidden min-h-[calc(100dvh-4rem)] flex-col lg:h-full lg:min-h-0"
            >
              <Clientes />
            </section>

            <section
              id="vista-usuarios"
              class="hidden min-h-[calc(100dvh-4rem)] flex-col lg:h-full lg:min-h-0"
            >
              <Usuarios />
            </section>

            <section
              id="vista-tarifas"
              class="hidden min-h-[calc(100dvh-4rem)] flex-col lg:h-full lg:min-h-0"
            >
              <Tarifas />
            </section>

            <section
              id="vista-estadisticas"
              class="hidden min-h-[calc(100dvh-4rem)] flex-col lg:h-full lg:min-h-0"
            >
              <Estadisticas />
            </section>
          </div>
        </div>
      </main>
    </div>

    <!-- Modales / paneles globales -->
    <PedidoDetalle />
    <PedidoForm />
  </div>

  <script>
    import "../utils/responsive-tables";
    import {
      suscribirseConexion,
      iniciarPedidosStore,
    } from "../services/pedidos-store";

    import { obtenerToken, obtenerUsuario } from "../services/auth";
    import { puedeVerVista } from "../services/permisos";

    /*
     * Protección del dashboard
     *
     * Si no existe JWT, no permitimos
     * permanecer en esta página.
     */
    const usuario = obtenerUsuario();

    if (!obtenerToken() || !usuario) {
      window.location.replace("/login");
    } else {
      const estado = document.getElementById("estado-api");
      const punto = document.getElementById("estado-api-punto");
      const texto = document.getElementById("estado-api-texto");

      suscribirseConexion((conectado) => {
        if (!punto || !texto) return;

        if (conectado) {
          estado?.setAttribute("aria-label", "Sistema conectado");
          punto.className = "h-2 w-2 rounded-full bg-emerald-500";
          texto.className =
            "sr-only text-xs font-medium text-emerald-600 sm:not-sr-only";
          texto.textContent = "Sistema conectado";
        } else {
          estado?.setAttribute("aria-label", "Sin conexión");
          punto.className = "h-2 w-2 rounded-full bg-red-500";
          texto.className =
            "sr-only text-xs font-medium text-red-600 sm:not-sr-only";
          texto.textContent = "Sin conexión";
        }
      });

      iniciarPedidosStore().catch((error) => {
        console.error("No se pudo iniciar el sistema de pedidos:", error);
      });
    }

    /*
     * Navegación interna del dashboard
     *
     * El Sidebar no cambia de página.
     * Simplemente nos indica qué vista debe mostrarse.
     */
    const vistas: Record<
      string,
      { element: HTMLElement | null; titulo: string }
    > = {
      pedidos: {
        element: document.getElementById("vista-pedidos"),
        titulo: "Pedidos",
      },
      historial: {
        element: document.getElementById("vista-historial"),
        titulo: "Historial",
      },
      clientes: {
        element: document.getElementById("vista-clientes"),
        titulo: "Clientes",
      },
      usuarios: {
        element: document.getElementById("vista-usuarios"),
        titulo: "Usuarios",
      },
      tarifas: {
        element: document.getElementById("vista-tarifas"),
        titulo: "Tarifas",
      },
      estadisticas: {
        element: document.getElementById("vista-estadisticas"),
        titulo: "Estadísticas",
      },
    };

    window.addEventListener("centro-control:cambiar-vista", (event) => {
      const customEvent = event as CustomEvent<{
        vista: string;
      }>;

      const vista = customEvent.detail?.vista;

      const activa = vistas[vista];
      if (!activa || !puedeVerVista(vista, usuario)) return;

      Object.values(vistas).forEach(({ element }) => {
        element?.classList.add("hidden");
        element?.classList.remove("flex");
      });

      activa.element?.classList.remove("hidden");
      activa.element?.classList.add("flex");
      document.title = `${activa.titulo} | Centro de Control`;
      window.dispatchEvent(
        new CustomEvent("centro-control:vista-activada", {
          detail: { vista },
        }),
      );
    });
  </script>
</Layout>
